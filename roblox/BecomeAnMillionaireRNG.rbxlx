        <Item class="ModuleScript" referent="4">
          <Properties>
            <string name="Name">GameConfig</string>
            <string name="Source"><![CDATA[--!strict
-- Central tuning values. Everything here is safe for clients to read; secrets
-- (codes) live in ServerScriptService.

export type Reward = {
	cash: number?, -- flat cash
	scaledCash: number?, -- multiplied by the minCash of the player's best rarity (min 50)
	luckBoost: { mult: number, minutes: number }?,
}

export type Zone = {
	id: string,
	name: string,
	description: string,
	cost: number,
	requiredRebirths: number,
	luckBonus: number, -- additive, 0.25 = +25%
	cashMultiplier: number,
	center: Vector3, -- world position of the zone island (also used for anti-cheat zone checks)
	radius: number,
	color: Color3,
}

local GameConfig = {}

GameConfig.GameName = "Become An Millionaire RNG"
GameConfig.DataVersion = 1
GameConfig.DataStoreName = "PlayerData_v1"
GameConfig.LeaderboardStoreName = "RichestLifetime_v1"

GameConfig.Roll = {
	baseCooldown = 1.6, -- seconds
	minCooldown = 0.45,
	latencyTolerance = 0.12, -- server accepts rolls this much earlier than the cooldown
	historySize = 12,
	autoRollUnlockRolls = 750, -- free auto-roll after this many total rolls
}

GameConfig.Rebirth = {
	baseCost = 1_000_000,
	costGrowth = 20,
	cashBonusPer = 0.5, -- +50% cash per rebirth
	luckBonusPer = 0.1, -- +10% luck per rebirth
	maxRebirths = 50,
}

GameConfig.Offline = {
	minSeconds = 300,
	maxSeconds = 8 * 3600,
	-- cash per minute per level = this * minCash of best rarity discovered
	perMinuteFactor = 0.04,
}

GameConfig.Zones = {
	{
		id = "Downtown",
		name = "Downtown Plaza",
		description = "Where every fortune starts.",
		cost = 0,
		requiredRebirths = 0,
		luckBonus = 0,
		cashMultiplier = 1,
		center = Vector3.new(0, 0, 0),
		radius = 0,
		color = Color3.fromRGB(255, 210, 90),
	},
	{
		id = "LuxuryHills",
		name = "Luxury Hills",
		description = "+25% luck, x1.5 cash",
		cost = 75_000,
		requiredRebirths = 0,
		luckBonus = 0.25,
		cashMultiplier = 1.5,
		center = Vector3.new(700, 0, 0),
		radius = 90,
		color = Color3.fromRGB(120, 230, 160),
	},
	{
		id = "CasinoStrip",
		name = "Neon Strip",
		description = "+60% luck, x2.5 cash",
		cost = 5_000_000,
		requiredRebirths = 1,
		luckBonus = 0.6,
		cashMultiplier = 2.5,
		center = Vector3.new(1100, 0, 0),
		radius = 90,
		color = Color3.fromRGB(255, 80, 200),
	},
	{
		id = "FortuneVault",
		name = "Fortune Vault",
		description = "+150% luck, x5 cash",
		cost = 2e9,
		requiredRebirths = 3,
		luckBonus = 1.5,
		cashMultiplier = 5,
		center = Vector3.new(1500, 0, 0),
		radius = 90,
		color = Color3.fromRGB(255, 170, 30),
	},
	{
		id = "CelestialHeights",
		name = "Celestial Heights",
		description = "+300% luck, x12 cash",
		cost = 1e12,
		requiredRebirths = 6,
		luckBonus = 3,
		cashMultiplier = 12,
		center = Vector3.new(1900, 60, 0),
		radius = 90,
		color = Color3.fromRGB(150, 200, 255),
	},
} :: { Zone }

GameConfig.ZoneById = {} :: { [string]: Zone }
for _, zone in GameConfig.Zones do
	GameConfig.ZoneById[zone.id] = zone
end

-- 7-day streak, repeats after day 7.
GameConfig.DailyLogin = {
	{ scaledCash = 20 },
	{ scaledCash = 40 },
	{ luckBoost = { mult = 2, minutes = 10 } },
	{ scaledCash = 80 },
	{ scaledCash = 120 },
	{ luckBoost = { mult = 2, minutes = 30 } },
	{ scaledCash = 300, luckBoost = { mult = 3, minutes = 15 } },
} :: { Reward }

GameConfig.DailyLuckBoost = { mult = 2, minutes = 15 }

-- Counted per UTC day, so rejoining never restarts the timer.
GameConfig.PlaytimeRewards = {
	{ minutes = 5, reward = { scaledCash = 10 } :: Reward },
	{ minutes = 15, reward = { luckBoost = { mult = 1.5, minutes = 10 } } :: Reward },
	{ minutes = 30, reward = { scaledCash = 60 } :: Reward },
	{ minutes = 60, reward = { luckBoost = { mult = 2, minutes = 20 } } :: Reward },
	{ minutes = 120, reward = { scaledCash = 250 } :: Reward },
}

-- Auto-granted when total rolls reaches the threshold.
GameConfig.RollMilestones = {
	{ rolls = 100, reward = { cash = 2_500 } :: Reward },
	{ rolls = 500, reward = { scaledCash = 50, luckBoost = { mult = 1.5, minutes = 10 } } :: Reward },
	{ rolls = 1_000, reward = { scaledCash = 100 } :: Reward },
	{ rolls = 5_000, reward = { scaledCash = 300, luckBoost = { mult = 2, minutes = 20 } } :: Reward },
	{ rolls = 10_000, reward = { scaledCash = 600 } :: Reward },
	{ rolls = 50_000, reward = { scaledCash = 2_000, luckBoost = { mult = 3, minutes = 30 } } :: Reward },
	{ rolls = 100_000, reward = { scaledCash = 5_000 } :: Reward },
}

-- Limited-time events. Times are UTC unix seconds. `weekendLuck` runs every
-- Saturday and Sunday automatically.
GameConfig.Events = {
	{
		id = "LaunchWeek",
		name = "Launch Week: 2x Luck",
		luckMultiplier = 2,
		startsAt = 1798761600, -- 2027-01-01 00:00 UTC (edit to your launch date)
		endsAt = 1798761600 + 7 * 86400,
	},
}
GameConfig.WeekendEvent = { name = "Weekend Fortune: 1.5x Luck", luckMultiplier = 1.5 }

GameConfig.WealthTitles = {
	{ lifetime = 0, title = "Broke Beginner" },
	{ lifetime = 1_000, title = "Penny Pincher" },
	{ lifetime = 50_000, title = "Side Hustler" },
	{ lifetime = 1_000_000, title = "Millionaire" },
	{ lifetime = 100_000_000, title = "Tycoon" },
	{ lifetime = 1e10, title = "Billionaire Mogul" },
	{ lifetime = 1e13, title = "Trillionaire Titan" },
	{ lifetime = 1e16, title = "Celestial Heir" },
}

GameConfig.Trade = {
	maxKindsPerOffer = 8,
	requestCooldown = 5,
	inviteTimeout = 30,
}

GameConfig.Leaderboard = {
	globalRefreshSeconds = 120,
	globalSize = 50,
}

return GameConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="5">
          <Properties>
            <string name="Name">Monetization</string>
            <string name="Source"><![CDATA[--!strict
-- Game passes and developer products.
--
-- IMPORTANT: ids are 0 until you create the passes/products on the Creator
-- Dashboard and paste the real ids here. Items with id 0 are shown in the shop
-- as "Not available yet" and cannot be bought — nothing is ever faked.

export type Pass = {
	key: string,
	id: number,
	name: string,
	description: string,
	priceHint: number, -- shown in the UI only; Roblox shows the real price at checkout
}

export type Product = {
	key: string,
	id: number,
	name: string,
	description: string,
	priceHint: number,
	-- What is granted; handled in MonetizationService.
	grant: {
		luckBoost: { mult: number, minutes: number }?,
		scaledCash: number?,
		serverLuck: { mult: number, minutes: number }?,
	},
}

local Passes: { Pass } = {
	{ key = "VIP", id = 0, name = "VIP", description = "+25% cash, +10% luck, VIP chat tag, exclusive VIP aura", priceHint = 299 },
	{ key = "DoubleLuck", id = 0, name = "2x Luck", description = "Permanently doubles your luck", priceHint = 499 },
	{ key = "FastRoll", id = 0, name = "Fast Roll", description = "Roll cooldown is 30% shorter", priceHint = 249 },
	{ key = "AutoRoll", id = 0, name = "Instant Auto-Roll", description = "Unlock auto-roll right away (free after 750 rolls)", priceHint = 99 },
}

local Products: { Product } = {
	{ key = "Luck15", id = 0, name = "2x Luck (15 min)", description = "Personal 2x luck boost", priceHint = 49, grant = { luckBoost = { mult = 2, minutes = 15 } } },
	{ key = "Luck60", id = 0, name = "3x Luck (60 min)", description = "Personal 3x luck boost", priceHint = 149, grant = { luckBoost = { mult = 3, minutes = 60 } } },
	{ key = "CashPack", id = 0, name = "Cash Briefcase", description = "Cash scaled to your best rarity", priceHint = 99, grant = { scaledCash = 400 } },
	{ key = "ServerLuck", id = 0, name = "Server 2x Luck (10 min)", description = "Everyone in the server gets 2x luck", priceHint = 199, grant = { serverLuck = { mult = 2, minutes = 10 } } },
}

local passByKey: { [string]: Pass } = {}
local passById: { [number]: Pass } = {}
for _, pass in Passes do
	passByKey[pass.key] = pass
	if pass.id ~= 0 then
		passById[pass.id] = pass
	end
end
local productByKey: { [string]: Product } = {}
local productById: { [number]: Product } = {}
for _, product in Products do
	productByKey[product.key] = product
	if product.id ~= 0 then
		productById[product.id] = product
	end
end

return {
	Passes = Passes,
	Products = Products,
	PassByKey = passByKey,
	PassById = passById,
	ProductByKey = productByKey,
	ProductById = productById,
	VIP = { cashBonus = 0.25, luckBonus = 0.1 },
	FastRollMultiplier = 0.7,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="6">
          <Properties>
            <string name="Name">Quests</string>
            <string name="Source"><![CDATA[--!strict
-- Quest and achievement definitions.
--
-- Quest kinds (progress events raised by the server):
--   "rolls"      - any roll, +1 per individual roll
--   "earn"       - cash earned from rolls; target is multiplied by the
--                  minCash of the player's best rarity when the quest is issued
--   "rarityAtLeast" - roll a rarity with order >= `minOrder`
--   "upgrades"   - buy upgrade levels
--   "playMinutes" - minutes played

local GameConfig = require(script.Parent.GameConfig)

type Reward = GameConfig.Reward

export type QuestKind = "rolls" | "earn" | "rarityAtLeast" | "upgrades" | "playMinutes"

export type QuestTemplate = {
	id: string,
	kind: QuestKind,
	text: string, -- {target} is replaced with the (formatted) target
	target: number,
	minOrder: number?,
	reward: Reward,
}

export type Achievement = {
	id: string,
	name: string,
	description: string,
	stat: "totalRolls" | "lifetime" | "rebirths" | "discovered" | "bestOrder" | "upgradesBought" | "trades" | "streak",
	target: number,
	reward: Reward,
	badgeId: number, -- 0 = no Roblox badge; set real badge ids after creating them
}

local DailyPool: { QuestTemplate } = {
	{ id = "d_roll150", kind = "rolls", text = "Roll {target} times", target = 150, reward = { scaledCash = 30 } },
	{ id = "d_roll400", kind = "rolls", text = "Roll {target} times", target = 400, reward = { scaledCash = 80 } },
	{ id = "d_earn", kind = "earn", text = "Earn {target} cash from rolls", target = 40, reward = { scaledCash = 40 } },
	{ id = "d_rich", kind = "rarityAtLeast", text = "Roll Rich or better {target} times", target = 3, minOrder = 5, reward = { luckBoost = { mult = 2, minutes = 10 } } },
	{ id = "d_comfy", kind = "rarityAtLeast", text = "Roll Comfortable or better {target} times", target = 10, minOrder = 4, reward = { scaledCash = 50 } },
	{ id = "d_upg", kind = "upgrades", text = "Buy {target} upgrade levels", target = 3, reward = { scaledCash = 40 } },
	{ id = "d_play", kind = "playMinutes", text = "Play for {target} minutes", target = 20, reward = { luckBoost = { mult = 1.5, minutes = 15 } } },
}

-- Repeatable quests restart with a bigger target each time they are claimed.
export type RepeatableQuest = {
	id: string,
	kind: QuestKind,
	text: string,
	target: number,
	minOrder: number?,
	reward: Reward,
	growth: number,
}

local Repeatable: { RepeatableQuest } = {
	{ id = "r_roll", kind = "rolls", text = "Roll {target} times", target = 50, growth = 1.35, reward = { scaledCash = 15 } },
	{ id = "r_comfy", kind = "rarityAtLeast", text = "Roll Comfortable or better {target} times", target = 5, minOrder = 4, growth = 1.25, reward = { scaledCash = 25 } },
	{ id = "r_earn", kind = "earn", text = "Earn {target} cash from rolls", target = 25, growth = 1.3, reward = { luckBoost = { mult = 1.5, minutes = 5 } } },
}

local Achievements: { Achievement } = {
	{ id = "a_first", name = "First Spin", description = "Roll once", stat = "totalRolls", target = 1, reward = { cash = 100 }, badgeId = 0 },
	{ id = "a_roll1k", name = "Dedicated Roller", description = "Roll 1,000 times", stat = "totalRolls", target = 1_000, reward = { scaledCash = 100 }, badgeId = 0 },
	{ id = "a_roll25k", name = "RNG Addict", description = "Roll 25,000 times", stat = "totalRolls", target = 25_000, reward = { scaledCash = 1_000 }, badgeId = 0 },
	{ id = "a_mil", name = "Officially a Millionaire", description = "Earn 1M lifetime cash", stat = "lifetime", target = 1e6, reward = { luckBoost = { mult = 2, minutes = 15 } }, badgeId = 0 },
	{ id = "a_bil", name = "Billionaire Club", description = "Earn 1B lifetime cash", stat = "lifetime", target = 1e9, reward = { scaledCash = 500 }, badgeId = 0 },
	{ id = "a_tril", name = "Trillionaire Club", description = "Earn 1T lifetime cash", stat = "lifetime", target = 1e12, reward = { scaledCash = 500 }, badgeId = 0 },
	{ id = "a_rb1", name = "Fresh Start", description = "Rebirth once", stat = "rebirths", target = 1, reward = { luckBoost = { mult = 2, minutes = 20 } }, badgeId = 0 },
	{ id = "a_rb5", name = "Serial Reborn", description = "Rebirth 5 times", stat = "rebirths", target = 5, reward = { scaledCash = 1_000 }, badgeId = 0 },
	{ id = "a_rb10", name = "Eternal Fortune", description = "Rebirth 10 times", stat = "rebirths", target = 10, reward = { scaledCash = 5_000 }, badgeId = 0 },
	{ id = "a_col5", name = "Collector", description = "Discover 5 rarities", stat = "discovered", target = 5, reward = { scaledCash = 50 }, badgeId = 0 },
	{ id = "a_col8", name = "Curator", description = "Discover 8 rarities", stat = "discovered", target = 8, reward = { scaledCash = 300 }, badgeId = 0 },
	{ id = "a_colall", name = "Complete Collection", description = "Discover every rarity", stat = "discovered", target = -1, reward = { scaledCash = 10_000, luckBoost = { mult = 5, minutes = 60 } }, badgeId = 0 },
	{ id = "a_bil_roll", name = "Lucky Billion", description = "Roll Billionaire or rarer", stat = "bestOrder", target = 8, reward = { luckBoost = { mult = 3, minutes = 30 } }, badgeId = 0 },
	{ id = "a_upg25", name = "Investor", description = "Buy 25 upgrade levels", stat = "upgradesBought", target = 25, reward = { scaledCash = 80 }, badgeId = 0 },
	{ id = "a_trade", name = "Deal Maker", description = "Complete a trade", stat = "trades", target = 1, reward = { scaledCash = 40 }, badgeId = 0 },
	{ id = "a_streak7", name = "Loyal Investor", description = "Reach a 7-day login streak", stat = "streak", target = 7, reward = { luckBoost = { mult = 3, minutes = 30 } }, badgeId = 0 },
}

local templatesById: { [string]: QuestTemplate } = {}
for _, quest in DailyPool do
	templatesById[quest.id] = quest
end
local repeatableById: { [string]: RepeatableQuest } = {}
for _, quest in Repeatable do
	repeatableById[quest.id] = quest
end
local achievementsById: { [string]: Achievement } = {}
for _, achievement in Achievements do
	achievementsById[achievement.id] = achievement
end

return {
	DailyPool = DailyPool,
	DailyCount = 3,
	DailyById = templatesById,
	Repeatable = Repeatable,
	RepeatableById = repeatableById,
	Achievements = Achievements,
	AchievementById = achievementsById,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="7">
          <Properties>
            <string name="Name">Rarities</string>
            <string name="Source"><![CDATA[--!strict
-- Every rollable rarity, ordered from most common to rarest.
--
-- To add a rarity: append (or insert) an entry, keep `order` equal to its
-- position in the list, and give it a `chance` larger than the one before it.
-- RNG, rewards, auras, the index, quests and the UI all read from this list.

export type Effect = "none" | "sparkle" | "burst" | "flash" | "cinematic" | "celestial"

export type Rarity = {
	id: string,
	name: string,
	order: number,
	chance: number, -- "1 in chance" at 1x luck, before normalisation
	minCash: number,
	maxCash: number,
	color: Color3,
	accent: Color3,
	effect: Effect,
	announce: boolean, -- server-wide announcement when rolled
	hasAura: boolean, -- grants a collectible, equippable aura
	revealTime: number, -- seconds the client spends on the build-up
}

local Rarities: { Rarity } = {
	{
		id = "Broke",
		name = "Broke",
		order = 1,
		chance = 2,
		minCash = 1,
		maxCash = 5,
		color = Color3.fromRGB(150, 150, 150),
		accent = Color3.fromRGB(90, 90, 90),
		effect = "none",
		announce = false,
		hasAura = false,
		revealTime = 0.6,
	},
	{
		id = "Poor",
		name = "Poor",
		order = 2,
		chance = 4,
		minCash = 10,
		maxCash = 40,
		color = Color3.fromRGB(181, 140, 99),
		accent = Color3.fromRGB(110, 80, 50),
		effect = "none",
		announce = false,
		hasAura = false,
		revealTime = 0.6,
	},
	{
		id = "WorkingClass",
		name = "Working Class",
		order = 3,
		chance = 10,
		minCash = 75,
		maxCash = 250,
		color = Color3.fromRGB(96, 178, 255),
		accent = Color3.fromRGB(40, 100, 180),
		effect = "sparkle",
		announce = false,
		hasAura = false,
		revealTime = 0.7,
	},
	{
		id = "Comfortable",
		name = "Comfortable",
		order = 4,
		chance = 35,
		minCash = 500,
		maxCash = 1_500,
		color = Color3.fromRGB(90, 220, 140),
		accent = Color3.fromRGB(30, 140, 80),
		effect = "sparkle",
		announce = false,
		hasAura = true,
		revealTime = 0.8,
	},
	{
		id = "Rich",
		name = "Rich",
		order = 5,
		chance = 150,
		minCash = 5_000,
		maxCash = 20_000,
		color = Color3.fromRGB(255, 215, 90),
		accent = Color3.fromRGB(200, 150, 20),
		effect = "burst",
		announce = false,
		hasAura = true,
		revealTime = 1.0,
	},
	{
		id = "Millionaire",
		name = "Millionaire",
		order = 6,
		chance = 1_000,
		minCash = 1_000_000,
		maxCash = 3_000_000,
		color = Color3.fromRGB(255, 190, 40),
		accent = Color3.fromRGB(255, 240, 160),
		effect = "burst",
		announce = false,
		hasAura = true,
		revealTime = 1.3,
	},
	{
		id = "MultiMillionaire",
		name = "Multi-Millionaire",
		order = 7,
		chance = 7_500,
		minCash = 5_000_000,
		maxCash = 25_000_000,
		color = Color3.fromRGB(255, 120, 60),
		accent = Color3.fromRGB(255, 220, 120),
		effect = "flash",
		announce = true,
		hasAura = true,
		revealTime = 1.6,
	},
	{
		id = "Billionaire",
		name = "Billionaire",
		order = 8,
		chance = 50_000,
		minCash = 1e9,
		maxCash = 5e9,
		color = Color3.fromRGB(190, 90, 255),
		accent = Color3.fromRGB(255, 200, 255),
		effect = "flash",
		announce = true,
		hasAura = true,
		revealTime = 2.0,
	},
	{
		id = "Trillionaire",
		name = "Trillionaire",
		order = 9,
		chance = 400_000,
		minCash = 1e12,
		maxCash = 5e12,
		color = Color3.fromRGB(255, 60, 120),
		accent = Color3.fromRGB(255, 210, 90),
		effect = "cinematic",
		announce = true,
		hasAura = true,
		revealTime = 2.6,
	},
	{
		id = "SecretWealth",
		name = "Secret Wealth",
		order = 10,
		chance = 3_000_000,
		minCash = 5e13,
		maxCash = 2e14,
		color = Color3.fromRGB(40, 255, 220),
		accent = Color3.fromRGB(10, 10, 10),
		effect = "cinematic",
		announce = true,
		hasAura = true,
		revealTime = 3.2,
	},
	{
		id = "CelestialFortune",
		name = "Celestial Fortune",
		order = 11,
		chance = 25_000_000,
		minCash = 1e15,
		maxCash = 5e15,
		color = Color3.fromRGB(255, 255, 255),
		accent = Color3.fromRGB(140, 200, 255),
		effect = "celestial",
		announce = true,
		hasAura = true,
		revealTime = 4.0,
	},
}

local byId: { [string]: Rarity } = {}
for index, rarity in Rarities do
	assert(rarity.order == index, `Rarity {rarity.id} has order {rarity.order}, expected {index}`)
	assert(byId[rarity.id] == nil, `Duplicate rarity id {rarity.id}`)
	if index > 1 then
		assert(rarity.chance > Rarities[index - 1].chance, `Rarity {rarity.id} must be rarer than the one before it`)
	end
	byId[rarity.id] = rarity
end

return {
	list = Rarities,
	byId = byId,
	get = function(id: string): Rarity?
		return byId[id]
	end,
	count = #Rarities,
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="8">
          <Properties>
            <string name="Name">Sounds</string>
            <string name="Source"><![CDATA[--!strict
-- Sound ids. The defaults use sounds bundled with every Roblox client
-- (rbxasset://), so they work without uploading anything. For a more
-- polished feel, replace them with "rbxassetid://<id>" sounds from the
-- Creator Store (Toolbox -> Audio). Per-rarity reveal sounds are pitched
-- differently so each tier is audibly distinct.

return {
	Click = "rbxasset://sounds/clickfast.wav",
	Tick = "rbxasset://sounds/clickfast.wav",
	Reveal = "rbxasset://sounds/electronicpingshort.wav",
	Rare = "rbxasset://sounds/electronicpingshort.wav",
	Notify = "rbxasset://sounds/electronicpingshort.wav",
	-- Optional per-rarity overrides: [rarityId] = "rbxassetid://..."
	ByRarity = {} :: { [string]: string },
}
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="9">
          <Properties>
            <string name="Name">Upgrades</string>
            <string name="Source"><![CDATA[--!strict
-- Permanent upgrades bought with cash. Cost of level n -> n+1 is
-- floor(baseCost * growth ^ n). `perLevel` meaning depends on the upgrade.

export type Upgrade = {
	id: string,
	name: string,
	description: string,
	baseCost: number,
	growth: number,
	maxLevel: number,
	perLevel: number,
	keepOnRebirth: boolean,
	order: number,
}

local Upgrades: { Upgrade } = {
	{
		id = "Luck",
		name = "Lucky Charm",
		description = "+10% luck per level",
		baseCost = 150,
		growth = 1.55,
		maxLevel = 50,
		perLevel = 0.10,
		keepOnRebirth = false,
		order = 1,
	},
	{
		id = "Cash",
		name = "Golden Wallet",
		description = "+15% cash from rolls per level",
		baseCost = 100,
		growth = 1.5,
		maxLevel = 50,
		perLevel = 0.15,
		keepOnRebirth = false,
		order = 2,
	},
	{
		id = "Speed",
		name = "Quick Hands",
		description = "-6% roll cooldown per level",
		baseCost = 400,
		growth = 2.1,
		maxLevel = 10,
		perLevel = 0.06,
		keepOnRebirth = false,
		order = 3,
	},
	{
		id = "Capacity",
		name = "Multi-Roll",
		description = "+1 roll per click (best result is revealed)",
		baseCost = 25_000,
		growth = 12,
		maxLevel = 4,
		perLevel = 1,
		keepOnRebirth = false,
		order = 4,
	},
	{
		id = "Offline",
		name = "Passive Income",
		description = "Earn cash while offline (up to 8h)",
		baseCost = 5_000,
		growth = 3,
		maxLevel = 10,
		perLevel = 1,
		keepOnRebirth = true,
		order = 5,
	},
}

local byId: { [string]: Upgrade } = {}
for _, upgrade in Upgrades do
	byId[upgrade.id] = upgrade
end

return {
	list = Upgrades,
	byId = byId,
}
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="10">
        <Properties>
          <string name="Name">Modules</string>
        </Properties>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">Formulas</string>
            <string name="Source"><![CDATA[--!strict
-- Pure gameplay formulas shared by server (authoritative) and client (display).
-- No Roblox services are used here so the maths can be unit tested.

local Config = script.Parent.Parent.Config
local GameConfig = require(Config.GameConfig)
local Upgrades = require(Config.Upgrades)
local Rarities = require(Config.Rarities)
local Monetization = require(Config.Monetization)

export type Boost = { mult: number, expires: number }

export type StatContext = {
	passes: { [string]: boolean },
	zoneId: string,
	now: number,
	serverLuck: number,
}

export type Stats = {
	luck: number,
	cashMultiplier: number,
	cooldown: number,
	rollsPerClick: number,
	autoRollUnlocked: boolean,
	boostLuck: number,
	eventLuck: number,
	eventName: string?,
	zoneId: string,
}

local Formulas = {}

function Formulas.dayNumber(now: number): number
	return math.floor(now / 86400)
end

-- 0 = Sunday ... 6 = Saturday (1970-01-01 was a Thursday).
function Formulas.weekday(now: number): number
	return (Formulas.dayNumber(now) + 4) % 7
end

function Formulas.upgradeCost(upgradeId: string, level: number): number
	local upgrade = Upgrades.byId[upgradeId]
	assert(upgrade, `Unknown upgrade {upgradeId}`)
	return math.floor(upgrade.baseCost * upgrade.growth ^ level)
end

function Formulas.upgradeLevel(profile: any, upgradeId: string): number
	return (profile.upgrades and profile.upgrades[upgradeId]) or 0
end

function Formulas.rebirthCost(rebirths: number): number
	return math.floor(GameConfig.Rebirth.baseCost * GameConfig.Rebirth.costGrowth ^ rebirths)
end

-- Sum of (mult - 1) over active boosts, so two 2x boosts make 3x, not 4x.
function Formulas.boostLuck(boosts: { [string]: Boost }?, now: number): number
	local total = 1
	if boosts then
		for _, boost in boosts do
			if boost.expires > now then
				total += boost.mult - 1
			end
		end
	end
	return total
end

function Formulas.activeEvent(now: number): (number, string?)
	local best, name = 1, nil
	for _, event in GameConfig.Events do
		if now >= event.startsAt and now < event.endsAt and event.luckMultiplier > best then
			best, name = event.luckMultiplier, event.name
		end
	end
	local weekday = Formulas.weekday(now)
	if (weekday == 0 or weekday == 6) and GameConfig.WeekendEvent.luckMultiplier > best then
		best, name = GameConfig.WeekendEvent.luckMultiplier, GameConfig.WeekendEvent.name
	end
	return best, name
end

function Formulas.computeStats(profile: any, context: StatContext): Stats
	local passes = context.passes
	local zone = GameConfig.ZoneById[context.zoneId] or GameConfig.ZoneById.Downtown
	local rebirths = profile.rebirths or 0

	local additiveLuck = 1
		+ Formulas.upgradeLevel(profile, "Luck") * Upgrades.byId.Luck.perLevel
		+ rebirths * GameConfig.Rebirth.luckBonusPer
		+ zone.luckBonus
		+ (if passes.VIP then Monetization.VIP.luckBonus else 0)
	local boostLuck = Formulas.boostLuck(profile.boosts, context.now)
	local eventLuck, eventName = Formulas.activeEvent(context.now)
	local luck = additiveLuck
		* (if passes.DoubleLuck then 2 else 1)
		* boostLuck
		* eventLuck
		* math.max(context.serverLuck, 1)

	local cashMultiplier = (
		1
		+ Formulas.upgradeLevel(profile, "Cash") * Upgrades.byId.Cash.perLevel
		+ rebirths * GameConfig.Rebirth.cashBonusPer
		+ (if passes.VIP then Monetization.VIP.cashBonus else 0)
	) * zone.cashMultiplier

	local cooldown = GameConfig.Roll.baseCooldown
		* (1 - Formulas.upgradeLevel(profile, "Speed") * Upgrades.byId.Speed.perLevel)
		* (if passes.FastRoll then Monetization.FastRollMultiplier else 1)
	cooldown = math.max(cooldown, GameConfig.Roll.minCooldown)

	return {
		luck = luck,
		cashMultiplier = cashMultiplier,
		cooldown = cooldown,
		rollsPerClick = 1 + Formulas.upgradeLevel(profile, "Capacity") * Upgrades.byId.Capacity.perLevel,
		autoRollUnlocked = passes.AutoRoll == true or (profile.totalRolls or 0) >= GameConfig.Roll.autoRollUnlockRolls,
		boostLuck = boostLuck,
		eventLuck = eventLuck,
		eventName = eventName,
		zoneId = zone.id,
	}
end

function Formulas.bestMinCash(bestOrder: number): number
	local rarity = Rarities.list[math.clamp(bestOrder, 1, Rarities.count)]
	return math.max(50, rarity.minCash)
end

-- Turns a reward's scaled cash into a flat amount for this player.
function Formulas.rewardCash(reward: GameConfig.Reward, bestOrder: number): number
	local cash = reward.cash or 0
	if reward.scaledCash then
		cash += reward.scaledCash * Formulas.bestMinCash(bestOrder)
	end
	return math.floor(cash)
end

function Formulas.offlineCash(level: number, bestOrder: number, seconds: number): number
	if level <= 0 or seconds < GameConfig.Offline.minSeconds then
		return 0
	end
	local minutes = math.min(seconds, GameConfig.Offline.maxSeconds) / 60
	return math.floor(minutes * level * GameConfig.Offline.perMinuteFactor * Formulas.bestMinCash(bestOrder))
end

function Formulas.wealthTitle(lifetime: number): string
	local title = GameConfig.WealthTitles[1].title
	for _, entry in GameConfig.WealthTitles do
		if lifetime >= entry.lifetime then
			title = entry.title
		end
	end
	return title
end

function Formulas.repeatableTarget(baseTarget: number, growth: number, stage: number): number
	return math.max(1, math.floor(baseTarget * growth ^ stage))
end

-- OrderedDataStores only accept integers below 2^63, while cash can exceed
-- 1e15. Store log10 with 6 decimal places of precision instead.
function Formulas.encodeLeaderboardValue(value: number): number
	if value < 1 then
		return 0
	end
	return math.floor(math.log10(value) * 1e6) + 1
end

function Formulas.decodeLeaderboardValue(encoded: number): number
	if encoded <= 0 then
		return 0
	end
	return 10 ^ ((encoded - 1) / 1e6)
end

return Formulas
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">NumberFormat</string>
            <string name="Source"><![CDATA[--!strict
-- Compact number formatting: 1234 -> "1.23K", 5e15 -> "5Qa".

local SUFFIXES = { "", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc" }

local NumberFormat = {}

function NumberFormat.short(value: number): string
	if value ~= value then
		return "0"
	end
	local negative = value < 0
	value = math.abs(value)
	if value < 1000 then
		local text = tostring(math.floor(value))
		return if negative then "-" .. text else text
	end
	local tier = math.min(math.floor(math.log10(value) / 3), #SUFFIXES - 1)
	local scaled = value / 10 ^ (tier * 3)
	local text
	if scaled >= 100 then
		text = string.format("%d", math.floor(scaled))
	elseif scaled >= 10 then
		text = string.format("%.1f", math.floor(scaled * 10) / 10)
	else
		text = string.format("%.2f", math.floor(scaled * 100) / 100)
	end
	if text:find(".", 1, true) then
		text = text:gsub("0+$", "")
		text = text:gsub("%.$", "")
	end
	return (if negative then "-" else "") .. text .. SUFFIXES[tier + 1]
end

function NumberFormat.commas(value: number): string
	local text = tostring(math.floor(value))
	local formatted = text:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	return (formatted:gsub("^,", ""):gsub("^%-,", "-"))
end

function NumberFormat.odds(probability: number): string
	if probability <= 0 then
		return "-"
	end
	local oneIn = 1 / probability
	if oneIn < 10 then
		return string.format("1 in %.1f", oneIn)
	end
	return "1 in " .. NumberFormat.short(math.floor(oneIn + 0.5))
end

function NumberFormat.duration(seconds: number): string
	seconds = math.max(0, math.floor(seconds))
	local hours = seconds // 3600
	local minutes = (seconds % 3600) // 60
	local secs = seconds % 60
	if hours > 0 then
		return string.format("%dh %02dm", hours, minutes)
	elseif minutes > 0 then
		return string.format("%dm %02ds", minutes, secs)
	end
	return string.format("%ds", secs)
end

return NumberFormat
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">RNG</string>
            <string name="Source"><![CDATA[--!strict
-- Pure rarity maths. Used authoritatively by the server and for display
-- (odds lists) by the client. Contains no Roblox API calls so it can be unit
-- tested outside Studio.
--
-- Luck model: the most common rarity keeps its base weight, every other
-- rarity's weight (1 / chance) is multiplied by `luck`. Weights are then
-- normalised, so at 2x luck every non-common rarity is (almost exactly) twice
-- as likely and the relative odds between rare tiers never change.

local Rarities = require(script.Parent.Parent.Config.Rarities)

type Rarity = Rarities.Rarity

local RNG = {}

function RNG.getWeights(luck: number, list: { Rarity }?): { number }
	local rarities = list or Rarities.list
	luck = math.max(luck, 1)
	local weights = table.create(#rarities)
	for index, rarity in rarities do
		local weight = 1 / rarity.chance
		if index > 1 then
			weight *= luck
		end
		weights[index] = weight
	end
	return weights
end

-- Returns the probability (0-1) of each rarity, in list order.
function RNG.getProbabilities(luck: number, list: { Rarity }?): { number }
	local weights = RNG.getWeights(luck, list)
	local total = 0
	for _, weight in weights do
		total += weight
	end
	local probabilities = table.create(#weights)
	for index, weight in weights do
		probabilities[index] = weight / total
	end
	return probabilities
end

-- `random` must return a uniform number in [0, 1).
function RNG.pick(luck: number, random: () -> number, list: { Rarity }?): Rarity
	local rarities = list or Rarities.list
	local weights = RNG.getWeights(luck, rarities)
	local total = 0
	for _, weight in weights do
		total += weight
	end
	local roll = random() * total
	-- Walk from rarest to most common so floating-point slack lands on the
	-- common tier rather than inflating a rare one.
	for index = #rarities, 1, -1 do
		roll -= weights[index]
		if roll < 0 then
			return rarities[index]
		end
	end
	return rarities[1]
end

-- Log-uniform cash within the rarity's range, so big ranges still feel varied.
function RNG.rollCash(rarity: Rarity, random: () -> number): number
	local low, high = math.log(rarity.minCash), math.log(rarity.maxCash)
	local value = math.exp(low + (high - low) * random())
	return math.clamp(math.floor(value), rarity.minCash, rarity.maxCash)
end

return RNG
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">Remotes</string>
            <string name="Source"><![CDATA[--!strict
-- Single place that defines every remote. The server creates them on start,
-- clients wait for them.
--
-- Client -> server:
--   Request (RemoteFunction): Request(action: string, payload: any) -> { ok, message?, data? }
-- Server -> client (RemoteEvents):
--   State        full player snapshot after any change
--   RollResult   result of a roll (manual or auto)
--   Notify       toast { text, kind }
--   Announce     server-wide rare roll / boost announcement
--   Trade        trade session updates
--   Leaderboard  global + server leaderboard data

local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local EVENTS = { "State", "RollResult", "Notify", "Announce", "Trade", "Leaderboard" }
local FUNCTIONS = { "Request" }

local Remotes = {}

local folder: Folder
if RunService:IsServer() then
	local existing = ReplicatedStorage:FindFirstChild("Remotes")
	if existing then
		existing:Destroy()
	end
	folder = Instance.new("Folder")
	folder.Name = "Remotes"
	for _, name in EVENTS do
		local remote = Instance.new("RemoteEvent")
		remote.Name = name
		remote.Parent = folder
	end
	for _, name in FUNCTIONS do
		local remote = Instance.new("RemoteFunction")
		remote.Name = name
		remote.Parent = folder
	end
	folder.Parent = ReplicatedStorage
else
	folder = ReplicatedStorage:WaitForChild("Remotes") :: Folder
end

function Remotes.event(name: string): RemoteEvent
	return folder:WaitForChild(name) :: RemoteEvent
end

function Remotes.func(name: string): RemoteFunction
	return folder:WaitForChild(name) :: RemoteFunction
end

return Remotes
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="15">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="16">
      <Properties>
        <string name="Name">Server</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[-- Server bootstrap for Become An Millionaire RNG.
-- Creates remotes, registers every service, then initialises them in order.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Modules.Remotes) -- creates the Remotes folder

local Registry = require(script.Registry)
local Services = script.Services

Registry.RequestService = require(Services.RequestService)
Registry.DataService = require(Services.DataService)
Registry.MonetizationService = require(Services.MonetizationService)
Registry.StatsService = require(Services.StatsService)
Registry.RollService = require(Services.RollService)
Registry.RewardService = require(Services.RewardService)
Registry.LeaderboardService = require(Services.LeaderboardService)
Registry.AvatarService = require(Services.AvatarService)
Registry.TradeService = require(Services.TradeService)
Registry.MapService = require(script.Map.MapService)

local announceRemote = Remotes.event("Announce")
Registry.Announce = function(text: string)
	announceRemote:FireAllClients({ kind = "info", text = text })
end

-- Order matters: requests must exist before services register handlers, and
-- the map should exist before players spawn. DataService starts last so every
-- onLoaded/PlayerAdded hook is connected before the first profile loads.
local ORDER = {
	"MapService",
	"RequestService",
	"MonetizationService",
	"StatsService",
	"RollService",
	"RewardService",
	"LeaderboardService",
	"AvatarService",
	"TradeService",
	"DataService",
}

for _, name in ORDER do
	local ok, err = pcall(Registry[name].init)
	if not ok then
		warn(`[Server] {name} failed to start: {err}`)
	end
end

print("[Become An Millionaire RNG] Server ready")
]]></string>
      </Properties>
      <Item class="Folder" referent="17">
        <Properties>
          <string name="Name">Config</string>
        </Properties>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">Codes</string>
            <string name="Source"><![CDATA[--!strict
-- Redeemable codes. Server-only (clients cannot read ServerScriptService), so
-- codes can't be discovered by exploiters. Codes are case-insensitive; write
-- them here in UPPERCASE. `expiresAt` is an optional UTC unix timestamp.

local Codes: { [string]: { reward: { cash: number?, scaledCash: number?, luckBoost: { mult: number, minutes: number }? }, expiresAt: number? } } = {
	RELEASE = { reward = { cash = 5_000 } },
	LUCKY = { reward = { luckBoost = { mult = 2, minutes = 15 } } },
	MILLIONAIRE = { reward = { scaledCash = 25, luckBoost = { mult = 1.5, minutes = 10 } } },
}

return Codes
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="19">
        <Properties>
          <string name="Name">Logic</string>
        </Properties>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">Daily</string>
            <string name="Source"><![CDATA[--!strict
-- Daily login streak, daily luck boost and playtime rewards.
-- All timing uses the server clock (os.time) and UTC day numbers that are
-- saved in the profile, so reconnecting or changing the client clock cannot
-- grant a reward twice.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local Formulas = require(Shared.Modules.Formulas)
local Economy = require(script.Parent.Economy)

type Profile = { [string]: any }

local Daily = {}

function Daily.canClaimLogin(profile: Profile, now: number): boolean
	return profile.daily.lastLoginDay < Formulas.dayNumber(now)
end

-- Reward slot (1-based) for today's claim, or the slot already claimed today.
function Daily.loginIndex(profile: Profile, now: number): number
	local today = Formulas.dayNumber(now)
	local last = profile.daily.lastLoginDay
	local streak = if last == today
		then profile.daily.streak
		elseif last == today - 1 then profile.daily.streak + 1
		else 1
	return ((streak - 1) % #GameConfig.DailyLogin) + 1
end

function Daily.claimLogin(profile: Profile, now: number): (boolean, string)
	local today = Formulas.dayNumber(now)
	local daily = profile.daily
	if daily.lastLoginDay >= today then
		return false, "Already claimed today. Come back tomorrow!"
	end
	if daily.lastLoginDay == today - 1 then
		daily.streak += 1
	else
		daily.streak = 1
	end
	daily.lastLoginDay = today
	local reward = GameConfig.DailyLogin[((daily.streak - 1) % #GameConfig.DailyLogin) + 1]
	return true, `Day {daily.streak} reward: ` .. Economy.grant(profile, reward, "daily", now)
end

function Daily.claimBoost(profile: Profile, now: number): (boolean, string)
	local today = Formulas.dayNumber(now)
	if profile.daily.boostDay >= today then
		return false, "Daily luck boost already used today"
	end
	profile.daily.boostDay = today
	local boost = GameConfig.DailyLuckBoost
	Economy.addBoost(profile, "dailyBoost", boost.mult, boost.minutes, now)
	return true, `{boost.mult}x Luck for {boost.minutes} minutes!`
end

local function rollPlayDay(profile: Profile, now: number)
	local today = Formulas.dayNumber(now)
	if profile.daily.playDay ~= today then
		profile.daily.playDay = today
		profile.daily.playSeconds = 0
		profile.daily.playClaimed = {}
	end
end

function Daily.addPlaytime(profile: Profile, now: number, seconds: number)
	rollPlayDay(profile, now)
	seconds = math.clamp(seconds, 0, 10) -- a single tick can never add more than 10s
	profile.daily.playSeconds += seconds
	profile.stats.playSeconds += seconds
end

function Daily.claimPlaytime(profile: Profile, index: any, now: number): (boolean, string)
	rollPlayDay(profile, now)
	if type(index) ~= "number" or index % 1 ~= 0 then
		return false, "Invalid reward"
	end
	local tier = GameConfig.PlaytimeRewards[index]
	if not tier then
		return false, "Invalid reward"
	end
	local key = tostring(index)
	if profile.daily.playClaimed[key] then
		return false, "Already claimed today"
	end
	if profile.daily.playSeconds < tier.minutes * 60 then
		return false, "Keep playing to unlock this reward"
	end
	profile.daily.playClaimed[key] = true
	return true, "Playtime reward: " .. Economy.grant(profile, tier.reward, "playtime", now)
end

return Daily
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">Economy</string>
            <string name="Source"><![CDATA[--!strict
-- Pure, server-only state transitions for spending and granting cash.
-- Every function validates its input against the profile and returns
-- (ok, message). Nothing here trusts values from a client.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local Upgrades = require(Shared.Config.Upgrades)
local Rarities = require(Shared.Config.Rarities)
local Formulas = require(Shared.Modules.Formulas)
local NumberFormat = require(Shared.Modules.NumberFormat)

type Profile = { [string]: any }
type Reward = GameConfig.Reward

local Economy = {}

function Economy.addCash(profile: Profile, amount: number)
	if amount ~= amount or amount <= 0 or amount == math.huge then
		return
	end
	profile.cash += amount
	profile.lifetime += amount
end

function Economy.addBoost(profile: Profile, source: string, mult: number, minutes: number, now: number)
	local existing = profile.boosts[source]
	local start = if existing and existing.expires > now then existing.expires else now
	profile.boosts[source] = {
		mult = if existing and existing.expires > now then math.max(existing.mult, mult) else mult,
		expires = start + minutes * 60,
	}
end

function Economy.pruneBoosts(profile: Profile, now: number)
	for source, boost in profile.boosts do
		if boost.expires <= now then
			profile.boosts[source] = nil
		end
	end
end

-- Grants a reward and returns a human readable description of it.
function Economy.grant(profile: Profile, reward: Reward, source: string, now: number): string
	local parts = {}
	local cash = Formulas.rewardCash(reward, profile.bestOrder)
	if cash > 0 then
		Economy.addCash(profile, cash)
		table.insert(parts, "$" .. NumberFormat.short(cash))
	end
	if reward.luckBoost then
		Economy.addBoost(profile, source, reward.luckBoost.mult, reward.luckBoost.minutes, now)
		table.insert(parts, `{reward.luckBoost.mult}x Luck ({reward.luckBoost.minutes}m)`)
	end
	return table.concat(parts, " + ")
end

function Economy.describe(reward: Reward, bestOrder: number): string
	local parts = {}
	local cash = Formulas.rewardCash(reward, bestOrder)
	if cash > 0 then
		table.insert(parts, "$" .. NumberFormat.short(cash))
	end
	if reward.luckBoost then
		table.insert(parts, `{reward.luckBoost.mult}x Luck ({reward.luckBoost.minutes}m)`)
	end
	return table.concat(parts, " + ")
end

function Economy.buyUpgrade(profile: Profile, upgradeId: any): (boolean, string)
	if type(upgradeId) ~= "string" then
		return false, "Invalid upgrade"
	end
	local upgrade = Upgrades.byId[upgradeId]
	if not upgrade then
		return false, "Invalid upgrade"
	end
	local level = profile.upgrades[upgradeId] or 0
	if level >= upgrade.maxLevel then
		return false, "Already maxed"
	end
	local cost = Formulas.upgradeCost(upgradeId, level)
	if profile.cash < cost then
		return false, "Not enough cash"
	end
	profile.cash -= cost
	profile.upgrades[upgradeId] = level + 1
	profile.stats.upgradesBought += 1
	return true, `{upgrade.name} upgraded to level {level + 1}`
end

function Economy.rebirth(profile: Profile): (boolean, string)
	if profile.rebirths >= GameConfig.Rebirth.maxRebirths then
		return false, "Max rebirths reached"
	end
	local cost = Formulas.rebirthCost(profile.rebirths)
	if profile.cash < cost then
		return false, `You need ${NumberFormat.short(cost)} to rebirth`
	end
	profile.cash = 0
	for _, upgrade in Upgrades.list do
		if not upgrade.keepOnRebirth then
			profile.upgrades[upgrade.id] = 0
		end
	end
	profile.rebirths += 1
	return true, `Rebirth {profile.rebirths}! Permanent bonuses increased.`
end

function Economy.unlockZone(profile: Profile, zoneId: any): (boolean, string)
	if type(zoneId) ~= "string" then
		return false, "Invalid zone"
	end
	local zone = GameConfig.ZoneById[zoneId]
	if not zone then
		return false, "Invalid zone"
	end
	if profile.zones[zoneId] then
		return false, "Already unlocked"
	end
	if profile.rebirths < zone.requiredRebirths then
		return false, `Requires {zone.requiredRebirths} rebirth(s)`
	end
	if profile.cash < zone.cost then
		return false, `You need ${NumberFormat.short(zone.cost)}`
	end
	profile.cash -= zone.cost
	profile.zones[zoneId] = true
	return true, `{zone.name} unlocked!`
end

function Economy.equipAura(profile: Profile, auraId: any, hasVipPass: boolean): (boolean, string)
	if auraId == "" then
		profile.equippedAura = ""
		return true, "Aura unequipped"
	end
	if type(auraId) ~= "string" then
		return false, "Invalid aura"
	end
	if auraId == "VIP" then
		if not hasVipPass then
			return false, "VIP aura requires the VIP pass"
		end
		profile.equippedAura = "VIP"
		return true, "VIP aura equipped"
	end
	local rarity = Rarities.get(auraId)
	if not rarity or not rarity.hasAura then
		return false, "Invalid aura"
	end
	if (profile.inventory[auraId] or 0) < 1 then
		return false, "You don't own that aura"
	end
	profile.equippedAura = auraId
	return true, `{rarity.name} aura equipped`
end

local BOOLEAN_SETTINGS = {
	effects = true,
	shake = true,
	sounds = true,
	hideOtherAuras = true,
	autoRollSkipReveal = true,
}

function Economy.setSetting(profile: Profile, key: any, value: any): (boolean, string)
	if type(key) ~= "string" or not BOOLEAN_SETTINGS[key] or type(value) ~= "boolean" then
		return false, "Invalid setting"
	end
	profile.settings[key] = value
	return true, "Saved"
end

export type CodeDefinition = { reward: Reward, expiresAt: number? }

function Economy.redeemCode(profile: Profile, rawCode: any, codes: { [string]: CodeDefinition }, now: number): (boolean, string)
	if type(rawCode) ~= "string" or #rawCode == 0 or #rawCode > 32 then
		return false, "Invalid code"
	end
	local code = string.upper((rawCode:gsub("%s", "")))
	local definition = codes[code]
	if not definition then
		return false, "Invalid code"
	end
	if definition.expiresAt and now >= definition.expiresAt then
		return false, "This code has expired"
	end
	if profile.codes[code] then
		return false, "Code already redeemed"
	end
	profile.codes[code] = true
	return true, "Code redeemed: " .. Economy.grant(profile, definition.reward, "code", now)
end

return Economy
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">Profile</string>
            <string name="Source"><![CDATA[--!strict
-- Versioned player-data schema.
--
-- Adding a field: add it to `template()` with a default. `reconcile` fills it
-- in for existing players automatically, without touching their other data.
-- Changing the meaning/shape of a field: bump GameConfig.DataVersion and add a
-- step to MIGRATIONS that converts version n-1 data to version n.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)

local Profile = {}

function Profile.template(): { [string]: any }
	return {
		version = GameConfig.DataVersion,
		cash = 0,
		lifetime = 0,
		totalRolls = 0,
		bestOrder = 0,
		bestCash = 0,
		rebirths = 0,
		upgrades = { Luck = 0, Cash = 0, Speed = 0, Capacity = 0, Offline = 0 },
		inventory = {}, -- [rarityId] = count of collected auras
		discovered = {}, -- [rarityId] = true
		rarityCounts = {}, -- [rarityId] = times rolled
		equippedAura = "",
		zones = { Downtown = true },
		history = {}, -- recent { id, cash }
		quests = {
			daily = { day = 0, list = {} },
			repeatable = {}, -- [questId] = { stage, progress }
		},
		achievements = {}, -- [id] = true
		milestones = {}, -- [tostring(rolls)] = true
		daily = {
			lastLoginDay = 0,
			streak = 0,
			boostDay = 0,
			playDay = 0,
			playSeconds = 0,
			playClaimed = {}, -- [tostring(index)] = true
		},
		boosts = {}, -- [source] = { mult, expires }
		settings = {
			effects = true,
			shake = true,
			sounds = true,
			hideOtherAuras = false,
			autoRollSkipReveal = false,
		},
		codes = {}, -- [CODE] = true
		receipts = {}, -- recent developer product PurchaseIds (newest last)
		stats = { upgradesBought = 0, trades = 0, playSeconds = 0 },
		lastOnline = 0,
		createdAt = 0,
	}
end

-- version n-1 -> n. Example for a future v2:
-- [2] = function(data) data.newField = data.oldField; data.oldField = nil end,
local MIGRATIONS: { [number]: (data: { [string]: any }) -> () } = {}

local function deepCopy(value: any): any
	if type(value) ~= "table" then
		return value
	end
	local copy = {}
	for key, child in value do
		copy[key] = deepCopy(child)
	end
	return copy
end
Profile.deepCopy = deepCopy

-- Adds any missing keys from the template, recursively, but only into tables
-- whose template value is a "record" (non-empty). Map-style tables that are
-- empty in the template (inventory, codes...) are left as the player has them.
local function reconcile(target: { [string]: any }, template: { [string]: any })
	for key, default in template do
		local current = target[key]
		if current == nil or type(current) ~= type(default) then
			target[key] = deepCopy(default)
		elseif type(default) == "table" and next(default) ~= nil then
			reconcile(current, default)
		end
	end
end

-- Returns a profile that is safe to use. Never discards existing values.
function Profile.migrate(data: { [string]: any }?): { [string]: any }
	if data == nil then
		return Profile.template()
	end
	local version = tonumber(data.version) or 1
	if version > GameConfig.DataVersion then
		-- Data written by a newer server version. Refuse rather than downgrade.
		error(`Profile version {version} is newer than this server ({GameConfig.DataVersion})`)
	end
	while version < GameConfig.DataVersion do
		version += 1
		local step = MIGRATIONS[version]
		if step then
			step(data)
		end
	end
	data.version = GameConfig.DataVersion
	reconcile(data, Profile.template())
	return data
end

-- What the client is allowed to see about its own profile.
function Profile.snapshot(profile: { [string]: any }): { [string]: any }
	local copy = deepCopy(profile)
	copy.receipts = nil
	copy.codes = nil
	return copy
end

return Profile
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">Quests</string>
            <string name="Source"><![CDATA[--!strict
-- Daily quests, repeatable quests, achievements and roll milestones.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local QuestConfig = require(Shared.Config.Quests)
local Rarities = require(Shared.Config.Rarities)
local Formulas = require(Shared.Modules.Formulas)
local Economy = require(script.Parent.Economy)

type Profile = { [string]: any }

local Quests = {}

-- Deterministic per-day selection (same three quests for everyone each day).
local function pickDaily(day: number): { string }
	local ids = {}
	for _, quest in QuestConfig.DailyPool do
		table.insert(ids, quest.id)
	end
	-- Park-Miller LCG: products stay below 2^53 so doubles are exact.
	local state = (day % 2147483646) + 1
	for i = #ids, 2, -1 do
		state = (state * 16807) % 2147483647
		local j = (state % i) + 1
		ids[i], ids[j] = ids[j], ids[i]
	end
	local chosen = {}
	for i = 1, math.min(QuestConfig.DailyCount, #ids) do
		chosen[i] = ids[i]
	end
	return chosen
end
Quests.pickDaily = pickDaily

local function scaledTarget(kind: string, target: number, bestOrder: number): number
	if kind == "earn" then
		return math.floor(target * Formulas.bestMinCash(bestOrder))
	end
	return target
end

-- Makes sure today's quests exist. Returns true if they were (re)issued.
function Quests.ensureDaily(profile: Profile, now: number): boolean
	local today = Formulas.dayNumber(now)
	local daily = profile.quests.daily
	if daily.day == today and #daily.list > 0 then
		return false
	end
	daily.day = today
	daily.list = {}
	for _, id in pickDaily(today) do
		local template = QuestConfig.DailyById[id]
		table.insert(daily.list, {
			id = id,
			target = scaledTarget(template.kind, template.target, profile.bestOrder),
			progress = 0,
			claimed = false,
		})
	end
	return true
end

function Quests.ensureRepeatable(profile: Profile)
	for _, quest in QuestConfig.Repeatable do
		if not profile.quests.repeatable[quest.id] then
			profile.quests.repeatable[quest.id] = {
				stage = 0,
				progress = 0,
				target = scaledTarget(quest.kind, quest.target, profile.bestOrder),
			}
		end
	end
end

local function matches(template: QuestConfig.QuestTemplate, kind: string, order: number?): boolean
	if template.kind ~= kind then
		return false
	end
	if kind == "rarityAtLeast" then
		return order ~= nil and order >= (template.minOrder or 1)
	end
	return true
end

-- kind: quest kind; amount: progress to add; order: rarity order for rarityAtLeast
function Quests.progress(profile: Profile, kind: string, amount: number, order: number?)
	for _, entry in profile.quests.daily.list do
		local template = QuestConfig.DailyById[entry.id]
		if template and not entry.claimed and matches(template, kind, order) then
			entry.progress = math.min(entry.progress + amount, entry.target)
		end
	end
	for id, state in profile.quests.repeatable do
		local template = QuestConfig.RepeatableById[id]
		if template and matches(template, kind, order) then
			state.progress = math.min(state.progress + amount, state.target)
		end
	end
end

function Quests.claimDaily(profile: Profile, index: any, now: number): (boolean, string)
	if type(index) ~= "number" then
		return false, "Invalid quest"
	end
	local entry = profile.quests.daily.list[index]
	if not entry or profile.quests.daily.day ~= Formulas.dayNumber(now) then
		return false, "Quest expired"
	end
	if entry.claimed then
		return false, "Already claimed"
	end
	if entry.progress < entry.target then
		return false, "Quest not complete"
	end
	entry.claimed = true
	local template = QuestConfig.DailyById[entry.id]
	return true, "Quest complete: " .. Economy.grant(profile, template.reward, "quest", now)
end

function Quests.claimRepeatable(profile: Profile, id: any, now: number): (boolean, string)
	if type(id) ~= "string" then
		return false, "Invalid quest"
	end
	local template = QuestConfig.RepeatableById[id]
	local state = profile.quests.repeatable[id]
	if not template or not state then
		return false, "Invalid quest"
	end
	if state.progress < state.target then
		return false, "Quest not complete"
	end
	local text = Economy.grant(profile, template.reward, "quest", now)
	state.stage += 1
	state.progress = 0
	state.target = scaledTarget(
		template.kind,
		Formulas.repeatableTarget(template.target, template.growth, state.stage),
		profile.bestOrder
	)
	return true, "Quest complete: " .. text
end

function Quests.statValue(profile: Profile, stat: string): number
	if stat == "totalRolls" then
		return profile.totalRolls
	elseif stat == "lifetime" then
		return profile.lifetime
	elseif stat == "rebirths" then
		return profile.rebirths
	elseif stat == "discovered" then
		local count = 0
		for _ in profile.discovered do
			count += 1
		end
		return count
	elseif stat == "bestOrder" then
		return profile.bestOrder
	elseif stat == "upgradesBought" then
		return profile.stats.upgradesBought
	elseif stat == "trades" then
		return profile.stats.trades
	elseif stat == "streak" then
		return profile.daily.streak
	end
	return 0
end

function Quests.achievementTarget(achievement: QuestConfig.Achievement): number
	return if achievement.target < 0 then Rarities.count else achievement.target
end

-- Grants every newly met achievement. Returns their definitions + reward text.
function Quests.checkAchievements(profile: Profile, now: number): { { achievement: QuestConfig.Achievement, text: string } }
	local earned = {}
	for _, achievement in QuestConfig.Achievements do
		if not profile.achievements[achievement.id]
			and Quests.statValue(profile, achievement.stat) >= Quests.achievementTarget(achievement)
		then
			profile.achievements[achievement.id] = true
			local text = Economy.grant(profile, achievement.reward, "achievement", now)
			table.insert(earned, { achievement = achievement, text = text })
		end
	end
	return earned
end

function Quests.checkMilestones(profile: Profile, now: number): { string }
	local messages = {}
	for _, milestone in GameConfig.RollMilestones do
		local key = tostring(milestone.rolls)
		if profile.totalRolls >= milestone.rolls and not profile.milestones[key] then
			profile.milestones[key] = true
			local text = Economy.grant(profile, milestone.reward, "milestone", now)
			table.insert(messages, `{milestone.rolls} rolls milestone: {text}`)
		end
	end
	return messages
end

return Quests
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">Roll</string>
            <string name="Source"><![CDATA[--!strict
-- Authoritative roll resolution. The caller supplies the computed stats and a
-- server-side random source; the client never influences either.

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local Rarities = require(Shared.Config.Rarities)
local RNG = require(Shared.Modules.RNG)
local Formulas = require(Shared.Modules.Formulas)
local Economy = require(script.Parent.Economy)

type Profile = { [string]: any }

export type SingleResult = { id: string, cash: number }
export type RollOutcome = {
	results: { SingleResult },
	best: string,
	bestCash: number,
	total: number,
	newDiscoveries: { string },
	rollsDone: number,
}

local Roll = {}

function Roll.perform(profile: Profile, stats: Formulas.Stats, random: () -> number): RollOutcome
	local results: { SingleResult } = {}
	local total = 0
	local best: Rarities.Rarity? = nil
	local bestCash = 0
	local newDiscoveries = {}

	for _ = 1, stats.rollsPerClick do
		local rarity = RNG.pick(stats.luck, random)
		local cash = math.floor(RNG.rollCash(rarity, random) * stats.cashMultiplier)
		table.insert(results, { id = rarity.id, cash = cash })
		total += cash

		profile.rarityCounts[rarity.id] = (profile.rarityCounts[rarity.id] or 0) + 1
		if rarity.hasAura then
			profile.inventory[rarity.id] = (profile.inventory[rarity.id] or 0) + 1
		end
		if not profile.discovered[rarity.id] then
			profile.discovered[rarity.id] = true
			table.insert(newDiscoveries, rarity.id)
		end
		if rarity.order > profile.bestOrder then
			profile.bestOrder = rarity.order
		end
		if not best or rarity.order > best.order or (rarity.order == best.order and cash > bestCash) then
			best = rarity
			bestCash = cash
		end
	end

	assert(best, "rollsPerClick must be >= 1")
	Economy.addCash(profile, total)
	profile.totalRolls += stats.rollsPerClick
	if bestCash > profile.bestCash then
		profile.bestCash = bestCash
	end

	table.insert(profile.history, 1, { id = best.id, cash = bestCash })
	while #profile.history > GameConfig.Roll.historySize do
		table.remove(profile.history)
	end

	return {
		results = results,
		best = best.id,
		bestCash = bestCash,
		total = total,
		newDiscoveries = newDiscoveries,
		rollsDone = stats.rollsPerClick,
	}
end

return Roll
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">Trade</string>
            <string name="Source"><![CDATA[--!strict
-- Trade validation and execution for collectible auras. Only auras are
-- tradeable (never cash) to keep the economy safe.
--
-- Safety properties:
--  * Offers are sanitised: only known aura ids, positive whole counts, no
--    more than the player owns, at most `maxKindsPerOffer` kinds.
--  * `execute` re-validates both offers against the live inventories and only
--    mutates after both pass. It never yields, so nothing can change between
--    validation and the swap (Luau runs it atomically on the server).

local Shared = game:GetService("ReplicatedStorage"):WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local Rarities = require(Shared.Config.Rarities)

type Profile = { [string]: any }
export type Offer = { [string]: number }

local Trade = {}

function Trade.sanitizeOffer(profile: Profile, raw: any): (Offer?, string?)
	if type(raw) ~= "table" then
		return nil, "Invalid offer"
	end
	local offer: Offer = {}
	local kinds = 0
	for id, count in raw do
		if type(id) ~= "string" or type(count) ~= "number" then
			return nil, "Invalid offer"
		end
		local rarity = Rarities.get(id)
		if not rarity or not rarity.hasAura then
			return nil, "Invalid item"
		end
		if count ~= count or count % 1 ~= 0 or count < 0 or count > 1e6 then
			return nil, "Invalid amount"
		end
		if count > 0 then
			if (profile.inventory[id] or 0) < count then
				return nil, "You don't own enough " .. rarity.name
			end
			kinds += 1
			offer[id] = count
		end
	end
	if kinds > GameConfig.Trade.maxKindsPerOffer then
		return nil, "Too many different items"
	end
	return offer, nil
end

local function owns(profile: Profile, offer: Offer): boolean
	for id, count in offer do
		if (profile.inventory[id] or 0) < count then
			return false
		end
	end
	return true
end

local function isEmpty(offer: Offer): boolean
	return next(offer) == nil
end

local function move(from: Profile, to: Profile, offer: Offer)
	for id, count in offer do
		local remaining = from.inventory[id] - count
		from.inventory[id] = if remaining > 0 then remaining else nil
		to.inventory[id] = (to.inventory[id] or 0) + count
		if remaining <= 0 and from.equippedAura == id then
			from.equippedAura = ""
		end
	end
end

function Trade.execute(a: Profile, offerA: Offer, b: Profile, offerB: Offer): (boolean, string)
	if a == b then
		return false, "Cannot trade with yourself"
	end
	if isEmpty(offerA) and isEmpty(offerB) then
		return false, "Both offers are empty"
	end
	if not owns(a, offerA) or not owns(b, offerB) then
		return false, "An offered item is no longer available"
	end
	move(a, b, offerA)
	move(b, a, offerB)
	a.stats.trades += 1
	b.stats.trades += 1
	return true, "Trade complete!"
end

return Trade
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="Folder" referent="26">
        <Properties>
          <string name="Name">Map</string>
        </Properties>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">Builder</string>
            <string name="Source"><![CDATA[-- Tiny helpers for building map geometry in code.

local Builder = {}

export type PartProps = { [string]: any }

local DEFAULTS = {
	Anchored = true,
	TopSurface = Enum.SurfaceType.Smooth,
	BottomSurface = Enum.SurfaceType.Smooth,
	CastShadow = true,
}

function Builder.part(parent: Instance, props: PartProps, className: string?): BasePart
	local part = Instance.new((className or "Part") :: any) :: BasePart
	for key, value in DEFAULTS do
		(part :: any)[key] = value
	end
	for key, value in props do
		if key ~= "Shape" then
			(part :: any)[key] = value
		end
	end
	if props.Shape then
		(part :: any).Shape = props.Shape
	end
	part.Parent = parent
	return part
end

function Builder.model(parent: Instance, name: string): Model
	local model = Instance.new("Model")
	model.Name = name
	model.Parent = parent
	return model
end

function Builder.folder(parent: Instance, name: string): Folder
	local folder = Instance.new("Folder")
	folder.Name = name
	folder.Parent = parent
	return folder
end

-- A sign: thin part with a SurfaceGui label on its front (-Z) face.
function Builder.sign(parent: Instance, cframe: CFrame, size: Vector3, text: string, options: { [string]: any }?): BasePart
	local opts = options or {}
	local board = Builder.part(parent, {
		Name = "Sign",
		Size = size,
		CFrame = cframe,
		Color = opts.background or Color3.fromRGB(20, 20, 24),
		Material = opts.material or Enum.Material.SmoothPlastic,
		CastShadow = false,
	})
	local gui = Instance.new("SurfaceGui")
	gui.Face = opts.face or Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = opts.pixelsPerStud or 30
	gui.LightInfluence = 0
	gui.Brightness = opts.brightness or 1.5
	gui.Parent = board
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Text = text
	label.TextScaled = true
	label.Font = opts.font or Enum.Font.GothamBlack
	label.TextColor3 = opts.textColor or Color3.fromRGB(255, 215, 90)
	label.TextStrokeTransparency = 0.6
	label.Parent = gui
	local padding = Instance.new("UIPadding")
	padding.PaddingLeft = UDim.new(0.04, 0)
	padding.PaddingRight = UDim.new(0.04, 0)
	padding.PaddingTop = UDim.new(0.08, 0)
	padding.PaddingBottom = UDim.new(0.08, 0)
	padding.Parent = label
	return board
end

function Builder.light(parent: BasePart, color: Color3, range: number, brightness: number?)
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = range
	light.Brightness = brightness or 1
	light.Shadows = false
	light.Parent = parent
	return light
end

function Builder.prompt(parent: BasePart, actionText: string, objectText: string, panel: string): ProximityPrompt
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = actionText
	prompt.ObjectText = objectText
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 14
	prompt.RequiresLineOfSight = false
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt:SetAttribute("OpenPanel", panel)
	prompt.Parent = parent
	return prompt
end

return Builder
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">MapService</string>
            <string name="Source"><![CDATA[-- Builds the luxury map at server start (unless Workspace already contains a
-- hand-made "Map" model with Workspace:GetAttribute("KeepCustomMap") = true).
--
-- Blender props: any Model placed in ServerStorage.Models with one of the
-- names in PROP_NAMES replaces the code-built fallback for that prop. It is
-- scaled to fit the same footprint automatically, so import scale doesn't
-- matter. See docs/BLENDER.md.

local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local NumberFormat = require(Shared.Modules.NumberFormat)

local Registry = require(script.Parent.Parent.Registry)
local B = require(script.Parent.Builder)

local MapService = {}

-- Palette
local GOLD = Color3.fromRGB(255, 196, 64)
local DEEP_GOLD = Color3.fromRGB(200, 140, 30)
local MARBLE = Color3.fromRGB(236, 232, 224)
local DARK = Color3.fromRGB(28, 26, 32)
local ASPHALT = Color3.fromRGB(46, 46, 52)
local SIDEWALK = Color3.fromRGB(190, 184, 172)
local GRASS = Color3.fromRGB(86, 150, 76)
local LEAF = Color3.fromRGB(70, 140, 60)
local WATER = Color3.fromRGB(80, 170, 230)
local NEON_PINK = Color3.fromRGB(255, 70, 190)
local NEON_CYAN = Color3.fromRGB(60, 230, 255)
local PURPLE = Color3.fromRGB(150, 80, 255)

local VERTICAL = CFrame.Angles(0, 0, math.rad(90)) -- cylinder axis X -> Y

local map: Model
local boards: { [string]: Frame } = {}
local customModels = ServerStorage:FindFirstChild("Models")

------------------------------------------------------------------------------
-- Blender prop replacement
------------------------------------------------------------------------------

-- Blender meshes are named "<Palette>_<Part>"; this restores colour and
-- material even if the 3D Importer dropped them.
local PROP_PALETTE: { [string]: { Color3 | Enum.Material | number } } = {
	Gold = { GOLD, Enum.Material.Foil },
	Marble = { MARBLE, Enum.Material.Marble },
	Dark = { DARK, Enum.Material.Metal },
	Water = { WATER, Enum.Material.Glass, 0.3 },
	Leaf = { LEAF, Enum.Material.Grass },
	Palm = { Color3.fromRGB(60, 150, 70), Enum.Material.Grass },
	Wood = { Color3.fromRGB(110, 75, 45), Enum.Material.Wood },
	Bark = { Color3.fromRGB(150, 110, 70), Enum.Material.Wood },
	Steel = { Color3.fromRGB(150, 155, 165), Enum.Material.DiamondPlate },
	Red = { Color3.fromRGB(150, 20, 40), Enum.Material.SmoothPlastic },
	White = { Color3.fromRGB(245, 245, 245), Enum.Material.SmoothPlastic },
	Pip = { Color3.fromRGB(200, 20, 40), Enum.Material.SmoothPlastic },
	Glow = { Color3.fromRGB(255, 236, 180), Enum.Material.Neon },
	Neon = { NEON_CYAN, Enum.Material.Neon },
}

local function applyPalette(part: BasePart)
	local prefix = string.match(part.Name, "^(%a+)_")
	local entry = prefix and PROP_PALETTE[prefix]
	if entry then
		part.Color = entry[1] :: Color3
		part.Material = entry[2] :: Enum.Material
		if entry[3] then
			part.Transparency = entry[3] :: number
			part.CanCollide = false
		end
		if prefix == "Glow" then
			B.light(part, entry[1] :: Color3, 26, 1.2)
		end
	end
end

local function placeProp(parent: Instance, name: string, cframe: CFrame, footprint: number, fallback: () -> Instance?): Instance?
	local template = customModels and customModels:FindFirstChild(name)
	if template and template:IsA("Model") then
		local clone = template:Clone()
		local size = clone:GetExtentsSize()
		local largest = math.max(size.X, size.Z, 0.01)
		pcall(function()
			clone:ScaleTo(clone:GetScale() * footprint / largest)
		end)
		local _, extents = clone:GetBoundingBox()
		clone:PivotTo(cframe * CFrame.new(0, extents.Y / 2, 0))
		for _, descendant in clone:GetDescendants() do
			if descendant:IsA("BasePart") then
				descendant.Anchored = true
				applyPalette(descendant)
			end
		end
		clone.Parent = parent
		return clone
	end
	return fallback()
end

------------------------------------------------------------------------------
-- Reusable props (code fallbacks)
------------------------------------------------------------------------------

local function tree(parent: Instance, position: Vector3, scale: number?)
	local s = scale or 1
	placeProp(parent, "Tree", CFrame.new(position), 9 * s, function()
		local model = B.model(parent, "Tree")
		B.part(model, {
			Name = "Trunk",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(9 * s, 1.6 * s, 1.6 * s),
			CFrame = CFrame.new(position + Vector3.new(0, 4.5 * s, 0)) * VERTICAL,
			Color = Color3.fromRGB(110, 75, 45),
			Material = Enum.Material.Wood,
		})
		B.part(model, {
			Name = "Leaves",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(9, 9, 9) * s,
			CFrame = CFrame.new(position + Vector3.new(0, 10 * s, 0)),
			Color = LEAF,
			Material = Enum.Material.Grass,
		})
		return model
	end)
end

local function palm(parent: Instance, position: Vector3)
	placeProp(parent, "PalmTree", CFrame.new(position), 10, function()
		local model = B.model(parent, "PalmTree")
		B.part(model, {
			Name = "Trunk",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(16, 1.4, 1.4),
			CFrame = CFrame.new(position + Vector3.new(0, 8, 0)) * CFrame.Angles(0, 0, math.rad(85)),
			Color = Color3.fromRGB(150, 110, 70),
			Material = Enum.Material.Wood,
		})
		for i = 0, 4 do
			local angle = math.rad(i * 72)
			B.part(model, {
				Name = "Frond",
				Size = Vector3.new(1.4, 0.3, 7),
				CFrame = CFrame.new(position + Vector3.new(0, 16, 0))
					* CFrame.Angles(0, angle, 0)
					* CFrame.Angles(math.rad(-20), 0, 0)
					* CFrame.new(0, 0, -3),
				Color = Color3.fromRGB(60, 150, 70),
				Material = Enum.Material.Grass,
				CastShadow = false,
			})
		end
		return model
	end)
end

local lampCount = 0
local function lamp(parent: Instance, position: Vector3)
	lampCount += 1
	local lit = lampCount % 2 == 0 -- every other lamp casts light (mobile performance)
	placeProp(parent, "Lamp", CFrame.new(position), 2.5, function()
		local model = B.model(parent, "Lamp")
		B.part(model, {
			Name = "Pole",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(12, 0.6, 0.6),
			CFrame = CFrame.new(position + Vector3.new(0, 6, 0)) * VERTICAL,
			Color = DARK,
			Material = Enum.Material.Metal,
		})
		local head = B.part(model, {
			Name = "Head",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(2, 2, 2),
			CFrame = CFrame.new(position + Vector3.new(0, 12.5, 0)),
			Color = Color3.fromRGB(255, 236, 180),
			Material = Enum.Material.Neon,
			CastShadow = false,
		})
		if lit then
			B.light(head, Color3.fromRGB(255, 220, 160), 30, 1.2)
		end
		return model
	end)
end

local function goldBars(parent: Instance, cframe: CFrame)
	placeProp(parent, "GoldBars", cframe, 6, function()
		local model = B.model(parent, "GoldBars")
		local index = 0
		for layer = 0, 2 do
			for row = 0, 2 - layer do
				index += 1
				B.part(model, {
					Name = "Bar" .. index,
					Size = Vector3.new(1.6, 0.8, 3.2),
					CFrame = cframe * CFrame.new((row - (2 - layer) / 2) * 1.8, 0.4 + layer * 0.8, 0),
					Color = GOLD,
					Material = Enum.Material.Foil,
				})
			end
		end
		return model
	end)
end

local function station(parent: Instance, name: string, cframe: CFrame, color: Color3, title: string, panel: string, actionText: string)
	local model = B.model(parent, name)
	B.part(model, {
		Name = "Base",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(1, 10, 10),
		CFrame = cframe * CFrame.new(0, 0.5, 0) * VERTICAL,
		Color = DARK,
		Material = Enum.Material.Marble,
	})
	local pedestal = B.part(model, {
		Name = "Pedestal",
		Size = Vector3.new(4, 4, 4),
		CFrame = cframe * CFrame.new(0, 3, 0),
		Color = GOLD,
		Material = Enum.Material.Foil,
	})
	local orb = B.part(model, {
		Name = "Orb",
		Shape = Enum.PartType.Ball,
		Size = Vector3.new(3, 3, 3),
		CFrame = cframe * CFrame.new(0, 6.6, 0),
		Color = color,
		Material = Enum.Material.Neon,
		CastShadow = false,
	})
	B.light(orb, color, 16, 2)
	B.sign(model, cframe * CFrame.new(0, 10, 0), Vector3.new(10, 2.6, 0.4), title, { textColor = color, background = DARK })
	B.prompt(pedestal, actionText, title, panel)
	return model
end

------------------------------------------------------------------------------
-- Areas
------------------------------------------------------------------------------

local function buildGround(parent: Instance)
	B.part(parent, {
		Name = "Ground",
		Size = Vector3.new(760, 4, 760),
		CFrame = CFrame.new(0, -2, 60),
		Color = GRASS,
		Material = Enum.Material.Grass,
	})
	-- Invisible boundary walls keep players on the island.
	for _, data in {
		{ Vector3.new(0, 40, -320), Vector3.new(760, 100, 4) },
		{ Vector3.new(0, 40, 440), Vector3.new(760, 100, 4) },
		{ Vector3.new(-380, 40, 60), Vector3.new(4, 100, 760) },
		{ Vector3.new(380, 40, 60), Vector3.new(4, 100, 760) },
	} do
		B.part(parent, { Name = "Boundary", Size = data[2], CFrame = CFrame.new(data[1]), Transparency = 1, CastShadow = false })
	end
end

local function buildRoads(parent: Instance)
	local roads = B.model(parent, "Roads")
	-- North, south, east, west avenues from the plaza edge.
	local specs = {
		{ CFrame.new(0, 0.05, -130), Vector3.new(26, 0.2, 170) },
		{ CFrame.new(0, 0.05, 140), Vector3.new(26, 0.2, 190) },
		{ CFrame.new(130, 0.05, 0), Vector3.new(170, 0.2, 26) },
		{ CFrame.new(-130, 0.05, 0), Vector3.new(170, 0.2, 26) },
	}
	for _, spec in specs do
		local cf, size = spec[1], spec[2]
		B.part(roads, { Name = "Road", Size = size, CFrame = cf, Color = ASPHALT, Material = Enum.Material.Asphalt })
		-- Sidewalks
		local alongZ = size.Z > size.X
		local offset = if alongZ then Vector3.new(17, 0.15, 0) else Vector3.new(0, 0.15, 17)
		local walkSize = if alongZ then Vector3.new(8, 0.5, size.Z) else Vector3.new(size.X, 0.5, 8)
		B.part(roads, { Name = "Sidewalk", Size = walkSize, CFrame = cf + offset, Color = SIDEWALK, Material = Enum.Material.Concrete })
		B.part(roads, { Name = "Sidewalk", Size = walkSize, CFrame = cf - offset, Color = SIDEWALK, Material = Enum.Material.Concrete })
		-- Gold centre line
		local lineSize = if alongZ then Vector3.new(0.6, 0.22, size.Z - 6) else Vector3.new(size.X - 6, 0.22, 0.6)
		B.part(roads, { Name = "Line", Size = lineSize, CFrame = cf + Vector3.new(0, 0.02, 0), Color = GOLD, Material = Enum.Material.Neon, CastShadow = false })
		-- Lamps and trees along the sidewalks
		local length = if alongZ then size.Z else size.X
		local steps = math.floor(length / 34)
		for i = 0, steps do
			local t = -length / 2 + 12 + i * 34
			if t < length / 2 - 6 then
				local along = if alongZ then Vector3.new(0, 0, t) else Vector3.new(t, 0, 0)
				local base = cf.Position + along
				local side = if alongZ then Vector3.new(19.5, 0.4, 0) else Vector3.new(0, 0.4, 19.5)
				lamp(roads, base + side)
				lamp(roads, base - side)
				local treeSide = if alongZ then Vector3.new(27, 0, 0) else Vector3.new(0, 0, 27)
				tree(roads, base + treeSide + (if alongZ then Vector3.new(0, 0, 17) else Vector3.new(17, 0, 0)), 0.9)
				tree(roads, base - treeSide + (if alongZ then Vector3.new(0, 0, 17) else Vector3.new(17, 0, 0)), 0.9)
			end
		end
	end
end

local function buildPlaza(parent: Instance)
	local plaza = B.model(parent, "SpawnPlaza")
	B.part(plaza, {
		Name = "Floor",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.6, 92, 92),
		CFrame = CFrame.new(0, 0.2, 0) * VERTICAL,
		Color = MARBLE,
		Material = Enum.Material.Marble,
	})
	B.part(plaza, {
		Name = "GoldRing",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.62, 94, 94),
		CFrame = CFrame.new(0, 0.19, 0) * VERTICAL,
		Color = GOLD,
		Material = Enum.Material.Foil,
	})

	-- Fountain
	placeProp(plaza, "Fountain", CFrame.new(0, 0.5, 0), 26, function()
		local fountain = B.model(plaza, "Fountain")
		B.part(fountain, { Name = "Basin", Shape = Enum.PartType.Cylinder, Size = Vector3.new(2.4, 26, 26), CFrame = CFrame.new(0, 1.6, 0) * VERTICAL, Color = MARBLE, Material = Enum.Material.Marble })
		B.part(fountain, { Name = "Water", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.4, 23, 23), CFrame = CFrame.new(0, 2.7, 0) * VERTICAL, Color = WATER, Material = Enum.Material.Glass, Transparency = 0.3, CanCollide = false, CastShadow = false })
		B.part(fountain, { Name = "Tier", Shape = Enum.PartType.Cylinder, Size = Vector3.new(5, 6, 6), CFrame = CFrame.new(0, 5, 0) * VERTICAL, Color = MARBLE, Material = Enum.Material.Marble })
		B.part(fountain, { Name = "Bowl", Shape = Enum.PartType.Cylinder, Size = Vector3.new(1, 12, 12), CFrame = CFrame.new(0, 7.8, 0) * VERTICAL, Color = GOLD, Material = Enum.Material.Foil })
		local coin = B.part(fountain, { Name = "GoldCoin", Shape = Enum.PartType.Cylinder, Size = Vector3.new(1.2, 8, 8), CFrame = CFrame.new(0, 13, 0) * CFrame.Angles(0, math.rad(90), 0), Color = GOLD, Material = Enum.Material.Foil })
		for _, side in { CFrame.new(0, 13, -0.66), CFrame.new(0, 13, 0.66) * CFrame.Angles(0, math.pi, 0) } do
			B.sign(fountain, side, Vector3.new(5, 5, 0.05), "$", { background = GOLD, textColor = DEEP_GOLD, pixelsPerStud = 40 }).Transparency = 1
		end
		B.light(coin, GOLD, 24, 2)
		local spray = Instance.new("ParticleEmitter")
		spray.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		spray.Color = ColorSequence.new(Color3.fromRGB(190, 230, 255))
		spray.Size = NumberSequence.new(0.5, 0)
		spray.Lifetime = NumberRange.new(1, 1.5)
		spray.Rate = 18
		spray.Speed = NumberRange.new(6, 9)
		spray.SpreadAngle = Vector2.new(20, 20)
		spray.Acceleration = Vector3.new(0, -12, 0)
		spray.EmissionDirection = Enum.NormalId.Top
		spray.Parent = fountain:FindFirstChild("Bowl")
		return fountain
	end)

	-- Spawns around the fountain
	for i = 0, 3 do
		local angle = math.rad(45 + i * 90)
		local spawn = Instance.new("SpawnLocation")
		spawn.Name = "Spawn"
		spawn.Anchored = true
		spawn.Size = Vector3.new(8, 0.4, 8)
		spawn.CFrame = CFrame.new(math.cos(angle) * 30, 0.6, math.sin(angle) * 30)
		spawn.Color = GOLD
		spawn.Material = Enum.Material.Foil
		spawn.Duration = 0
		spawn.Neutral = true
		spawn.TopSurface = Enum.SurfaceType.Smooth
		spawn.Parent = plaza
	end

	-- Benches and planters
	for i = 0, 7 do
		local angle = math.rad(i * 45 + 22.5)
		local pos = Vector3.new(math.cos(angle) * 40, 0.5, math.sin(angle) * 40)
		local facing = CFrame.lookAt(pos, Vector3.new(0, 0.5, 0))
		B.part(plaza, { Name = "Planter", Size = Vector3.new(7, 2, 3), CFrame = facing * CFrame.new(0, 1, 0), Color = DARK, Material = Enum.Material.Marble })
		B.part(plaza, { Name = "Hedge", Size = Vector3.new(6.4, 1.6, 2.4), CFrame = facing * CFrame.new(0, 2.6, 0), Color = LEAF, Material = Enum.Material.Grass })
	end

	-- Welcome arch over the south avenue
	local arch = B.model(plaza, "WelcomeArch")
	for _, x in { -16, 16 } do
		B.part(arch, { Name = "Pillar", Size = Vector3.new(4, 26, 4), CFrame = CFrame.new(x, 13, 52), Color = MARBLE, Material = Enum.Material.Marble })
		B.part(arch, { Name = "Cap", Size = Vector3.new(5, 1.5, 5), CFrame = CFrame.new(x, 26.5, 52), Color = GOLD, Material = Enum.Material.Foil })
	end
	B.part(arch, { Name = "Beam", Size = Vector3.new(38, 4, 4), CFrame = CFrame.new(0, 29, 52), Color = GOLD, Material = Enum.Material.Foil })
	B.sign(arch, CFrame.new(0, 29, 49.9), Vector3.new(34, 3.4, 0.2), GameConfig.GameName, { background = DARK })
	B.sign(arch, CFrame.new(0, 29, 54.1) * CFrame.Angles(0, math.rad(180), 0), Vector3.new(34, 3.4, 0.2), GameConfig.GameName, { background = DARK })

	-- Plaza stations
	local function facingCenter(x: number, z: number): CFrame
		return CFrame.lookAt(Vector3.new(x, 0.5, z), Vector3.new(0, 0.5, 0))
	end
	station(plaza, "QuestBoard", facingCenter(-26, -26), Color3.fromRGB(120, 220, 255), "QUESTS", "Quests", "View Quests")
	station(plaza, "ShopKiosk", facingCenter(26, -26), Color3.fromRGB(120, 255, 160), "SHOP", "Shop", "Open Shop")
	station(plaza, "IndexPedestal", facingCenter(-26, 26), Color3.fromRGB(255, 160, 255), "AURA INDEX", "Inventory", "Open Index")
	station(plaza, "TradeBooth", facingCenter(26, 26), Color3.fromRGB(255, 200, 120), "TRADING", "Trade", "Trade")
end

local function buildBank(parent: Instance)
	-- Golden bank at the north end with a walk-in vault room.
	local bank = B.model(parent, "GoldenBank")
	local origin = CFrame.new(0, 0, -250)
	local width, depth, height = 96, 70, 34

	-- Steps
	for i = 0, 3 do
		B.part(bank, { Name = "Step", Size = Vector3.new(width + 10 - i * 2, 1, 14 - i * 3), CFrame = origin * CFrame.new(0, 0.5 + i, depth / 2 + 7 - i * 1.5), Color = MARBLE, Material = Enum.Material.Marble })
	end
	B.part(bank, { Name = "Floor", Size = Vector3.new(width, 4, depth), CFrame = origin * CFrame.new(0, 2, 0), Color = Color3.fromRGB(245, 240, 230), Material = Enum.Material.Marble })

	local wallColor = Color3.fromRGB(232, 200, 120)
	local function wall(name: string, size: Vector3, offset: CFrame)
		B.part(bank, { Name = name, Size = size, CFrame = origin * offset, Color = wallColor, Material = Enum.Material.Sandstone })
	end
	local floorTop = 4
	wall("BackWall", Vector3.new(width, height, 2), CFrame.new(0, floorTop + height / 2, -depth / 2 + 1))
	wall("LeftWall", Vector3.new(2, height, depth), CFrame.new(-width / 2 + 1, floorTop + height / 2, 0))
	wall("RightWall", Vector3.new(2, height, depth), CFrame.new(width / 2 - 1, floorTop + height / 2, 0))
	-- Front wall with a 20 x 18 doorway
	local doorW, doorH = 20, 18
	local sideW = (width - doorW) / 2
	wall("FrontLeft", Vector3.new(sideW, height, 2), CFrame.new(-(doorW / 2 + sideW / 2), floorTop + height / 2, depth / 2 - 1))
	wall("FrontRight", Vector3.new(sideW, height, 2), CFrame.new(doorW / 2 + sideW / 2, floorTop + height / 2, depth / 2 - 1))
	wall("FrontTop", Vector3.new(doorW, height - doorH, 2), CFrame.new(0, floorTop + doorH + (height - doorH) / 2, depth / 2 - 1))
	B.part(bank, { Name = "Roof", Size = Vector3.new(width + 6, 3, depth + 6), CFrame = origin * CFrame.new(0, floorTop + height + 1.5, 0), Color = GOLD, Material = Enum.Material.Foil })

	-- Columns and pediment
	for i = 0, 7 do
		local x = -width / 2 + 6 + i * ((width - 12) / 7)
		if math.abs(x) > doorW / 2 + 2 then
			B.part(bank, { Name = "Column", Shape = Enum.PartType.Cylinder, Size = Vector3.new(height, 4, 4), CFrame = origin * CFrame.new(x, floorTop + height / 2, depth / 2 + 4) * VERTICAL, Color = MARBLE, Material = Enum.Material.Marble })
		end
	end
	B.part(bank, { Name = "Portico", Size = Vector3.new(width + 6, 3, 10), CFrame = origin * CFrame.new(0, floorTop + height + 1.5, depth / 2 + 4), Color = GOLD, Material = Enum.Material.Foil })
	local pedW = (width + 6) / 2
	B.part(bank, { Name = "PedimentL", Size = Vector3.new(2, 12, pedW), CFrame = origin * CFrame.new(-pedW / 2, floorTop + height + 9, depth / 2 + 6) * CFrame.Angles(0, math.rad(90), 0), Color = GOLD, Material = Enum.Material.Foil }, "WedgePart")
	B.part(bank, { Name = "PedimentR", Size = Vector3.new(2, 12, pedW), CFrame = origin * CFrame.new(pedW / 2, floorTop + height + 9, depth / 2 + 6) * CFrame.Angles(0, math.rad(-90), 0), Color = GOLD, Material = Enum.Material.Foil }, "WedgePart")
	B.sign(bank, origin * CFrame.new(0, floorTop + doorH + 7, depth / 2 + 0.2) * CFrame.Angles(0, math.pi, 0), Vector3.new(40, 6, 0.3), "GOLDEN BANK", { background = DARK })

	-- Interior: lobby lights + vault room
	for _, x in { -30, 0, 30 } do
		local chandelier = B.part(bank, { Name = "Chandelier", Shape = Enum.PartType.Ball, Size = Vector3.new(4, 4, 4), CFrame = origin * CFrame.new(x, floorTop + height - 6, 8), Color = Color3.fromRGB(255, 230, 170), Material = Enum.Material.Neon, CastShadow = false })
		B.light(chandelier, Color3.fromRGB(255, 220, 160), 40, 1.5)
	end
	-- Lobby carpet
	B.part(bank, { Name = "Carpet", Size = Vector3.new(14, 0.2, depth - 20), CFrame = origin * CFrame.new(0, floorTop + 0.1, 8), Color = Color3.fromRGB(150, 20, 40), Material = Enum.Material.Fabric })

	local vault = B.model(bank, "VaultRoom")
	local vaultOrigin = origin * CFrame.new(0, floorTop, -depth / 2 + 14)
	B.part(vault, { Name = "VaultFloor", Size = Vector3.new(60, 0.3, 24), CFrame = vaultOrigin * CFrame.new(0, 0.15, 0), Color = Color3.fromRGB(60, 60, 70), Material = Enum.Material.DiamondPlate })
	-- Giant open vault door leaning against the left side
	placeProp(vault, "VaultDoor", vaultOrigin * CFrame.new(-22, 0, 4) * CFrame.Angles(0, math.rad(60), 0), 22, function()
		local door = B.model(vault, "VaultDoor")
		B.part(door, { Name = "Door", Shape = Enum.PartType.Cylinder, Size = Vector3.new(3, 22, 22), CFrame = vaultOrigin * CFrame.new(-22, 11, 4) * CFrame.Angles(0, math.rad(60 + 90), 0), Color = Color3.fromRGB(150, 155, 165), Material = Enum.Material.DiamondPlate })
		B.part(door, { Name = "Wheel", Shape = Enum.PartType.Cylinder, Size = Vector3.new(4, 8, 8), CFrame = vaultOrigin * CFrame.new(-22, 11, 4) * CFrame.Angles(0, math.rad(60 + 90), 0), Color = GOLD, Material = Enum.Material.Foil })
		return door
	end)
	for i, x in { -8, 2, 12, 22 } do
		goldBars(vault, vaultOrigin * CFrame.new(x, 0.3, -6 + (i % 2) * 3))
	end
	station(vault, "DailyRewards", vaultOrigin * CFrame.new(-2, 0.3, 6) * CFrame.Angles(0, math.pi, 0), GOLD, "DAILY REWARDS", "Daily", "Claim Daily")
	station(vault, "CodesTerminal", vaultOrigin * CFrame.new(16, 0.3, 6) * CFrame.Angles(0, math.pi, 0), NEON_CYAN, "CODES", "Codes", "Redeem Codes")
end

local function buildCasinoStrip(parent: Instance)
	-- Casino-inspired neon district (visual only, no gambling) with the upgrade machines.
	local strip = B.model(parent, "NeonStrip")
	local origin = CFrame.new(250, 0, 0)
	B.part(strip, { Name = "Plaza", Size = Vector3.new(110, 0.4, 120), CFrame = origin * CFrame.new(0, 0.2, 0), Color = Color3.fromRGB(30, 22, 40), Material = Enum.Material.Slate })
	-- Main building
	B.part(strip, { Name = "Building", Size = Vector3.new(30, 46, 90), CFrame = origin * CFrame.new(42, 23, 0), Color = Color3.fromRGB(40, 30, 55), Material = Enum.Material.SmoothPlastic })
	B.part(strip, { Name = "Trim", Size = Vector3.new(30.4, 1.2, 90.4), CFrame = origin * CFrame.new(42, 46, 0), Color = NEON_PINK, Material = Enum.Material.Neon, CastShadow = false })
	B.sign(strip, origin * CFrame.new(26.8, 34, 0) * CFrame.Angles(0, math.rad(90), 0), Vector3.new(60, 12, 0.4), "LUCKY STRIP", { textColor = NEON_PINK, background = Color3.fromRGB(20, 10, 30), brightness = 3 })
	for i = -2, 2 do
		B.part(strip, { Name = "NeonBar", Size = Vector3.new(0.6, 18, 1), CFrame = origin * CFrame.new(26.9, 12, i * 16), Color = if i % 2 == 0 then NEON_CYAN else NEON_PINK, Material = Enum.Material.Neon, CastShadow = false })
	end

	-- Giant dice (decorative)
	local function die(cframe: CFrame, pips: { Vector2 })
		placeProp(strip, "Dice", cframe, 10, function()
			local model = B.model(strip, "Dice")
			B.part(model, { Name = "Cube", Size = Vector3.new(10, 10, 10), CFrame = cframe * CFrame.new(0, 5, 0), Color = Color3.fromRGB(245, 245, 245), Material = Enum.Material.SmoothPlastic })
			for _, pip in pips do
				B.part(model, { Name = "Pip", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.3, 1.8, 1.8), CFrame = cframe * CFrame.new(pip.X * 2.6, 5 + pip.Y * 2.6, -5.05) * CFrame.Angles(0, math.rad(90), 0), Color = Color3.fromRGB(200, 20, 40), Material = Enum.Material.SmoothPlastic, CastShadow = false })
			end
			return model
		end)
	end
	die(origin * CFrame.new(-40, 0.4, -46) * CFrame.Angles(0, math.rad(20), 0), { Vector2.new(-1, 1), Vector2.new(0, 0), Vector2.new(1, -1) })
	die(origin * CFrame.new(-26, 0.4, -50) * CFrame.Angles(0, math.rad(-15), 0), { Vector2.new(-1, 1), Vector2.new(1, 1), Vector2.new(-1, -1), Vector2.new(1, -1), Vector2.new(0, 0) })

	-- Slot-machine styled upgrade terminals
	local colors = { GOLD, NEON_CYAN, NEON_PINK }
	for i = -1, 1 do
		local cf = origin * CFrame.new(14, 0.4, i * 20) * CFrame.Angles(0, math.rad(90), 0)
		local machine = placeProp(strip, "SlotMachine", cf, 8, function()
			local model = B.model(strip, "SlotMachine")
			B.part(model, { Name = "Body", Size = Vector3.new(8, 12, 6), CFrame = cf * CFrame.new(0, 6, 0), Color = Color3.fromRGB(150, 20, 40), Material = Enum.Material.SmoothPlastic })
			B.part(model, { Name = "Screen", Size = Vector3.new(6, 4, 0.4), CFrame = cf * CFrame.new(0, 8, -3.1), Color = colors[i + 2], Material = Enum.Material.Neon, CastShadow = false })
			B.part(model, { Name = "Top", Size = Vector3.new(8.4, 1.4, 6.4), CFrame = cf * CFrame.new(0, 12.6, 0), Color = GOLD, Material = Enum.Material.Foil })
			B.part(model, { Name = "Lever", Shape = Enum.PartType.Cylinder, Size = Vector3.new(5, 0.5, 0.5), CFrame = cf * CFrame.new(4.4, 8, 0) * VERTICAL, Color = Color3.fromRGB(200, 200, 210), Material = Enum.Material.Metal })
			B.part(model, { Name = "Knob", Shape = Enum.PartType.Ball, Size = Vector3.new(1.4, 1.4, 1.4), CFrame = cf * CFrame.new(4.4, 10.6, 0), Color = Color3.fromRGB(230, 30, 50), Material = Enum.Material.SmoothPlastic })
			return model
		end)
		local promptHost = B.part(strip, { Name = "UpgradeTrigger", Size = Vector3.new(8, 8, 8), CFrame = cf * CFrame.new(0, 4, -5), Transparency = 1, CanCollide = false, CastShadow = false })
		B.prompt(promptHost, "Upgrade", "Upgrade Machine", "Upgrades")
		local _ = machine
	end
	B.sign(strip, origin * CFrame.new(-2, 18, 0) * CFrame.Angles(0, math.rad(90), 0), Vector3.new(30, 5, 0.4), "UPGRADES", { textColor = GOLD, background = DARK })

	-- Neon arch entrance from the east avenue
	for _, z in { -14, 14 } do
		B.part(strip, { Name = "ArchPost", Size = Vector3.new(2, 22, 2), CFrame = origin * CFrame.new(-54, 11, z), Color = NEON_CYAN, Material = Enum.Material.Neon, CastShadow = false })
	end
	B.part(strip, { Name = "ArchTop", Size = Vector3.new(2, 2, 30), CFrame = origin * CFrame.new(-54, 22, 0), Color = NEON_PINK, Material = Enum.Material.Neon, CastShadow = false })
	local glow = B.part(strip, { Name = "Glow", Size = Vector3.new(1, 1, 1), CFrame = origin * CFrame.new(0, 14, 0), Transparency = 1, CanCollide = false, CastShadow = false })
	B.light(glow, NEON_PINK, 60, 1.2)
end

local function buildMansion(parent: Instance)
	local estate = B.model(parent, "LuxuryMansion")
	local origin = CFrame.new(-250, 0, 0)
	B.part(estate, { Name = "Lawn", Size = Vector3.new(120, 0.4, 130), CFrame = origin * CFrame.new(0, 0.2, 0), Color = Color3.fromRGB(100, 175, 90), Material = Enum.Material.Grass })
	B.part(estate, { Name = "Driveway", Size = Vector3.new(60, 0.5, 14), CFrame = origin * CFrame.new(30, 0.25, 0), Color = SIDEWALK, Material = Enum.Material.Pavement })

	local white = Color3.fromRGB(245, 245, 240)
	local house = B.model(estate, "Mansion")
	local base = origin * CFrame.new(-28, 0, 0)
	B.part(house, { Name = "Foundation", Size = Vector3.new(44, 2, 80), CFrame = base * CFrame.new(0, 1, 0), Color = MARBLE, Material = Enum.Material.Marble })
	B.part(house, { Name = "Floor1", Size = Vector3.new(40, 16, 76), CFrame = base * CFrame.new(0, 10, 0), Color = white, Material = Enum.Material.SmoothPlastic })
	B.part(house, { Name = "Floor2", Size = Vector3.new(36, 14, 60), CFrame = base * CFrame.new(-2, 25, 0), Color = white, Material = Enum.Material.SmoothPlastic })
	B.part(house, { Name = "GoldBand", Size = Vector3.new(40.4, 1, 76.4), CFrame = base * CFrame.new(0, 18, 0), Color = GOLD, Material = Enum.Material.Foil })
	B.part(house, { Name = "Roof", Size = Vector3.new(40, 2, 64), CFrame = base * CFrame.new(-2, 33, 0), Color = DARK, Material = Enum.Material.Slate })
	for row = 0, 1 do
		for i = -3, 3 do
			B.part(house, { Name = "Window", Size = Vector3.new(0.4, 6, 5), CFrame = base * CFrame.new(20.1 - row * 4, 10 + row * 15, i * 9), Color = Color3.fromRGB(150, 210, 255), Material = Enum.Material.Glass, Transparency = 0.2, CastShadow = false })
		end
	end
	B.part(house, { Name = "Door", Size = Vector3.new(0.6, 10, 8), CFrame = base * CFrame.new(20.2, 7, 0), Color = Color3.fromRGB(110, 70, 40), Material = Enum.Material.Wood })
	for _, z in { -8, 8 } do
		B.part(house, { Name = "Column", Shape = Enum.PartType.Cylinder, Size = Vector3.new(16, 2, 2), CFrame = base * CFrame.new(25, 10, z) * VERTICAL, Color = MARBLE, Material = Enum.Material.Marble })
	end
	B.part(house, { Name = "Balcony", Size = Vector3.new(8, 1, 22), CFrame = base * CFrame.new(25, 18.5, 0), Color = MARBLE, Material = Enum.Material.Marble })

	-- Pool with palms
	B.part(estate, { Name = "PoolEdge", Size = Vector3.new(26, 1, 40), CFrame = origin * CFrame.new(18, 0.5, -38), Color = MARBLE, Material = Enum.Material.Marble })
	B.part(estate, { Name = "PoolWater", Size = Vector3.new(22, 1.05, 36), CFrame = origin * CFrame.new(18, 0.55, -38), Color = WATER, Material = Enum.Material.Glass, Transparency = 0.25, CastShadow = false })
	for _, offset in { Vector3.new(36, 0.4, -54), Vector3.new(36, 0.4, -22), Vector3.new(0, 0.4, -58), Vector3.new(-50, 0.4, 50), Vector3.new(40, 0.4, 50) } do
		palm(estate, origin.Position + offset)
	end
	-- Hedges
	for _, z in { -48, -24, 24, 48 } do
		B.part(estate, { Name = "Hedge", Size = Vector3.new(4, 3, 14), CFrame = origin * CFrame.new(56, 1.5, z), Color = LEAF, Material = Enum.Material.Grass })
	end

	-- Rebirth shrine in the front garden
	local shrine = station(estate, "RebirthStation", origin * CFrame.new(30, 0.4, 38) * CFrame.Angles(0, math.rad(-90), 0), PURPLE, "REBIRTH", "Rebirth", "Rebirth")
	local ring = B.part(shrine, { Name = "Ring", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.4, 16, 16), CFrame = origin * CFrame.new(30, 0.7, 38) * VERTICAL, Color = PURPLE, Material = Enum.Material.Neon, CastShadow = false })
	local _ = ring
end

local function buildLeaderboardPlaza(parent: Instance)
	local plaza = B.model(parent, "LeaderboardPlaza")
	local origin = CFrame.new(0, 0, 260)
	B.part(plaza, { Name = "Floor", Size = Vector3.new(120, 0.4, 70), CFrame = origin * CFrame.new(0, 0.2, 0), Color = MARBLE, Material = Enum.Material.Marble })

	local function board(name: string, cframe: CFrame, title: string)
		local frameModel = B.model(plaza, name)
		B.part(frameModel, { Name = "Frame", Size = Vector3.new(30, 36, 1.6), CFrame = cframe * CFrame.new(0, 20, 0.6), Color = GOLD, Material = Enum.Material.Foil })
		for _, x in { -13, 13 } do
			B.part(frameModel, { Name = "Leg", Size = Vector3.new(2, 4, 2), CFrame = cframe * CFrame.new(x, 2, 0.6), Color = DARK, Material = Enum.Material.Metal })
		end
		local screen = B.part(frameModel, { Name = "Screen", Size = Vector3.new(28, 34, 0.4), CFrame = cframe * CFrame.new(0, 20, 0), Color = DARK, Material = Enum.Material.SmoothPlastic, CastShadow = false })
		local gui = Instance.new("SurfaceGui")
		gui.Face = Enum.NormalId.Front
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = 20
		gui.LightInfluence = 0
		gui.Parent = screen
		local header = Instance.new("TextLabel")
		header.Size = UDim2.new(1, 0, 0.1, 0)
		header.BackgroundColor3 = DEEP_GOLD
		header.TextColor3 = Color3.new(1, 1, 1)
		header.Font = Enum.Font.GothamBlack
		header.TextScaled = true
		header.Text = title
		header.Parent = gui
		local list = Instance.new("Frame")
		list.Name = "List"
		list.Size = UDim2.new(1, -20, 0.88, 0)
		list.Position = UDim2.new(0, 10, 0.11, 0)
		list.BackgroundTransparency = 1
		list.Parent = gui
		local layout = Instance.new("UIListLayout")
		layout.Padding = UDim.new(0.006, 0)
		layout.SortOrder = Enum.SortOrder.LayoutOrder
		layout.Parent = list
		boards[name] = list
	end
	board("ServerBoard", origin * CFrame.new(-24, 0.4, 14), "RICHEST IN SERVER")
	board("GlobalBoard", origin * CFrame.new(24, 0.4, 14), "ALL-TIME RICHEST")

	-- Podium
	local heights = { 6, 4, 2.5 }
	local xs = { 0, -9, 9 }
	local podiumColors = { GOLD, Color3.fromRGB(200, 200, 210), Color3.fromRGB(205, 127, 50) }
	for i = 1, 3 do
		B.part(plaza, { Name = "Podium" .. i, Size = Vector3.new(8, heights[i], 8), CFrame = origin * CFrame.new(xs[i], heights[i] / 2 + 0.4, -6), Color = podiumColors[i], Material = Enum.Material.Foil })
	end
	station(plaza, "LeaderboardKiosk", origin * CFrame.new(0, 0.4, 14), GOLD, "LEADERBOARDS", "Leaderboard", "View")
end

local teleportDebounce: { [Player]: number } = {}

local function teleport(player: Player, position: Vector3)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if root and character then
		character:PivotTo(CFrame.new(position + Vector3.new(0, 4, 0)))
	end
end

local function canTeleport(player: Player): boolean
	local now = os.clock()
	if teleportDebounce[player] and now - teleportDebounce[player] < 2 then
		return false
	end
	teleportDebounce[player] = now
	return true
end

local PORTAL_HALL = CFrame.new(0, 0, 330)

local function buildPortal(parent: Instance, cframe: CFrame, zone: GameConfig.Zone)
	local portal = B.model(parent, "Portal_" .. zone.id)
	local function frame()
		local model = B.model(portal, "Frame")
		for _, x in { -7, 7 } do
			B.part(model, { Name = "Post", Size = Vector3.new(2.4, 20, 2.4), CFrame = cframe * CFrame.new(x, 10, 0), Color = GOLD, Material = Enum.Material.Foil })
		end
		B.part(model, { Name = "Top", Size = Vector3.new(17, 2.4, 2.4), CFrame = cframe * CFrame.new(0, 21, 0), Color = GOLD, Material = Enum.Material.Foil })
		return model
	end
	placeProp(portal, "PortalArch", cframe, 17, frame)
	local surface = B.part(portal, { Name = "Surface", Size = Vector3.new(11.6, 18, 0.6), CFrame = cframe * CFrame.new(0, 10, 0), Color = zone.color, Material = Enum.Material.Neon, Transparency = 0.25, CanCollide = false, CastShadow = false })
	B.light(surface, zone.color, 18, 2)
	local reqText = if zone.requiredRebirths > 0 then ` · {zone.requiredRebirths} Rebirth` else ""
	B.sign(portal, cframe * CFrame.new(0, 25, 0) * CFrame.Angles(0, math.rad(180), 0), Vector3.new(18, 5, 0.3), `{zone.name}\n${NumberFormat.short(zone.cost)}{reqText}`, { textColor = zone.color, background = DARK })
	B.prompt(surface, "Unlock / Info", zone.name, "Zones")
	surface.Touched:Connect(function(hit)
		local player = Players:GetPlayerFromCharacter(hit.Parent)
		if not player or not canTeleport(player) then
			return
		end
		local profile = Registry.DataService.get(player)
		if profile and profile.zones[zone.id] then
			teleport(player, zone.center + Vector3.new(0, 1, 50))
		else
			Registry.DataService.notify(player, `{zone.name} is locked. Open the Zones menu to unlock it.`, "warning")
		end
	end)
end

local function buildZoneIsland(parent: Instance, zone: GameConfig.Zone)
	local island = B.model(parent, "Zone_" .. zone.id)
	local center = CFrame.new(zone.center)
	B.part(island, { Name = "Island", Shape = Enum.PartType.Cylinder, Size = Vector3.new(6, zone.radius * 2, zone.radius * 2), CFrame = center * CFrame.new(0, -3, 0) * VERTICAL, Color = Color3.fromRGB(70, 65, 80), Material = Enum.Material.Slate })
	B.part(island, { Name = "Top", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.4, zone.radius * 2 - 6, zone.radius * 2 - 6), CFrame = center * CFrame.new(0, 0.2, 0) * VERTICAL, Color = MARBLE, Material = Enum.Material.Marble })
	B.part(island, { Name = "Rim", Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.6, zone.radius * 2 - 2, zone.radius * 2 - 2), CFrame = center * CFrame.new(0, 0.1, 0) * VERTICAL, Color = zone.color, Material = Enum.Material.Neon, CastShadow = false })
	-- Invisible fence
	for i = 0, 11 do
		local angle = math.rad(i * 30)
		local pos = zone.center + Vector3.new(math.cos(angle), 0, math.sin(angle)) * (zone.radius - 1)
		B.part(island, { Name = "Fence", Size = Vector3.new(2, 40, zone.radius * 0.6), CFrame = CFrame.lookAt(pos + Vector3.new(0, 20, 0), zone.center + Vector3.new(0, 20, 0)) * CFrame.Angles(0, math.rad(90), 0), Transparency = 1, CastShadow = false })
	end
	-- Ring of pillars
	for i = 0, 7 do
		local angle = math.rad(i * 45)
		local pos = zone.center + Vector3.new(math.cos(angle), 0, math.sin(angle)) * (zone.radius - 14)
		B.part(island, { Name = "Pillar", Size = Vector3.new(4, 18, 4), CFrame = CFrame.new(pos + Vector3.new(0, 9, 0)), Color = MARBLE, Material = Enum.Material.Marble })
		local cap = B.part(island, { Name = "Flame", Shape = Enum.PartType.Ball, Size = Vector3.new(3.4, 3.4, 3.4), CFrame = CFrame.new(pos + Vector3.new(0, 19.8, 0)), Color = zone.color, Material = Enum.Material.Neon, CastShadow = false })
		if i % 2 == 0 then
			B.light(cap, zone.color, 26, 1.4)
		end
	end
	-- Monument
	B.part(island, { Name = "MonumentBase", Size = Vector3.new(14, 4, 14), CFrame = center * CFrame.new(0, 2, 0), Color = DARK, Material = Enum.Material.Marble })
	local gem = B.part(island, { Name = "Gem", Size = Vector3.new(7, 7, 7), CFrame = center * CFrame.new(0, 10, 0) * CFrame.Angles(math.rad(45), math.rad(45), 0), Color = zone.color, Material = Enum.Material.Neon, CastShadow = false })
	B.light(gem, zone.color, 40, 2)
	B.sign(island, center * CFrame.new(0, 20, 0), Vector3.new(26, 5, 0.3), `{zone.name}\n{zone.description}`, { textColor = zone.color, background = DARK, face = Enum.NormalId.Back })
	for i = 0, 5 do
		local angle = math.rad(i * 60 + 30)
		tree(island, zone.center + Vector3.new(math.cos(angle), 0, math.sin(angle)) * (zone.radius - 30), 1.1)
	end
	if zone.center.Y > 20 then
		-- Floating clouds for elevated zones
		for i = 0, 9 do
			local angle = math.rad(i * 36)
			B.part(island, { Name = "Cloud", Shape = Enum.PartType.Ball, Size = Vector3.new(26, 26, 26), CFrame = CFrame.new(zone.center + Vector3.new(math.cos(angle) * (zone.radius + 10), -14, math.sin(angle) * (zone.radius + 10))), Color = Color3.new(1, 1, 1), Material = Enum.Material.SmoothPlastic, Transparency = 0.2, CanCollide = false, CastShadow = false })
		end
	end

	-- Return portal
	local back = B.part(island, { Name = "ReturnPortal", Size = Vector3.new(10, 16, 0.6), CFrame = center * CFrame.new(0, 8.4, zone.radius - 18), Color = GOLD, Material = Enum.Material.Neon, Transparency = 0.25, CanCollide = false, CastShadow = false })
	B.sign(island, center * CFrame.new(0, 19, zone.radius - 18), Vector3.new(14, 3, 0.3), "RETURN TO CITY", { background = DARK })
	back.Touched:Connect(function(hit)
		local player = Players:GetPlayerFromCharacter(hit.Parent)
		if player and canTeleport(player) then
			teleport(player, PORTAL_HALL.Position + Vector3.new(0, 1, -24))
		end
	end)
end

local function buildPortalHall(parent: Instance)
	local hall = B.model(parent, "PortalHall")
	B.part(hall, { Name = "Floor", Size = Vector3.new(150, 0.4, 40), CFrame = PORTAL_HALL * CFrame.new(0, 0.2, 0), Color = DARK, Material = Enum.Material.Marble })
	B.sign(hall, PORTAL_HALL * CFrame.new(0, 34, 10), Vector3.new(50, 6, 0.4), "WEALTH ZONES", { background = DARK })
	local zonesToPlace = {}
	for _, zone in GameConfig.Zones do
		if zone.radius > 0 then
			table.insert(zonesToPlace, zone)
		end
	end
	local spacing = 30
	for index, zone in zonesToPlace do
		local x = (index - (#zonesToPlace + 1) / 2) * spacing
		buildPortal(hall, PORTAL_HALL * CFrame.new(x, 0.4, 8) * CFrame.Angles(0, math.rad(180), 0), zone)
		buildZoneIsland(parent, zone)
	end
end

local function setupLighting()
	Lighting.ClockTime = 17.4
	Lighting.GeographicLatitude = 30
	Lighting.Brightness = 2.2
	Lighting.Ambient = Color3.fromRGB(70, 60, 60)
	Lighting.OutdoorAmbient = Color3.fromRGB(140, 125, 115)
	Lighting.EnvironmentDiffuseScale = 0.6
	Lighting.EnvironmentSpecularScale = 0.8
	Lighting.GlobalShadows = true
	pcall(function()
		Lighting.Technology = Enum.Technology.Future
	end)
	for _, child in Lighting:GetChildren() do
		if child:IsA("PostEffect") or child:IsA("Atmosphere") then
			child:Destroy()
		end
	end
	local atmosphere = Instance.new("Atmosphere")
	atmosphere.Density = 0.28
	atmosphere.Offset = 0.1
	atmosphere.Color = Color3.fromRGB(255, 215, 180)
	atmosphere.Decay = Color3.fromRGB(150, 110, 120)
	atmosphere.Glare = 0.4
	atmosphere.Haze = 1.2
	atmosphere.Parent = Lighting
	local bloom = Instance.new("BloomEffect")
	bloom.Intensity = 0.6
	bloom.Size = 28
	bloom.Threshold = 1.6
	bloom.Parent = Lighting
	local color = Instance.new("ColorCorrectionEffect")
	color.Saturation = 0.12
	color.Contrast = 0.06
	color.TintColor = Color3.fromRGB(255, 246, 236)
	color.Parent = Lighting
	local rays = Instance.new("SunRaysEffect")
	rays.Intensity = 0.06
	rays.Spread = 0.6
	rays.Parent = Lighting
end

------------------------------------------------------------------------------
-- Leaderboard boards
------------------------------------------------------------------------------

local function fillBoard(list: Frame, entries: { any })
	for _, child in list:GetChildren() do
		if child:IsA("TextLabel") then
			child:Destroy()
		end
	end
	for rank = 1, math.min(#entries, 10) do
		local entry = entries[rank]
		local row = Instance.new("TextLabel")
		row.Size = UDim2.new(1, 0, 0.094, 0)
		row.BackgroundColor3 = if rank % 2 == 0 then Color3.fromRGB(40, 36, 44) else Color3.fromRGB(32, 29, 36)
		row.BorderSizePixel = 0
		row.TextColor3 = if rank == 1 then GOLD elseif rank == 2 then Color3.fromRGB(220, 220, 230) elseif rank == 3 then Color3.fromRGB(215, 140, 70) else Color3.new(1, 1, 1)
		row.Font = Enum.Font.GothamBold
		row.TextScaled = true
		row.TextXAlignment = Enum.TextXAlignment.Left
		row.Text = `  #{rank}  {entry.name}  —  ${NumberFormat.short(entry.value)}`
		row.LayoutOrder = rank
		row.Parent = list
	end
	if #entries == 0 then
		local row = Instance.new("TextLabel")
		row.Size = UDim2.new(1, 0, 0.1, 0)
		row.BackgroundTransparency = 1
		row.TextColor3 = Color3.fromRGB(180, 180, 180)
		row.Font = Enum.Font.Gotham
		row.TextScaled = true
		row.Text = "Loading..."
		row.Parent = list
	end
end

function MapService.updateLeaderboardBoards(payload: { server: { any }, global: { any } })
	if boards.ServerBoard then
		fillBoard(boards.ServerBoard, payload.server)
	end
	if boards.GlobalBoard then
		fillBoard(boards.GlobalBoard, payload.global)
	end
end

-- Instant travel for unlocked zones (used by the Zones menu).
local function travel(player: Player, zoneId: any)
	if type(zoneId) ~= "string" then
		return { ok = false, message = "Invalid zone" }
	end
	local zone = GameConfig.ZoneById[zoneId]
	local profile = Registry.DataService.get(player)
	if not zone or not profile then
		return { ok = false, message = "Invalid zone" }
	end
	if not profile.zones[zoneId] then
		return { ok = false, message = "Unlock this zone first" }
	end
	if not canTeleport(player) then
		return { ok = false, message = "Slow down!" }
	end
	if zone.radius == 0 then
		teleport(player, Vector3.new(0, 1, 30))
	else
		teleport(player, zone.center + Vector3.new(0, 1, 50))
	end
	return { ok = true, message = "Welcome to " .. zone.name }
end

function MapService.init()
	setupLighting()
	Registry.RequestService.register("TravelZone", travel, 1)
	local existing = workspace:FindFirstChild("Map")
	if existing and workspace:GetAttribute("KeepCustomMap") then
		map = existing :: Model
		return
	end
	if existing then
		existing:Destroy()
	end
	local baseplate = workspace:FindFirstChild("Baseplate")
	if baseplate then
		baseplate:Destroy()
	end
	for _, child in workspace:GetChildren() do
		if child:IsA("SpawnLocation") then
			child:Destroy()
		end
	end

	map = Instance.new("Model")
	map.Name = "Map"
	buildGround(map)
	buildRoads(map)
	buildPlaza(map)
	buildBank(map)
	buildCasinoStrip(map)
	buildMansion(map)
	buildLeaderboardPlaza(map)
	buildPortalHall(map)
	map.Parent = workspace

	Players.PlayerRemoving:Connect(function(player)
		teleportDebounce[player] = nil
	end)
end

return MapService
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="29">
        <Properties>
          <string name="Name">Registry</string>
          <string name="Source"><![CDATA[--!strict
-- Shared table the bootstrap fills with every service, so services can call
-- each other at runtime without circular requires.
local Registry: { [string]: any } = {}
return Registry
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="30">
        <Properties>
          <string name="Name">Services</string>
        </Properties>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">AvatarService</string>
            <string name="Source"><![CDATA[-- Equipped wealth auras and the overhead wealth title.
-- Built from Roblox's built-in particle textures, so nothing needs uploading.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Rarities = require(Shared.Config.Rarities)
local Formulas = require(Shared.Modules.Formulas)

local Registry = require(script.Parent.Parent.Registry)

local SPARKLE = "rbxasset://textures/particles/sparkles_main.dds"
local FIRE = "rbxasset://textures/particles/fire_main.dds"

local AvatarService = {}

local function colorSequence(a: Color3, b: Color3): ColorSequence
	return ColorSequence.new({ ColorSequenceKeypoint.new(0, a), ColorSequenceKeypoint.new(1, b) })
end

local RAINBOW = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 120, 120)),
	ColorSequenceKeypoint.new(0.25, Color3.fromRGB(255, 230, 120)),
	ColorSequenceKeypoint.new(0.5, Color3.fromRGB(120, 255, 200)),
	ColorSequenceKeypoint.new(0.75, Color3.fromRGB(130, 170, 255)),
	ColorSequenceKeypoint.new(1, Color3.fromRGB(240, 140, 255)),
})

local function makeEmitter(parent: Instance, props: { [string]: any }): ParticleEmitter
	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture = SPARKLE
	emitter.LightEmission = 1
	emitter.LightInfluence = 0
	emitter.Lifetime = NumberRange.new(0.8, 1.4)
	emitter.Speed = NumberRange.new(1, 3)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.RotSpeed = NumberRange.new(-90, 90)
	emitter.Rotation = NumberRange.new(0, 360)
	for key, value in props do
		(emitter :: any)[key] = value
	end
	emitter.Parent = parent
	return emitter
end

local function buildAura(root: BasePart, auraId: string)
	local attachment = Instance.new("Attachment")
	attachment.Name = "WealthAura"

	if auraId == "VIP" then
		makeEmitter(attachment, {
			Color = colorSequence(Color3.fromRGB(255, 225, 120), Color3.fromRGB(255, 170, 30)),
			Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 0) }),
			Rate = 18,
		})
		makeEmitter(attachment, {
			Texture = FIRE,
			Color = colorSequence(Color3.fromRGB(255, 210, 80), Color3.fromRGB(255, 120, 20)),
			Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.2), NumberSequenceKeypoint.new(1, 0) }),
			Transparency = NumberSequence.new(0.6, 1),
			Acceleration = Vector3.new(0, 4, 0),
			Rate = 10,
		})
		attachment.Parent = root
		return
	end

	local rarity = Rarities.get(auraId)
	if not rarity then
		return
	end
	local strength = rarity.order / Rarities.count -- 0..1
	local color = if rarity.effect == "celestial" then RAINBOW else colorSequence(rarity.color, rarity.accent)

	makeEmitter(attachment, {
		Color = color,
		Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35 + strength * 0.6), NumberSequenceKeypoint.new(1, 0) }),
		Rate = math.floor(6 + strength * 24),
	})
	if rarity.order >= 6 then
		makeEmitter(attachment, {
			Texture = FIRE,
			Color = color,
			Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1 + strength), NumberSequenceKeypoint.new(1, 0) }),
			Transparency = NumberSequence.new(0.55, 1),
			Acceleration = Vector3.new(0, 5, 0),
			Speed = NumberRange.new(0.5, 1.5),
			Rate = math.floor(4 + strength * 10),
		})
	end
	if rarity.order >= 8 then
		local light = Instance.new("PointLight")
		light.Color = rarity.color
		light.Range = 10
		light.Brightness = 1.5
		light.Shadows = false
		light.Parent = attachment
	end
	if rarity.order >= 10 then
		makeEmitter(attachment, {
			Color = color,
			Size = NumberSequence.new(0.25),
			Speed = NumberRange.new(6, 9),
			Lifetime = NumberRange.new(0.4, 0.6),
			Drag = 4,
			Rate = 20,
		})
	end
	attachment.Parent = root
end

local function buildTag(head: BasePart, player: Player, profile: { [string]: any })
	local existing = head:FindFirstChild("WealthTag")
	if existing then
		existing:Destroy()
	end
	local best = Rarities.list[profile.bestOrder]
	local billboard = Instance.new("BillboardGui")
	billboard.Name = "WealthTag"
	billboard.Size = UDim2.fromOffset(220, 64)
	billboard.StudsOffset = Vector3.new(0, 2.6, 0)
	billboard.MaxDistance = 90
	billboard.LightInfluence = 0
	billboard.ResetOnSpawn = false

	local function label(text: string, y: number, height: number, color: Color3, font: Enum.Font)
		local textLabel = Instance.new("TextLabel")
		textLabel.BackgroundTransparency = 1
		textLabel.Size = UDim2.new(1, 0, 0, height)
		textLabel.Position = UDim2.fromOffset(0, y)
		textLabel.Font = font
		textLabel.Text = text
		textLabel.TextScaled = true
		textLabel.TextColor3 = color
		textLabel.TextStrokeTransparency = 0.4
		textLabel.Parent = billboard
	end

	local vip = Registry.MonetizationService.hasPass(player, "VIP")
	local titleColor = if best then best.color else Color3.fromRGB(220, 220, 220)
	label((if vip then "[VIP] " else "") .. player.DisplayName, 0, 22, Color3.new(1, 1, 1), Enum.Font.GothamBold)
	label(Formulas.wealthTitle(profile.lifetime), 22, 20, titleColor, Enum.Font.GothamBlack)
	if profile.rebirths > 0 then
		label(`Rebirth {profile.rebirths}`, 43, 16, Color3.fromRGB(255, 215, 90), Enum.Font.Gotham)
	end
	billboard.Parent = head
end

function AvatarService.refresh(player: Player)
	local profile = Registry.DataService.get(player)
	local character = player.Character
	if not profile or not character then
		return
	end
	local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local head = character:FindFirstChild("Head") :: BasePart?
	if root then
		local old = root:FindFirstChild("WealthAura")
		if old then
			old:Destroy()
		end
		local aura = profile.equippedAura
		if aura == "VIP" and not Registry.MonetizationService.hasPass(player, "VIP") then
			aura = ""
		end
		if aura ~= "" then
			buildAura(root, aura)
		end
	end
	if head then
		buildTag(head, player, profile)
	end
end

function AvatarService.init()
	local function hook(player: Player)
		player.CharacterAdded:Connect(function(character)
			character:WaitForChild("HumanoidRootPart", 10)
			character:WaitForChild("Head", 10)
			AvatarService.refresh(player)
		end)
		if player.Character then
			AvatarService.refresh(player)
		end
	end
	Players.PlayerAdded:Connect(hook)
	for _, player in Players:GetPlayers() do
		hook(player)
	end
	Registry.DataService.onLoaded(function(player)
		AvatarService.refresh(player)
	end)

	-- Keep titles current as lifetime earnings grow (cheap: only rebuild on change).
	local lastTitle: { [Player]: string } = {}
	task.spawn(function()
		while true do
			task.wait(5)
			for _, player in Players:GetPlayers() do
				local profile = Registry.DataService.get(player)
				if profile then
					local key = Formulas.wealthTitle(profile.lifetime) .. profile.rebirths .. profile.bestOrder
					if lastTitle[player] ~= key then
						lastTitle[player] = key
						AvatarService.refresh(player)
					end
				end
			end
			for player in lastTitle do
				if player.Parent == nil then
					lastTitle[player] = nil
				end
			end
		end
	end)
end

return AvatarService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">DataService</string>
            <string name="Source"><![CDATA[-- Persistent player data with session locking.
--
-- Record layout in the DataStore (key "u_<UserId>"):
--   { data = <profile>, lock = { job = JobId, time = os.time() }? }
--
-- Guarantees:
--  * A failed load never produces a default profile that could overwrite real
--    data: the player is kicked with a message instead (except in Studio when
--    API access is disabled, where a temporary, never-saved profile is used).
--  * Only the server holding the session lock may write. A save that finds
--    the lock owned by another server is aborted and the player is kicked.
--  * Saves are serialised per player, retried with backoff, and flushed on
--    PlayerRemoving and BindToClose.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local Remotes = require(Shared.Modules.Remotes)
local Formulas = require(Shared.Modules.Formulas)

local Registry = require(script.Parent.Parent.Registry)
local Profile = require(script.Parent.Parent.Logic.Profile)
local Daily = require(script.Parent.Parent.Logic.Daily)


type PlayerState = {
	saving: boolean,
	temporary: boolean, -- Studio without API access: never saved
	dirty: boolean,
	pushQueued: boolean,
}

local DataService = {}

-- Timings (seconds). Exposed so tests can shorten them.
DataService.config = {
	lockStaleSeconds = 600, -- a lock older than this is considered abandoned
	autosaveSeconds = 90,
	loadAttempts = 6,
	lockedRetryDelay = 5,
	errorRetryDelay = 2, -- multiplied by the attempt number
	saveRetryDelay = 2, -- raised to the attempt number
}

local store: DataStore? = nil
local profiles: { [Player]: { [string]: any } } = {}
local states: { [Player]: PlayerState } = {}
local loadedCallbacks: { (Player, { [string]: any }) -> () } = {}
local stateRemote = Remotes.event("State")
local notifyRemote = Remotes.event("Notify")

local function key(player: Player): string
	return "u_" .. player.UserId
end

local function jobId(): string
	return if game.JobId ~= "" then game.JobId else "studio"
end

local function getStore(): DataStore?
	if store then
		return store
	end
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore(GameConfig.DataStoreName)
	end)
	if ok then
		store = result
		return result
	end
	return nil
end

-- Returns ("ok", data) | ("locked", nil) | ("error", message)
local function tryLoad(player: Player): (string, any)
	local dataStore = getStore()
	if not dataStore then
		return "error", "DataStore unavailable"
	end
	local lockedBy: string? = nil
	local loaded: any = nil
	local ok, err = pcall(function()
		dataStore:UpdateAsync(key(player), function(old)
			lockedBy = nil
			if type(old) == "table" and type(old.lock) == "table" then
				local lock = old.lock
				if lock.job ~= jobId() and os.time() - (tonumber(lock.time) or 0) < DataService.config.lockStaleSeconds then
					lockedBy = tostring(lock.job)
					return nil -- abort: another server owns this session
				end
			end
			local record = if type(old) == "table" then old else {}
			loaded = record.data
			record.lock = { job = jobId(), time = os.time() }
			return record
		end)
	end)
	if not ok then
		return "error", tostring(err)
	end
	if lockedBy then
		return "locked", nil
	end
	return "ok", loaded
end

local function isStudioApiError(message: string): boolean
	return RunService:IsStudio()
		and (message:find("403") ~= nil or message:find("API") ~= nil or message:find("unavailable") ~= nil or message:find("Studio") ~= nil)
end

function DataService.get(player: Player): { [string]: any }?
	return profiles[player]
end

function DataService.isTemporary(player: Player): boolean
	local state = states[player]
	return state ~= nil and state.temporary
end

function DataService.onLoaded(callback: (Player, { [string]: any }) -> ())
	table.insert(loadedCallbacks, callback)
	for player, profile in profiles do
		task.spawn(callback, player, profile)
	end
end

function DataService.notify(player: Player, text: string, kind: string?)
	notifyRemote:FireClient(player, { text = text, kind = kind or "info" })
end

-- Sends the client a fresh snapshot (debounced to once per frame).
function DataService.changed(player: Player)
	local state = states[player]
	if not state or state.pushQueued then
		return
	end
	state.dirty = true
	state.pushQueued = true
	task.defer(function()
		state.pushQueued = false
		local profile = profiles[player]
		if not profile or player.Parent == nil then
			return
		end
		local now = os.time()
		local stats = Registry.StatsService.compute(player)
		stateRemote:FireClient(player, {
			profile = Profile.snapshot(profile),
			stats = stats,
			passes = Registry.MonetizationService.getPasses(player),
			serverLuck = Registry.MonetizationService.getServerLuck(),
			serverTime = now,
			loginIndex = Daily.loginIndex(profile, now),
			canClaimLogin = Daily.canClaimLogin(profile, now),
			canClaimBoost = profile.daily.boostDay < Formulas.dayNumber(now),
			autoRoll = Registry.RollService.isAutoRolling(player),
			temporary = state.temporary,
		})
	end)
end

function DataService.save(player: Player, release: boolean?): boolean
	local profile = profiles[player]
	local state = states[player]
	if not profile or not state then
		return false
	end
	if state.temporary then
		return true
	end
	while state.saving do
		task.wait(0.1)
	end
	state.saving = true
	profile.lastOnline = os.time()
	local copy = Profile.deepCopy(profile)
	local success = false
	local lostLock = false
	local dataStore = getStore()
	for attempt = 1, 4 do
		if not dataStore then
			break
		end
		local ok, err = pcall(function()
			dataStore:UpdateAsync(key(player), function(old)
				if type(old) == "table" and type(old.lock) == "table" and old.lock.job ~= jobId() then
					lostLock = true
					return nil
				end
				return {
					data = copy,
					lock = if release then nil else { job = jobId(), time = os.time() },
				}
			end)
		end)
		if ok then
			success = not lostLock
			break
		end
		warn(`[DataService] Save attempt {attempt} for {player.Name} failed: {err}`)
		task.wait(DataService.config.saveRetryDelay ^ attempt)
	end
	state.saving = false
	if success then
		state.dirty = false
	end
	if lostLock and player.Parent then
		player:Kick("Your data was opened on another server. Please rejoin.")
	end
	return success
end

local function onPlayerAdded(player: Player)
	local data: any = nil
	local temporary = false
	local status, result = "error", "not attempted"

	for attempt = 1, DataService.config.loadAttempts do
		status, result = tryLoad(player)
		if status == "ok" then
			data = result
			break
		end
		if status == "error" and isStudioApiError(result) then
			break
		end
		if player.Parent == nil then
			return
		end
		task.wait(if status == "locked" then DataService.config.lockedRetryDelay else attempt * DataService.config.errorRetryDelay)
	end

	if status ~= "ok" then
		if status == "error" and isStudioApiError(result) then
			warn("[DataService] Studio has no DataStore access (enable 'Studio Access to API Services'). Using a temporary profile that will NOT be saved.")
			temporary = true
		else
			warn(`[DataService] Could not load data for {player.Name}: {status} {result}`)
			if player.Parent then
				player:Kick(if status == "locked"
					then "Your data is still saving on another server. Please rejoin in a minute."
					else "We couldn't load your data (Roblox DataStores may be down). Your progress is safe — please rejoin shortly.")
			end
			return
		end
	end

	if player.Parent == nil then
		-- Left while loading: write back exactly what we loaded and release the lock.
		if not temporary then
			profiles[player] = Profile.migrate(data)
			states[player] = { saving = false, temporary = false, dirty = false, pushQueued = false }
			DataService.save(player, true)
			profiles[player] = nil
			states[player] = nil
		end
		return
	end

	local ok, profileOrErr = pcall(Profile.migrate, data)
	if not ok then
		warn(`[DataService] Migration failed for {player.Name}: {profileOrErr}`)
		player:Kick("Your data is from a newer game version. Please join a newer server.")
		return
	end
	local profile = profileOrErr
	if profile.createdAt == 0 then
		profile.createdAt = os.time()
	end
	profiles[player] = profile
	states[player] = { saving = false, temporary = temporary, dirty = false, pushQueued = false }
	player:SetAttribute("DataLoaded", true)

	for _, callback in loadedCallbacks do
		task.spawn(callback, player, profile)
	end
	DataService.changed(player)
	if temporary then
		DataService.notify(player, "Studio test mode: progress will not be saved.", "warning")
	end
end

local function onPlayerRemoving(player: Player)
	if profiles[player] then
		DataService.save(player, true)
	end
	profiles[player] = nil
	states[player] = nil
end

function DataService.init()
	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	for _, player in Players:GetPlayers() do
		task.spawn(onPlayerAdded, player)
	end

	task.spawn(function()
		while true do
			task.wait(DataService.config.autosaveSeconds)
			for player in profiles do
				task.spawn(DataService.save, player, false)
			end
		end
	end)

	game:BindToClose(function()
		local pending = 0
		for player in profiles do
			pending += 1
			task.spawn(function()
				DataService.save(player, true)
				pending -= 1
			end)
		end
		local started = os.clock()
		while pending > 0 and os.clock() - started < 25 do
			task.wait(0.2)
		end
	end)
end

return DataService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">LeaderboardService</string>
            <string name="Source"><![CDATA[-- In-server leaderstats, the live "richest in server" list, and a global
-- all-time leaderboard (lifetime earnings) backed by an OrderedDataStore.

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local Formulas = require(Shared.Modules.Formulas)
local NumberFormat = require(Shared.Modules.NumberFormat)
local Rarities = require(Shared.Config.Rarities)
local Remotes = require(Shared.Modules.Remotes)

local Registry = require(script.Parent.Parent.Registry)

local LeaderboardService = {}

local leaderboardRemote = Remotes.event("Leaderboard")
local orderedStore: OrderedDataStore? = nil
local globalEntries: { { userId: number, name: string, value: number } } = {}
local nameCache: { [number]: string } = {}
local pendingUpdate: { [Player]: boolean } = {}

local function getOrderedStore(): OrderedDataStore?
	if orderedStore then
		return orderedStore
	end
	local ok, result = pcall(function()
		return DataStoreService:GetOrderedDataStore(GameConfig.LeaderboardStoreName)
	end)
	if ok then
		orderedStore = result
		return result
	end
	return nil
end

local function ensureLeaderstats(player: Player)
	if player:FindFirstChild("leaderstats") then
		return
	end
	local folder = Instance.new("Folder")
	folder.Name = "leaderstats"
	local cash = Instance.new("StringValue")
	cash.Name = "Cash"
	cash.Value = "0"
	cash.Parent = folder
	local best = Instance.new("StringValue")
	best.Name = "Best"
	best.Value = "-"
	best.Parent = folder
	local rebirths = Instance.new("IntValue")
	rebirths.Name = "Rebirths"
	rebirths.Parent = folder
	folder.Parent = player
end

function LeaderboardService.updatePlayer(player: Player, profile: { [string]: any })
	ensureLeaderstats(player)
	local stats = player:FindFirstChild("leaderstats")
	if not stats then
		return
	end
	;(stats:FindFirstChild("Cash") :: StringValue).Value = NumberFormat.short(profile.cash)
	local best = Rarities.list[profile.bestOrder]
	;(stats:FindFirstChild("Best") :: StringValue).Value = if best then best.name else "-"
	;(stats:FindFirstChild("Rebirths") :: IntValue).Value = profile.rebirths
	player:SetAttribute("Cash", profile.cash)
	player:SetAttribute("Lifetime", profile.lifetime)
	player:SetAttribute("Rebirths", profile.rebirths)
	player:SetAttribute("BestOrder", profile.bestOrder)
	player:SetAttribute("Title", Formulas.wealthTitle(profile.lifetime))
	pendingUpdate[player] = true
end

local function serverEntries()
	local entries = {}
	for _, player in Players:GetPlayers() do
		local profile = Registry.DataService.get(player)
		if profile then
			table.insert(entries, {
				userId = player.UserId,
				name = player.DisplayName,
				value = profile.cash,
				lifetime = profile.lifetime,
				rebirths = profile.rebirths,
			})
		end
	end
	table.sort(entries, function(a, b)
		return a.value > b.value
	end)
	return entries
end

local function broadcast()
	local payload = { server = serverEntries(), global = globalEntries }
	leaderboardRemote:FireAllClients(payload)
	Registry.MapService.updateLeaderboardBoards(payload)
end

local function resolveName(userId: number): string
	if nameCache[userId] then
		return nameCache[userId]
	end
	local ok, name = pcall(Players.GetNameFromUserIdAsync, Players, userId)
	local result = if ok then name else ("Player " .. userId)
	nameCache[userId] = result
	return result
end

local function pushGlobalScores()
	local store = getOrderedStore()
	if not store then
		return
	end
	for _, player in Players:GetPlayers() do
		local profile = Registry.DataService.get(player)
		if profile and not Registry.DataService.isTemporary(player) and profile.lifetime > 0 then
			pcall(function()
				store:SetAsync(tostring(player.UserId), Formulas.encodeLeaderboardValue(profile.lifetime))
			end)
		end
	end
end

local function fetchGlobal()
	local store = getOrderedStore()
	if not store then
		return
	end
	local ok, pages = pcall(function()
		return store:GetSortedAsync(false, GameConfig.Leaderboard.globalSize)
	end)
	if not ok then
		return
	end
	local entries = {}
	for _, item in pages:GetCurrentPage() do
		local userId = tonumber(item.key)
		if userId then
			table.insert(entries, {
				userId = userId,
				name = resolveName(userId),
				value = Formulas.decodeLeaderboardValue(item.value),
			})
		end
	end
	globalEntries = entries
end

function LeaderboardService.init()
	Registry.DataService.onLoaded(function(player, profile)
		LeaderboardService.updatePlayer(player, profile)
		broadcast()
	end)
	Players.PlayerRemoving:Connect(function(player)
		pendingUpdate[player] = nil
		task.defer(broadcast)
	end)

	Registry.RequestService.register("GetLeaderboard", function()
		return { ok = true, data = { server = serverEntries(), global = globalEntries } }
	end, 2)

	-- Live server leaderboard: refresh a few times per minute when values change.
	task.spawn(function()
		while true do
			task.wait(3)
			if next(pendingUpdate) then
				table.clear(pendingUpdate)
				broadcast()
			end
		end
	end)

	-- Global leaderboard: write scores, then read the top list.
	task.spawn(function()
		task.wait(10)
		while true do
			pushGlobalScores()
			fetchGlobal()
			broadcast()
			task.wait(GameConfig.Leaderboard.globalRefreshSeconds)
		end
	end)
end

return LeaderboardService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">MonetizationService</string>
            <string name="Source"><![CDATA[-- Game passes and developer products.
--
-- * Pass ownership is checked with UserOwnsGamePassAsync on join (with
--   retries) and updated from PromptGamePassPurchaseFinished, which Roblox
--   only fires on the server for real purchases.
-- * Developer products are granted only inside ProcessReceipt. Each
--   PurchaseId is recorded in the player's profile and the profile is saved
--   BEFORE returning PurchaseGranted, so a product is never granted twice and
--   never lost. If anything fails we return NotProcessedYet and Roblox retries.

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Monetization = require(Shared.Config.Monetization)
local Remotes = require(Shared.Modules.Remotes)

local Registry = require(script.Parent.Parent.Registry)
local Economy = require(script.Parent.Parent.Logic.Economy)

local MAX_RECEIPTS = 100

local MonetizationService = {}

local passes: { [Player]: { [string]: boolean } } = {}
local serverLuck = { mult = 1, expires = 0 }
local announceRemote = Remotes.event("Announce")

function MonetizationService.getPasses(player: Player): { [string]: boolean }
	return passes[player] or {}
end

function MonetizationService.hasPass(player: Player, key: string): boolean
	local owned = passes[player]
	return owned ~= nil and owned[key] == true
end

function MonetizationService.getServerLuck(): { mult: number, expires: number }
	if serverLuck.expires <= os.time() then
		return { mult = 1, expires = 0 }
	end
	return { mult = serverLuck.mult, expires = serverLuck.expires }
end

local function refreshAll()
	for _, player in Players:GetPlayers() do
		Registry.DataService.changed(player)
	end
end

local function setPass(player: Player, key: string)
	passes[player] = passes[player] or {}
	passes[player][key] = true
	player:SetAttribute("Pass_" .. key, true)
	Registry.DataService.changed(player)
	Registry.AvatarService.refresh(player)
end

local function loadPasses(player: Player)
	passes[player] = passes[player] or {}
	for _, pass in Monetization.Passes do
		if pass.id ~= 0 then
			for _ = 1, 3 do
				local ok, owns = pcall(MarketplaceService.UserOwnsGamePassAsync, MarketplaceService, player.UserId, pass.id)
				if ok then
					if owns then
						setPass(player, pass.key)
					end
					break
				end
				task.wait(1)
			end
		end
	end
end

local function grantProduct(player: Player, profile: { [string]: any }, product: Monetization.Product): string
	local now = os.time()
	local parts = {}
	if product.grant.luckBoost then
		Economy.addBoost(profile, "product", product.grant.luckBoost.mult, product.grant.luckBoost.minutes, now)
		table.insert(parts, `{product.grant.luckBoost.mult}x Luck for {product.grant.luckBoost.minutes} minutes`)
	end
	if product.grant.scaledCash then
		table.insert(parts, Economy.grant(profile, { scaledCash = product.grant.scaledCash }, "product", now))
	end
	if product.grant.serverLuck then
		local boost = product.grant.serverLuck
		local start = math.max(serverLuck.expires, now)
		serverLuck = { mult = math.max(boost.mult, if serverLuck.expires > now then serverLuck.mult else 1), expires = start + boost.minutes * 60 }
		announceRemote:FireAllClients({
			kind = "serverLuck",
			text = `{player.DisplayName} activated {boost.mult}x SERVER LUCK for everyone!`,
		})
		table.insert(parts, "Server luck activated")
		refreshAll()
	end
	return table.concat(parts, " + ")
end

local function processReceipt(receipt): Enum.ProductPurchaseDecision
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local profile = Registry.DataService.get(player)
	if not profile or Registry.DataService.isTemporary(player) then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	local product = Monetization.ProductById[receipt.ProductId]
	if not product then
		warn(`[Monetization] Unknown product id {receipt.ProductId}`)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	if table.find(profile.receipts, receipt.PurchaseId) == nil then
		local ok, result = pcall(grantProduct, player, profile, product)
		if not ok then
			warn(`[Monetization] Grant failed: {result}`)
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		table.insert(profile.receipts, receipt.PurchaseId)
		while #profile.receipts > MAX_RECEIPTS do
			table.remove(profile.receipts, 1)
		end
		Registry.DataService.notify(player, `Purchase complete: {result}`, "success")
		Registry.DataService.changed(player)
	end

	if not Registry.DataService.save(player, false) then
		-- Grant stays in memory with its receipt recorded, so a retry can't
		-- double-grant on this server; if the server dies the grant is lost
		-- along with the receipt and Roblox will retry on the next session.
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

local function promptPass(player: Player, key: any)
	if type(key) ~= "string" then
		return { ok = false, message = "Invalid pass" }
	end
	local pass = Monetization.PassByKey[key]
	if not pass then
		return { ok = false, message = "Invalid pass" }
	end
	if pass.id == 0 then
		return { ok = false, message = "This pass isn't available yet" }
	end
	if MonetizationService.hasPass(player, key) then
		return { ok = false, message = "You already own this pass" }
	end
	MarketplaceService:PromptGamePassPurchase(player, pass.id)
	return { ok = true }
end

local function promptProduct(player: Player, key: any)
	if type(key) ~= "string" then
		return { ok = false, message = "Invalid product" }
	end
	local product = Monetization.ProductByKey[key]
	if not product then
		return { ok = false, message = "Invalid product" }
	end
	if product.id == 0 then
		return { ok = false, message = "This product isn't available yet" }
	end
	MarketplaceService:PromptProductPurchase(player, product.id)
	return { ok = true }
end

function MonetizationService.init()
	MarketplaceService.ProcessReceipt = processReceipt

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, purchased)
		if not purchased then
			return
		end
		local pass = Monetization.PassById[passId]
		if pass then
			setPass(player, pass.key)
			Registry.DataService.notify(player, `Thanks for buying {pass.name}!`, "success")
		end
	end)

	Players.PlayerAdded:Connect(loadPasses)
	for _, player in Players:GetPlayers() do
		task.spawn(loadPasses, player)
	end
	Players.PlayerRemoving:Connect(function(player)
		passes[player] = nil
	end)

	Registry.RequestService.register("BuyPass", promptPass, 1)
	Registry.RequestService.register("BuyProduct", promptProduct, 1)

	-- Tell everyone when the server luck boost ends.
	task.spawn(function()
		local wasActive = false
		while true do
			task.wait(1)
			local active = serverLuck.expires > os.time()
			if wasActive and not active then
				refreshAll()
			end
			wasActive = active
		end
	end)
end

return MonetizationService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="35">
          <Properties>
            <string name="Name">RequestService</string>
            <string name="Source"><![CDATA[-- Single entry point for client requests: Request(action, ...) -> result.
-- Every handler receives the calling Player (provided by Roblox, never by the
-- client) and raw, untrusted arguments that each handler validates.
-- Each action has its own minimum interval and there is a global budget per
-- player to stop remote spam.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Remotes = require(ReplicatedStorage:WaitForChild("Shared").Modules.Remotes)

local GLOBAL_BUDGET = 25 -- requests per second per player

export type Result = { ok: boolean, message: string?, data: any? }
type Handler = (player: Player, ...any) -> Result?

local RequestService = {}

local handlers: { [string]: { fn: Handler, interval: number } } = {}
local lastCall: { [Player]: { [string]: number } } = {}
local budget: { [Player]: { count: number, window: number } } = {}

function RequestService.register(action: string, fn: Handler, minInterval: number?)
	assert(handlers[action] == nil, "Duplicate request handler " .. action)
	handlers[action] = { fn = fn, interval = minInterval or 0.2 }
end

local function onInvoke(player: Player, action: any, ...): Result
	if type(action) ~= "string" then
		return { ok = false, message = "Bad request" }
	end
	local handler = handlers[action]
	if not handler then
		return { ok = false, message = "Unknown action" }
	end

	local now = os.clock()
	local playerBudget = budget[player]
	if not playerBudget or now - playerBudget.window >= 1 then
		playerBudget = { count = 0, window = now }
		budget[player] = playerBudget
	end
	playerBudget.count += 1
	if playerBudget.count > GLOBAL_BUDGET then
		return { ok = false, message = "Slow down!" }
	end

	local calls = lastCall[player]
	if not calls then
		calls = {}
		lastCall[player] = calls
	end
	if calls[action] and now - calls[action] < handler.interval then
		return { ok = false, message = "Slow down!" }
	end
	calls[action] = now

	local ok, result = pcall(handler.fn, player, ...)
	if not ok then
		warn(`[RequestService] {action} from {player.Name} errored: {result}`)
		return { ok = false, message = "Something went wrong" }
	end
	return result or { ok = true }
end

function RequestService.init()
	Remotes.func("Request").OnServerInvoke = onInvoke
	Players.PlayerRemoving:Connect(function(player)
		lastCall[player] = nil
		budget[player] = nil
	end)
end

return RequestService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="36">
          <Properties>
            <string name="Name">RewardService</string>
            <string name="Source"><![CDATA[-- Daily login, daily boost, playtime, codes, quests, achievements (+ badges),
-- roll milestones and offline earnings.

local BadgeService = game:GetService("BadgeService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Formulas = require(Shared.Modules.Formulas)
local NumberFormat = require(Shared.Modules.NumberFormat)
local Upgrades = require(Shared.Config.Upgrades)

local Registry = require(script.Parent.Parent.Registry)
local Economy = require(script.Parent.Parent.Logic.Economy)
local Daily = require(script.Parent.Parent.Logic.Daily)
local Quests = require(script.Parent.Parent.Logic.Quests)
local Codes = require(script.Parent.Parent.Config.Codes)

local RewardService = {}

local function awardBadge(player: Player, badgeId: number)
	if badgeId == 0 then
		return
	end
	task.spawn(function()
		local ok, has = pcall(BadgeService.UserHasBadgeAsync, BadgeService, player.UserId, badgeId)
		if ok and not has then
			pcall(BadgeService.AwardBadge, BadgeService, player.UserId, badgeId)
		end
	end)
end

-- Called after anything that can complete achievements/milestones.
function RewardService.checkProgress(player: Player, profile: { [string]: any }, now: number)
	for _, earned in Quests.checkAchievements(profile, now) do
		Registry.DataService.notify(player, `Achievement: {earned.achievement.name}! {earned.text}`, "achievement")
		awardBadge(player, earned.achievement.badgeId)
	end
	for _, message in Quests.checkMilestones(profile, now) do
		Registry.DataService.notify(player, message, "success")
	end
end

-- Wraps a pure (profile, ...) -> (ok, message) action as a request handler.
local function action(fn: (profile: { [string]: any }, ...any) -> (boolean, string))
	return function(player: Player, ...)
		local profile = Registry.DataService.get(player)
		if not profile then
			return { ok = false, message = "Still loading" }
		end
		local ok, message = fn(profile, ...)
		if ok then
			RewardService.checkProgress(player, profile, os.time())
			Registry.DataService.changed(player)
			Registry.LeaderboardService.updatePlayer(player, profile)
		end
		return { ok = ok, message = message }
	end
end

local function grantOffline(player: Player, profile: { [string]: any })
	local now = os.time()
	if profile.lastOnline > 0 then
		local seconds = now - profile.lastOnline
		local cash = Formulas.offlineCash(profile.upgrades.Offline or 0, profile.bestOrder, seconds)
		if cash > 0 then
			Economy.addCash(profile, cash)
			Registry.DataService.notify(
				player,
				`Welcome back! Passive income earned ${NumberFormat.short(cash)} while you were away ({NumberFormat.duration(seconds)}).`,
				"success"
			)
		end
	end
	profile.lastOnline = now
end

function RewardService.init()
	local Request = Registry.RequestService

	Request.register("ClaimDaily", action(function(profile)
		return Daily.claimLogin(profile, os.time())
	end), 1)

	Request.register("ClaimDailyBoost", action(function(profile)
		return Daily.claimBoost(profile, os.time())
	end), 1)

	Request.register("ClaimPlaytime", action(function(profile, index)
		return Daily.claimPlaytime(profile, index, os.time())
	end), 0.5)

	Request.register("ClaimQuest", action(function(profile, index)
		return Quests.claimDaily(profile, index, os.time())
	end), 0.5)

	Request.register("ClaimRepeatable", action(function(profile, id)
		return Quests.claimRepeatable(profile, id, os.time())
	end), 0.5)

	Request.register("RedeemCode", action(function(profile, code)
		return Economy.redeemCode(profile, code, Codes, os.time())
	end), 2)

	Request.register("BuyUpgrade", function(player, upgradeId)
		local profile = Registry.DataService.get(player)
		if not profile then
			return { ok = false, message = "Still loading" }
		end
		local ok, message = Economy.buyUpgrade(profile, upgradeId)
		if ok then
			Quests.progress(profile, "upgrades", 1)
			RewardService.checkProgress(player, profile, os.time())
			Registry.DataService.changed(player)
			Registry.LeaderboardService.updatePlayer(player, profile)
		end
		return { ok = ok, message = message }
	end, 0.1)

	Request.register("BuyUpgradeMax", function(player, upgradeId)
		local profile = Registry.DataService.get(player)
		if not profile or type(upgradeId) ~= "string" or not Upgrades.byId[upgradeId] then
			return { ok = false, message = "Invalid" }
		end
		local bought = 0
		while bought < 100 and Economy.buyUpgrade(profile, upgradeId) do
			bought += 1
		end
		if bought == 0 then
			return { ok = false, message = "Not enough cash" }
		end
		Quests.progress(profile, "upgrades", bought)
		RewardService.checkProgress(player, profile, os.time())
		Registry.DataService.changed(player)
		Registry.LeaderboardService.updatePlayer(player, profile)
		return { ok = true, message = `Bought {bought} level(s)` }
	end, 0.5)

	Request.register("Rebirth", function(player)
		local profile = Registry.DataService.get(player)
		if not profile then
			return { ok = false, message = "Still loading" }
		end
		local ok, message = Economy.rebirth(profile)
		if ok then
			RewardService.checkProgress(player, profile, os.time())
			Registry.DataService.changed(player)
			Registry.LeaderboardService.updatePlayer(player, profile)
			Registry.AvatarService.refresh(player)
			Registry.Announce(`{player.DisplayName} reached Rebirth {profile.rebirths}!`)
			task.spawn(Registry.DataService.save, player, false)
		end
		return { ok = ok, message = message }
	end, 1)

	Request.register("UnlockZone", action(function(profile, zoneId)
		return Economy.unlockZone(profile, zoneId)
	end), 0.5)

	Request.register("SetSetting", action(function(profile, key, value)
		return Economy.setSetting(profile, key, value)
	end), 0.1)

	Request.register("EquipAura", function(player, auraId)
		local profile = Registry.DataService.get(player)
		if not profile then
			return { ok = false, message = "Still loading" }
		end
		local ok, message = Economy.equipAura(profile, auraId, Registry.MonetizationService.hasPass(player, "VIP"))
		if ok then
			Registry.AvatarService.refresh(player)
			Registry.DataService.changed(player)
		end
		return { ok = ok, message = message }
	end, 0.3)

	Registry.DataService.onLoaded(function(player, profile)
		local now = os.time()
		grantOffline(player, profile)
		Quests.ensureDaily(profile, now)
		Quests.ensureRepeatable(profile)
		Economy.pruneBoosts(profile, now)
		RewardService.checkProgress(player, profile, now)
		if Daily.canClaimLogin(profile, now) then
			Registry.DataService.notify(player, "Your daily reward is ready! Open the Daily menu.", "info")
		end
		Registry.DataService.changed(player)
	end)

	-- Playtime tracking, daily quest rollover and boost expiry.
	task.spawn(function()
		local lastTick = os.clock()
		local minuteCounter: { [Player]: number } = {}
		while true do
			task.wait(5)
			local elapsed = os.clock() - lastTick
			lastTick = os.clock()
			local now = os.time()
			for _, player in Players:GetPlayers() do
				local profile = Registry.DataService.get(player)
				if profile then
					Daily.addPlaytime(profile, now, elapsed)
					minuteCounter[player] = (minuteCounter[player] or 0) + elapsed
					local changed = false
					if minuteCounter[player] >= 60 then
						minuteCounter[player] -= 60
						Quests.progress(profile, "playMinutes", 1)
						changed = true
					end
					if Quests.ensureDaily(profile, now) then
						Registry.DataService.notify(player, "New daily quests are available!", "info")
						changed = true
					end
					local hadBoosts = next(profile.boosts) ~= nil
					Economy.pruneBoosts(profile, now)
					if hadBoosts and next(profile.boosts) == nil then
						changed = true
					end
					if changed then
						Registry.DataService.changed(player)
					end
				end
			end
			for player in minuteCounter do
				if player.Parent == nil then
					minuteCounter[player] = nil
				end
			end
		end
	end)
end

return RewardService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="37">
          <Properties>
            <string name="Name">RollService</string>
            <string name="Source"><![CDATA[-- Manual and auto rolling. The server owns the cooldown, the luck value and
-- the random generator; the client only asks "roll please".

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local Rarities = require(Shared.Config.Rarities)
local Remotes = require(Shared.Modules.Remotes)
local NumberFormat = require(Shared.Modules.NumberFormat)

local Registry = require(script.Parent.Parent.Registry)
local Roll = require(script.Parent.Parent.Logic.Roll)
local Quests = require(script.Parent.Parent.Logic.Quests)

local RollService = {}

local random = Random.new()
local function nextNumber(): number
	return random:NextNumber()
end

local lastRoll: { [Player]: number } = {}
local autoRolling: { [Player]: true } = {}
local resultRemote = Remotes.event("RollResult")
local announceRemote = Remotes.event("Announce")

function RollService.isAutoRolling(player: Player): boolean
	return autoRolling[player] == true
end

local function doRoll(player: Player, auto: boolean): (boolean, string?)
	local profile = Registry.DataService.get(player)
	local stats = Registry.StatsService.compute(player)
	if not profile or not stats then
		return false, "Still loading"
	end
	local now = os.clock()
	local last = lastRoll[player]
	if last and now - last < stats.cooldown - GameConfig.Roll.latencyTolerance then
		return false, nil -- silently ignore early clicks
	end
	lastRoll[player] = now

	local outcome = Roll.perform(profile, stats, nextNumber)
	local timestamp = os.time()

	-- Quest progress
	Quests.progress(profile, "rolls", outcome.rollsDone)
	Quests.progress(profile, "earn", outcome.total)
	for _, single in outcome.results do
		local rarity = Rarities.byId[single.id]
		Quests.progress(profile, "rarityAtLeast", 1, rarity.order)
	end

	resultRemote:FireClient(player, {
		results = outcome.results,
		best = outcome.best,
		bestCash = outcome.bestCash,
		total = outcome.total,
		newDiscoveries = outcome.newDiscoveries,
		cooldown = stats.cooldown,
		luck = stats.luck,
		auto = auto,
	})

	local best = Rarities.byId[outcome.best]
	if best.announce then
		announceRemote:FireAllClients({
			kind = "roll",
			userId = player.UserId,
			name = player.DisplayName,
			rarity = best.id,
			cash = outcome.bestCash,
			text = `{player.DisplayName} rolled {best.name} for ${NumberFormat.short(outcome.bestCash)}!`,
		})
	end

	Registry.RewardService.checkProgress(player, profile, timestamp)
	Registry.LeaderboardService.updatePlayer(player, profile)
	-- Auto-equip a newly discovered aura if it beats the equipped one.
	if best.hasAura and table.find(outcome.newDiscoveries, best.id) then
		local equipped = Rarities.byId[profile.equippedAura]
		if profile.equippedAura == "" or (equipped and equipped.order < best.order) then
			profile.equippedAura = best.id
			Registry.AvatarService.refresh(player)
		end
	end
	Registry.DataService.changed(player)
	return true, nil
end

function RollService.init()
	Registry.RequestService.register("Roll", function(player)
		local ok, message = doRoll(player, false)
		return { ok = ok, message = message }
	end, 0.1)

	Registry.RequestService.register("SetAutoRoll", function(player, enabled)
		if type(enabled) ~= "boolean" then
			return { ok = false, message = "Invalid" }
		end
		if enabled then
			local stats = Registry.StatsService.compute(player)
			if not stats or not stats.autoRollUnlocked then
				return { ok = false, message = `Auto-roll unlocks at {GameConfig.Roll.autoRollUnlockRolls} rolls (or with the Auto-Roll pass)` }
			end
		end
		if enabled then
			autoRolling[player] = true
		else
			autoRolling[player] = nil
		end
		Registry.DataService.changed(player)
		return { ok = true }
	end, 0.3)

	Players.PlayerRemoving:Connect(function(player)
		autoRolling[player] = nil
		lastRoll[player] = nil
	end)

	-- Auto-roll loop: rolls for each opted-in player as soon as their cooldown allows.
	local accumulator = 0
	RunService.Heartbeat:Connect(function(dt)
		accumulator += dt
		if accumulator < 0.05 then
			return
		end
		accumulator = 0
		for player in autoRolling do
			local stats = Registry.StatsService.compute(player)
			local last = lastRoll[player]
			if stats and (not last or os.clock() - last >= stats.cooldown) then
				task.spawn(doRoll, player, true)
			end
		end
	end)
end

return RollService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">StatsService</string>
            <string name="Source"><![CDATA[-- Computes a player's effective stats on the server. The zone bonus is based
-- on where the character actually is (and whether the zone is unlocked), so a
-- client can't claim to be in a better zone.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local Formulas = require(Shared.Modules.Formulas)

local Registry = require(script.Parent.Parent.Registry)

local StatsService = {}

function StatsService.zoneFor(player: Player, profile: { [string]: any }): string
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return "Downtown"
	end
	local position = root.Position
	for _, zone in GameConfig.Zones do
		if zone.radius > 0 and profile.zones[zone.id] then
			local offset = position - zone.center
			if Vector3.new(offset.X, 0, offset.Z).Magnitude <= zone.radius and math.abs(offset.Y) < 80 then
				return zone.id
			end
		end
	end
	return "Downtown"
end

function StatsService.compute(player: Player): Formulas.Stats?
	local profile = Registry.DataService.get(player)
	if not profile then
		return nil
	end
	return Formulas.computeStats(profile, {
		passes = Registry.MonetizationService.getPasses(player),
		zoneId = StatsService.zoneFor(player, profile),
		now = os.time(),
		serverLuck = Registry.MonetizationService.getServerLuck().mult,
	})
end

function StatsService.init()
	-- Keep each client's zone/luck display current as players move between zones.
	local lastZone: { [Player]: string } = {}
	task.spawn(function()
		while true do
			task.wait(1)
			for _, player in game:GetService("Players"):GetPlayers() do
				local profile = Registry.DataService.get(player)
				if profile then
					local zone = StatsService.zoneFor(player, profile)
					if lastZone[player] ~= zone then
						lastZone[player] = zone
						player:SetAttribute("Zone", zone)
						Registry.DataService.changed(player)
					end
				end
			end
			for player in lastZone do
				if player.Parent == nil then
					lastZone[player] = nil
				end
			end
		end
	end)
end

return StatsService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">TradeService</string>
            <string name="Source"><![CDATA[-- Secure player-to-player aura trading.
--
-- Flow: TradeRequest -> (target) TradeRespond -> both TradeSetOffer ->
-- both TradeAccept(version). Any offer change bumps `version` and clears both
-- accepts, so a player can only ever accept exactly what they last saw.
-- Execution re-validates inventories inside Logic/Trade.execute (no yields),
-- then both profiles are saved immediately.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local Remotes = require(Shared.Modules.Remotes)

local Registry = require(script.Parent.Parent.Registry)
local Trade = require(script.Parent.Parent.Logic.Trade)

type Session = {
	a: Player,
	b: Player,
	offers: { [Player]: Trade.Offer },
	accepted: { [Player]: boolean },
	version: number,
	busy: boolean,
}

local TradeService = {}

local tradeRemote = Remotes.event("Trade")
local sessions: { [Player]: Session } = {}
local invites: { [Player]: { from: Player, expires: number } } = {}
local lastRequest: { [Player]: number } = {}

local function partnerOf(session: Session, player: Player): Player
	return if session.a == player then session.b else session.a
end

local function push(session: Session)
	for _, player in { session.a, session.b } do
		local partner = partnerOf(session, player)
		tradeRemote:FireClient(player, {
			type = "update",
			partnerName = partner.DisplayName,
			partnerUserId = partner.UserId,
			myOffer = session.offers[player],
			theirOffer = session.offers[partner],
			myAccepted = session.accepted[player] == true,
			theirAccepted = session.accepted[partner] == true,
			version = session.version,
		})
	end
end

local function close(session: Session, reason: string)
	for _, player in { session.a, session.b } do
		if sessions[player] == session then
			sessions[player] = nil
		end
		if player.Parent then
			tradeRemote:FireClient(player, { type = "closed", reason = reason })
		end
	end
end

local function request(player: Player, targetUserId: any)
	if type(targetUserId) ~= "number" then
		return { ok = false, message = "Invalid player" }
	end
	local target = Players:GetPlayerByUserId(targetUserId)
	if not target or target == player then
		return { ok = false, message = "Player not found" }
	end
	if not Registry.DataService.get(player) or not Registry.DataService.get(target) then
		return { ok = false, message = "Player is still loading" }
	end
	if sessions[player] or sessions[target] then
		return { ok = false, message = "Already in a trade" }
	end
	local now = os.clock()
	if lastRequest[player] and now - lastRequest[player] < GameConfig.Trade.requestCooldown then
		return { ok = false, message = "Wait before sending another request" }
	end
	lastRequest[player] = now
	invites[target] = { from = player, expires = now + GameConfig.Trade.inviteTimeout }
	tradeRemote:FireClient(target, { type = "invite", fromName = player.DisplayName, fromUserId = player.UserId })
	return { ok = true, message = `Trade request sent to {target.DisplayName}` }
end

local function respond(player: Player, fromUserId: any, accept: any)
	local invite = invites[player]
	if not invite or type(fromUserId) ~= "number" or invite.from.UserId ~= fromUserId then
		return { ok = false, message = "No such trade request" }
	end
	invites[player] = nil
	local from = invite.from
	if accept ~= true then
		if from.Parent then
			Registry.DataService.notify(from, `{player.DisplayName} declined your trade`, "warning")
		end
		return { ok = true }
	end
	if os.clock() > invite.expires or from.Parent == nil then
		return { ok = false, message = "Trade request expired" }
	end
	if sessions[player] or sessions[from] then
		return { ok = false, message = "Already in a trade" }
	end
	local session: Session = {
		a = from,
		b = player,
		offers = { [from] = {}, [player] = {} },
		accepted = {},
		version = 1,
		busy = false,
	}
	sessions[from] = session
	sessions[player] = session
	push(session)
	return { ok = true }
end

local function setOffer(player: Player, rawOffer: any)
	local session = sessions[player]
	local profile = Registry.DataService.get(player)
	if not session or not profile or session.busy then
		return { ok = false, message = "Not in a trade" }
	end
	local offer, err = Trade.sanitizeOffer(profile, rawOffer)
	if not offer then
		return { ok = false, message = err }
	end
	session.offers[player] = offer
	session.accepted = {}
	session.version += 1
	push(session)
	return { ok = true }
end

local function accept(player: Player, version: any)
	local session = sessions[player]
	if not session or session.busy then
		return { ok = false, message = "Not in a trade" }
	end
	if version ~= session.version then
		return { ok = false, message = "The offer changed — review it again" }
	end
	session.accepted[player] = true
	local partner = partnerOf(session, player)
	if not session.accepted[partner] then
		push(session)
		return { ok = true }
	end

	session.busy = true
	local profileA = Registry.DataService.get(session.a)
	local profileB = Registry.DataService.get(session.b)
	if not profileA or not profileB then
		close(session, "Trade failed: a player left")
		return { ok = false, message = "Trade failed" }
	end
	local ok, message = Trade.execute(profileA, session.offers[session.a], profileB, session.offers[session.b])
	close(session, message)
	if ok then
		for _, participant in { session.a, session.b } do
			Registry.RewardService.checkProgress(participant, Registry.DataService.get(participant), os.time())
			Registry.DataService.changed(participant)
			Registry.AvatarService.refresh(participant)
			task.spawn(Registry.DataService.save, participant, false)
		end
	end
	return { ok = ok, message = message }
end

local function cancel(player: Player)
	local session = sessions[player]
	if session and not session.busy then
		close(session, `{player.DisplayName} cancelled the trade`)
	end
	return { ok = true }
end

function TradeService.init()
	local Request = Registry.RequestService
	Request.register("TradeRequest", request, 1)
	Request.register("TradeRespond", respond, 0.5)
	Request.register("TradeSetOffer", setOffer, 0.2)
	Request.register("TradeAccept", accept, 0.3)
	Request.register("TradeCancel", cancel, 0.3)

	Players.PlayerRemoving:Connect(function(player)
		local session = sessions[player]
		if session then
			session.busy = false
			close(session, "Trade cancelled: player left")
		end
		invites[player] = nil
		lastRequest[player] = nil
		for target, invite in invites do
			if invite.from == player then
				invites[target] = nil
			end
		end
	end)
end

return TradeService
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
