      <Item class="LocalScript" referent="44">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[-- Client bootstrap for Become An Millionaire RNG.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Sounds = require(Shared.Config.Sounds)

local State = require(script.State)
local UI = require(script.UI.UI)
local Scale = require(script.UI.Scale)
local Effects = require(script.UI.Effects)
local Notifications = require(script.UI.Notifications)
local Panels = require(script.UI.Panels)
local Hud = require(script.UI.Hud)
local World = require(script.World)
local TradePanel = require(script.Panels.Trade)

local player = Players.LocalPlayer

local screen = UI.new("ScreenGui", {
	Name = "MillionaireRNG",
	ResetOnSpawn = false,
	IgnoreGuiInset = false,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	ScreenInsets = Enum.ScreenInsets.DeviceSafeInsets,
	Parent = player:WaitForChild("PlayerGui"),
})

-- Loading screen until the first snapshot arrives.
local loading = UI.new("Frame", {
	Size = UDim2.fromScale(1, 1),
	BackgroundColor3 = UI.Theme.Background,
	ZIndex = 100,
	Parent = screen,
}, {
	UI.label({
		Text = "BECOME AN MILLIONAIRE RNG",
		Font = UI.Theme.Title,
		TextScaled = true,
		TextColor3 = UI.Theme.Gold,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.45),
		Size = UDim2.fromScale(0.7, 0.12),
		ZIndex = 101,
	}),
	UI.label({
		Text = "Loading your fortune…",
		TextSize = 20,
		TextColor3 = UI.Theme.Muted,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.56),
		Size = UDim2.fromScale(0.6, 0.05),
		ZIndex = 101,
	}),
})

UI.onClickSound = function()
	Effects.play(Sounds.Click, 1.2, 0.3)
end

Scale.init()
State.init()
Effects.mount(screen)
Notifications.mount(screen)
Notifications.init()
Panels.mount(screen)
Panels.init()
Hud.mount(screen)
Hud.init()
World.init()

Panels.register("Inventory", require(script.Panels.Inventory))
Panels.register("Upgrades", require(script.Panels.Upgrades))
Panels.register("Rebirth", require(script.Panels.Rebirth))
Panels.register("Daily", require(script.Panels.Daily))
Panels.register("Quests", require(script.Panels.Quests))
Panels.register("Zones", require(script.Panels.Zones))
Panels.register("Leaderboard", require(script.Panels.Leaderboard))
Panels.register("Trade", TradePanel)
Panels.register("Shop", require(script.Panels.Shop))
Panels.register("Codes", require(script.Panels.Codes))
Panels.register("Stats", require(script.Panels.Stats))
Panels.register("Settings", require(script.Panels.Settings))
TradePanel.init(screen)

-- Keep the default player list (shows Cash/Best/Rebirths) and chat; hide nothing else.
pcall(function()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList, true)
end)

local first = true
local function hideLoading()
	if first then
		first = false
		UI.tween(loading, 0.5, { BackgroundTransparency = 1 })
		for _, child in loading:GetChildren() do
			if child:IsA("TextLabel") then
				UI.tween(child, 0.5, { TextTransparency = 1 })
			end
		end
		task.delay(0.6, function()
			loading:Destroy()
		end)
	end
end
State.changed:connect(hideLoading)
if State.snapshot then
	hideLoading()
end
]]></string>
        </Properties>
        <Item class="Folder" referent="45">
          <Properties>
            <string name="Name">Panels</string>
          </Properties>
          <Item class="ModuleScript" referent="46">
            <Properties>
              <string name="Name">Codes</string>
              <string name="Source"><![CDATA[local State = require(script.Parent.Parent.State)
local UI = require(script.Parent.Parent.UI.UI)

local T = UI.Theme

return {
	title = "CODES",
	build = function(content: ScrollingFrame)
		UI.label({ Text = "Enter a code from our social pages for free rewards!", TextSize = 16, TextColor3 = T.Muted, LayoutOrder = 1, Parent = content })
		local box = UI.new("TextBox", {
			Size = UDim2.fromOffset(380, 50),
			BackgroundColor3 = T.Row,
			PlaceholderText = "Type code here",
			PlaceholderColor3 = T.Muted,
			Text = "",
			ClearTextOnFocus = false,
			TextColor3 = T.Text,
			Font = T.Bold,
			TextSize = 22,
			LayoutOrder = 2,
			Parent = content,
		}, { UI.corner(10), UI.stroke(T.Gold, 1.5, 0.3) })
		local function redeem()
			local code = box.Text
			if code:match("^%s*$") then
				State.notify:fire("Type a code first", "warning")
				return
			end
			local result = State.request("RedeemCode", code)
			if result.ok then
				box.Text = ""
			end
		end
		box.FocusLost:Connect(function(enterPressed)
			if enterPressed then
				redeem()
			end
		end)
		UI.button({ Text = "REDEEM", Size = UDim2.fromOffset(220, 48), LayoutOrder = 3, Parent = content }, redeem, "green")
	end,
	refresh = function() end,
}
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="47">
            <Properties>
              <string name="Name">Daily</string>
              <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local Formulas = require(Shared.Modules.Formulas)
local NumberFormat = require(Shared.Modules.NumberFormat)

local State = require(script.Parent.Parent.State)
local UI = require(script.Parent.Parent.UI.UI)

local T = UI.Theme

local function describe(reward, bestOrder: number): string
	local parts = {}
	local cash = Formulas.rewardCash(reward, bestOrder)
	if cash > 0 then
		table.insert(parts, "$" .. NumberFormat.short(cash))
	end
	if reward.luckBoost then
		table.insert(parts, `{reward.luckBoost.mult}x Luck {reward.luckBoost.minutes}m`)
	end
	return table.concat(parts, "\n+ ")
end

local function section(content: Instance, text: string, order: number)
	UI.label({ Text = text, Font = T.Title, TextSize = 19, TextColor3 = T.Gold, TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = order, Parent = content })
end

return {
	title = "DAILY REWARDS",
	live = true,
	refresh = function(content: ScrollingFrame)
		local snapshot = State.snapshot
		if not snapshot then
			return
		end
		local profile = snapshot.profile
		local now = State.now()
		UI.clear(content)

		-- Login streak
		section(content, `Login streak: {profile.daily.streak} day(s)`, 1)
		local track = UI.new("Frame", {
			Size = UDim2.new(1, -6, 0, 104),
			BackgroundTransparency = 1,
			LayoutOrder = 2,
			Parent = content,
		}, {
			UI.new("UIListLayout", {
				FillDirection = Enum.FillDirection.Horizontal,
				Padding = UDim.new(0, 6),
				HorizontalAlignment = Enum.HorizontalAlignment.Center,
				SortOrder = Enum.SortOrder.LayoutOrder,
			}),
		})
		local current = snapshot.loginIndex
		for day, reward in GameConfig.DailyLogin do
			local claimed = day < current or (day == current and not snapshot.canClaimLogin)
			local isToday = day == current
			UI.new("Frame", {
				Size = UDim2.new(1 / #GameConfig.DailyLogin, -6, 1, 0),
				BackgroundColor3 = if isToday then Color3.fromRGB(70, 56, 20) else T.Row,
				LayoutOrder = day,
				Parent = track,
			}, {
				UI.corner(10),
				UI.stroke(if isToday then T.Gold else T.Muted, if isToday then 2 else 1, if isToday then 0 else 0.7),
				UI.label({ Text = `Day {day}`, TextSize = 14, Font = T.Title, Size = UDim2.new(1, 0, 0, 20), Position = UDim2.fromOffset(0, 4), TextColor3 = if isToday then T.Gold else T.Text }),
				UI.label({ Text = describe(reward, profile.bestOrder), TextSize = 12, Size = UDim2.new(1, -6, 0, 50), Position = UDim2.fromOffset(3, 26), TextColor3 = T.Text }),
				UI.label({ Text = if claimed then "✔" else "", TextSize = 20, TextColor3 = T.Green, Size = UDim2.new(1, 0, 0, 22), Position = UDim2.new(0, 0, 1, -24) }),
			})
		end
		local claim = UI.button({
			Text = if snapshot.canClaimLogin then "CLAIM TODAY'S REWARD" else `NEXT IN {NumberFormat.duration(86400 - now % 86400)}`,
			Size = UDim2.fromOffset(320, 46),
			LayoutOrder = 3,
			Parent = content,
		}, function()
			State.request("ClaimDaily")
		end, "green")
		UI.setEnabled(claim, snapshot.canClaimLogin)

		-- Daily luck boost
		section(content, "Free daily luck boost", 4)
		local boostRow = UI.row(content, 56, 5)
		UI.label({
			Text = `{GameConfig.DailyLuckBoost.mult}x Luck for {GameConfig.DailyLuckBoost.minutes} minutes, once per day`,
			TextSize = 15,
			TextXAlignment = Enum.TextXAlignment.Left,
			Size = UDim2.new(1, -170, 1, 0),
			Position = UDim2.fromOffset(12, 0),
			Parent = boostRow,
		})
		local boostButton = UI.button({
			Text = if snapshot.canClaimBoost then "ACTIVATE" else "USED",
			Size = UDim2.fromOffset(140, 40),
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -10, 0.5, 0),
			Parent = boostRow,
		}, function()
			State.request("ClaimDailyBoost")
		end, "green")
		UI.setEnabled(boostButton, snapshot.canClaimBoost)

		-- Playtime rewards (estimated live from the last snapshot)
		local today = Formulas.dayNumber(now)
		local playSeconds = if profile.daily.playDay == today then profile.daily.playSeconds else 0
		playSeconds += math.max(0, now - State.receivedAt)
		section(content, `Playtime today: {NumberFormat.duration(playSeconds)}`, 6)
		for index, tier in GameConfig.PlaytimeRewards do
			local claimed = profile.daily.playDay == today and profile.daily.playClaimed[tostring(index)] == true
			local ready = playSeconds >= tier.minutes * 60
			local row = UI.row(content, 56, 6 + index)
			UI.label({
				Text = `{tier.minutes} min: {describe(tier.reward, profile.bestOrder):gsub("\n", " ")}`,
				TextSize = 15,
				TextXAlignment = Enum.TextXAlignment.Left,
				Size = UDim2.new(1, -170, 0, 24),
				Position = UDim2.fromOffset(12, 4),
				Parent = row,
			})
			local bar, set = UI.progressBar(row, T.Blue, 8)
			bar.Size = UDim2.new(1, -180, 0, 8)
			bar.Position = UDim2.fromOffset(12, 36)
			set(playSeconds / (tier.minutes * 60))
			local button = UI.button({
				Text = if claimed then "CLAIMED" elseif ready then "CLAIM" else NumberFormat.duration(tier.minutes * 60 - playSeconds),
				TextSize = 15,
				Size = UDim2.fromOffset(140, 40),
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -10, 0.5, 0),
				Parent = row,
			}, function()
				State.request("ClaimPlaytime", index)
			end, if ready and not claimed then "green" else "dark")
			UI.setEnabled(button, ready and not claimed)
		end

		-- Active boosts
		section(content, "Active boosts", 30)
		local any = false
		for source, boost in profile.boosts do
			if boost.expires > now then
				any = true
				local row = UI.row(content, 34, 31)
				UI.label({
					Text = `{boost.mult}x luck ({source}) — {NumberFormat.duration(boost.expires - now)} left`,
					TextSize = 15,
					TextColor3 = T.Green,
					Size = UDim2.new(1, -20, 1, 0),
					Position = UDim2.fromOffset(10, 0),
					Parent = row,
				})
			end
		end
		if not any then
			UI.label({ Text = "No active boosts", TextSize = 14, TextColor3 = T.Muted, LayoutOrder = 31, Parent = content })
		end
	end,
}
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="48">
            <Properties>
              <string name="Name">Inventory</string>
              <string name="Source"><![CDATA[-- Aura Index: every rarity, its live odds, what you own, and equip buttons.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Rarities = require(Shared.Config.Rarities)
local RNG = require(Shared.Modules.RNG)
local NumberFormat = require(Shared.Modules.NumberFormat)

local State = require(script.Parent.Parent.State)
local UI = require(script.Parent.Parent.UI.UI)

local T = UI.Theme

local function equipButton(parent: Instance, auraId: string, equipped: boolean)
	local button = UI.button({
		Text = if equipped then "EQUIPPED" else "EQUIP",
		TextSize = 15,
		Size = UDim2.fromOffset(110, 36),
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		Parent = parent,
	}, function()
		State.request("EquipAura", if equipped then "" else auraId)
	end, if equipped then "green" else "gold")
	return button
end

return {
	title = "AURA INDEX",
	refresh = function(content: ScrollingFrame)
		local snapshot = State.snapshot
		if not snapshot then
			return
		end
		local profile = snapshot.profile
		UI.clear(content)

		local discovered = 0
		for _ in profile.discovered do
			discovered += 1
		end
		UI.label({
			Text = `Discovered {discovered} / {Rarities.count} rarities  ·  Luck x{string.format("%.2f", snapshot.stats.luck)}`,
			TextSize = 17,
			TextColor3 = T.GoldLight,
			LayoutOrder = 0,
			Parent = content,
		})

		local probabilities = RNG.getProbabilities(snapshot.stats.luck)
		for index, rarity in Rarities.list do
			local known = profile.discovered[rarity.id] == true
			local row = UI.row(content, 58, index)
			UI.new("Frame", {
				Size = UDim2.new(0, 6, 1, -14),
				Position = UDim2.fromOffset(8, 7),
				BackgroundColor3 = if known then rarity.color else T.Muted,
				Parent = row,
			}, { UI.corner(3) })
			UI.label({
				Text = if known then rarity.name else "???",
				Font = T.Title,
				TextSize = 20,
				TextColor3 = if known then rarity.color else T.Muted,
				TextXAlignment = Enum.TextXAlignment.Left,
				Size = UDim2.new(0.45, 0, 0, 26),
				Position = UDim2.fromOffset(22, 4),
				Parent = row,
			})
			UI.label({
				Text = `{NumberFormat.odds(probabilities[index])}  ·  ${NumberFormat.short(rarity.minCash)}–${NumberFormat.short(rarity.maxCash)}`,
				TextSize = 13,
				TextColor3 = T.Muted,
				TextXAlignment = Enum.TextXAlignment.Left,
				Size = UDim2.new(0.6, 0, 0, 18),
				Position = UDim2.fromOffset(22, 32),
				Parent = row,
			})
			local owned = profile.inventory[rarity.id] or 0
			local rolled = profile.rarityCounts[rarity.id] or 0
			UI.label({
				Text = if rarity.hasAura then `Aura x{owned}\nRolled {rolled}` else `Rolled {rolled}\nNo aura`,
				TextSize = 13,
				TextColor3 = T.Text,
				Size = UDim2.fromOffset(100, 40),
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -128, 0.5, 0),
				Parent = row,
			})
			if rarity.hasAura and owned > 0 then
				equipButton(row, rarity.id, profile.equippedAura == rarity.id)
			end
		end

		if snapshot.passes.VIP then
			local row = UI.row(content, 58, 100)
			UI.label({
				Text = "VIP Golden Aura",
				Font = T.Title,
				TextSize = 20,
				TextColor3 = T.Gold,
				TextXAlignment = Enum.TextXAlignment.Left,
				Size = UDim2.new(0.6, 0, 1, 0),
				Position = UDim2.fromOffset(22, 0),
				Parent = row,
			})
			equipButton(row, "VIP", profile.equippedAura == "VIP")
		end
	end,
}
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="49">
            <Properties>
              <string name="Name">Leaderboard</string>
              <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local NumberFormat = require(Shared.Modules.NumberFormat)

local State = require(script.Parent.Parent.State)
local UI = require(script.Parent.Parent.UI.UI)

local T = UI.Theme

local tab = "server"
local requested = false

return {
	title = "LEADERBOARDS",
	onOpen = function()
		if not requested then
			requested = true
			task.spawn(function()
				local result = State.request("GetLeaderboard")
				if result.ok and result.data then
					State.leaderboard = result.data
					State.leaderboardChanged:fire(result.data)
				end
			end)
		end
	end,
	refresh = function(content: ScrollingFrame)
		UI.clear(content)
		local bar = UI.new("Frame", {
			Size = UDim2.new(1, -6, 0, 42),
			BackgroundTransparency = 1,
			LayoutOrder = 0,
			Parent = content,
		}, {
			UI.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8), HorizontalAlignment = Enum.HorizontalAlignment.Center }),
		})
		for _, option in { { "server", "Richest in Server" }, { "global", "All-Time (Global)" } } do
			UI.button({ Text = option[2], TextSize = 15, Size = UDim2.fromOffset(210, 38), Parent = bar }, function()
				tab = option[1]
				require(script.Parent.Parent.UI.Panels).refresh()
			end, if tab == option[1] then "gold" else "dark")
		end

		local entries = State.leaderboard[tab] or {}
		UI.label({
			Text = if tab == "server" then "Current cash of everyone in this server" else "Lifetime earnings across all servers (updates every 2 minutes)",
			TextSize = 13,
			TextColor3 = T.Muted,
			LayoutOrder = 1,
			Parent = content,
		})
		if #entries == 0 then
			UI.label({ Text = "Loading…", TextSize = 16, TextColor3 = T.Muted, LayoutOrder = 2, Parent = content })
		end
		local me = Players.LocalPlayer.UserId
		for rank, entry in entries do
			local row = UI.row(content, 40, 1 + rank)
			if entry.userId == me then
				row.BackgroundColor3 = Color3.fromRGB(70, 56, 20)
			end
			local medal = if rank == 1 then "🥇" elseif rank == 2 then "🥈" elseif rank == 3 then "🥉" else `#{rank}`
			UI.label({ Text = medal, TextSize = 18, Size = UDim2.fromOffset(50, 40), Position = UDim2.fromOffset(6, 0), Parent = row })
			UI.label({ Text = entry.name, TextSize = 16, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(0.6, -60, 1, 0), Position = UDim2.fromOffset(60, 0), Parent = row })
			UI.label({ Text = "$" .. NumberFormat.short(entry.value), Font = T.Title, TextSize = 17, TextColor3 = T.Gold, TextXAlignment = Enum.TextXAlignment.Right, Size = UDim2.new(0.4, -14, 1, 0), Position = UDim2.new(0.6, 0, 0, 0), Parent = row })
		end
	end,
}
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="50">
            <Properties>
              <string name="Name">Quests</string>
              <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local QuestConfig = require(Shared.Config.Quests)
local GameConfig = require(Shared.Config.GameConfig)
local Rarities = require(Shared.Config.Rarities)
local Formulas = require(Shared.Modules.Formulas)
local NumberFormat = require(Shared.Modules.NumberFormat)

local State = require(script.Parent.Parent.State)
local UI = require(script.Parent.Parent.UI.UI)

local T = UI.Theme

local tab = "Daily"

local function rewardText(reward, bestOrder: number): string
	local parts = {}
	local cash = Formulas.rewardCash(reward, bestOrder)
	if cash > 0 then
		table.insert(parts, "$" .. NumberFormat.short(cash))
	end
	if reward.luckBoost then
		table.insert(parts, `{reward.luckBoost.mult}x Luck {reward.luckBoost.minutes}m`)
	end
	return table.concat(parts, " + ")
end

local function questRow(content: Instance, order: number, text: string, progress: number, target: number, reward: string, done: boolean, claimable: boolean, onClaim: () -> ())
	local row = UI.row(content, 70, order)
	UI.label({ Text = text, Font = T.Bold, TextSize = 16, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, -170, 0, 22), Position = UDim2.fromOffset(12, 6), Parent = row })
	UI.label({ Text = "Reward: " .. reward, TextSize = 13, TextColor3 = T.GoldLight, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, -170, 0, 18), Position = UDim2.fromOffset(12, 28), Parent = row })
	local bar, set = UI.progressBar(row, if done then T.Green else T.Blue, 10)
	bar.Size = UDim2.new(1, -180, 0, 10)
	bar.Position = UDim2.fromOffset(12, 52)
	set(progress / math.max(target, 1))
	UI.label({ Text = `{NumberFormat.short(progress)}/{NumberFormat.short(target)}`, TextSize = 12, TextColor3 = T.Muted, Size = UDim2.fromOffset(80, 14), AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -168, 0, 36), TextXAlignment = Enum.TextXAlignment.Right, Parent = row })
	local button = UI.button({
		Text = if done then "DONE" elseif claimable then "CLAIM" else "IN PROGRESS",
		TextSize = 14,
		Size = UDim2.fromOffset(140, 40),
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		Parent = row,
	}, onClaim, if claimable then "green" else "dark")
	UI.setEnabled(button, claimable)
end

local function tabs(content: Instance)
	local bar = UI.new("Frame", {
		Size = UDim2.new(1, -6, 0, 42),
		BackgroundTransparency = 1,
		LayoutOrder = 0,
		Parent = content,
	}, {
		UI.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8), HorizontalAlignment = Enum.HorizontalAlignment.Center }),
	})
	for _, name in { "Daily", "Repeatable", "Achievements", "Milestones" } do
		UI.button({ Text = name, TextSize = 15, Size = UDim2.fromOffset(150, 38), Parent = bar }, function()
			tab = name
			require(script.Parent.Parent.UI.Panels).refresh()
		end, if tab == name then "gold" else "dark")
	end
end

return {
	title = "QUESTS",
	live = true,
	refresh = function(content: ScrollingFrame)
		local snapshot = State.snapshot
		if not snapshot then
			return
		end
		local profile = snapshot.profile
		UI.clear(content)
		tabs(content)

		if tab == "Daily" then
			UI.label({ Text = `New quests in {NumberFormat.duration(86400 - State.now() % 86400)}`, TextSize = 14, TextColor3 = T.Muted, LayoutOrder = 1, Parent = content })
			for index, entry in profile.quests.daily.list do
				local template = QuestConfig.DailyById[entry.id]
				if template then
					local text = template.text:gsub("{target}", NumberFormat.short(entry.target))
					questRow(content, 1 + index, text, entry.progress, entry.target, rewardText(template.reward, profile.bestOrder), entry.claimed, not entry.claimed and entry.progress >= entry.target, function()
						State.request("ClaimQuest", index)
					end)
				end
			end
		elseif tab == "Repeatable" then
			for index, template in QuestConfig.Repeatable do
				local state = profile.quests.repeatable[template.id]
				if state then
					local text = template.text:gsub("{target}", NumberFormat.short(state.target))
					questRow(content, index, `{text}  (stage {state.stage + 1})`, state.progress, state.target, rewardText(template.reward, profile.bestOrder), false, state.progress >= state.target, function()
						State.request("ClaimRepeatable", template.id)
					end)
				end
			end
		elseif tab == "Achievements" then
			local done = 0
			for _ in profile.achievements do
				done += 1
			end
			UI.label({ Text = `{done}/{#QuestConfig.Achievements} achievements · rewards are granted automatically`, TextSize = 14, TextColor3 = T.Muted, LayoutOrder = 1, Parent = content })
			for index, achievement in QuestConfig.Achievements do
				local earned = profile.achievements[achievement.id] == true
				local row = UI.row(content, 54, 1 + index)
				UI.label({ Text = (if earned then "🏅 " else "🔒 ") .. achievement.name, Font = T.Bold, TextSize = 16, TextColor3 = if earned then T.Gold else T.Text, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(0.6, 0, 0, 22), Position = UDim2.fromOffset(12, 6), Parent = row })
				local target = if achievement.target < 0 then Rarities.count else achievement.target
				UI.label({ Text = achievement.description, TextSize = 13, TextColor3 = T.Muted, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(0.6, 0, 0, 18), Position = UDim2.fromOffset(12, 28), Parent = row })
				UI.label({ Text = rewardText(achievement.reward, profile.bestOrder), TextSize = 13, TextColor3 = T.GoldLight, TextXAlignment = Enum.TextXAlignment.Right, Size = UDim2.new(0.4, -14, 1, 0), Position = UDim2.new(0.6, 0, 0, 0), Parent = row })
				local _ = target
			end
		else
			for index, milestone in GameConfig.RollMilestones do
				local reached = profile.milestones[tostring(milestone.rolls)] == true
				local row = UI.row(content, 50, index)
				UI.label({ Text = (if reached then "✔ " else "") .. `{NumberFormat.commas(milestone.rolls)} rolls`, Font = T.Bold, TextSize = 16, TextColor3 = if reached then T.Green else T.Text, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(0.4, 0, 1, 0), Position = UDim2.fromOffset(12, 0), Parent = row })
				UI.label({ Text = rewardText(milestone.reward, profile.bestOrder), TextSize = 14, TextColor3 = T.GoldLight, TextXAlignment = Enum.TextXAlignment.Right, Size = UDim2.new(0.6, -14, 1, 0), Position = UDim2.new(0.4, 0, 0, 0), Parent = row })
			end
		end
	end,
}
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="51">
            <Properties>
              <string name="Name">Rebirth</string>
              <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local Upgrades = require(Shared.Config.Upgrades)
local Formulas = require(Shared.Modules.Formulas)
local NumberFormat = require(Shared.Modules.NumberFormat)

local State = require(script.Parent.Parent.State)
local UI = require(script.Parent.Parent.UI.UI)

local T = UI.Theme

local confirmUntil = 0

return {
	title = "REBIRTH",
	onOpen = function()
		confirmUntil = 0
	end,
	refresh = function(content: ScrollingFrame)
		local snapshot = State.snapshot
		if not snapshot then
			return
		end
		local profile = snapshot.profile
		local rebirths = profile.rebirths
		local cost = Formulas.rebirthCost(rebirths)
		local cfg = GameConfig.Rebirth
		UI.clear(content)

		UI.label({ Text = `Rebirth {rebirths}`, Font = T.Title, TextSize = 34, TextColor3 = T.Purple, Size = UDim2.new(1, 0, 0, 40), LayoutOrder = 1, Parent = content })
		local bonus = UI.row(content, 96, 2)
		UI.label({
			Text = string.format(
				"Current permanent bonus: <b>+%d%% cash</b>, <b>+%d%% luck</b>\nAfter rebirth: <font color=\"#50D278\"><b>+%d%% cash</b>, <b>+%d%% luck</b></font>",
				math.floor(rebirths * cfg.cashBonusPer * 100 + 0.5),
				math.floor(rebirths * cfg.luckBonusPer * 100 + 0.5),
				math.floor((rebirths + 1) * cfg.cashBonusPer * 100 + 0.5),
				math.floor((rebirths + 1) * cfg.luckBonusPer * 100 + 0.5)
			),
			RichText = true,
			TextSize = 17,
			Size = UDim2.new(1, -20, 1, -10),
			Position = UDim2.fromOffset(10, 5),
			Parent = bonus,
		})

		local resets = {}
		for _, upgrade in Upgrades.list do
			if not upgrade.keepOnRebirth then
				table.insert(resets, upgrade.name)
			end
		end
		UI.label({
			Text = "Resets: cash and " .. table.concat(resets, ", ") .. ".\nKeeps: auras, index, zones, lifetime earnings, Passive Income, achievements.",
			TextSize = 14,
			TextColor3 = T.Muted,
			Size = UDim2.new(1, -20, 0, 40),
			LayoutOrder = 3,
			Parent = content,
		})

		local progressRow = UI.row(content, 56, 4)
		UI.label({
			Text = `${NumberFormat.short(profile.cash)} / ${NumberFormat.short(cost)}`,
			TextSize = 16,
			Size = UDim2.new(1, -20, 0, 22),
			Position = UDim2.fromOffset(10, 4),
			Parent = progressRow,
		})
		local bar, setProgress = UI.progressBar(progressRow, T.Purple, 14)
		bar.Size = UDim2.new(1, -20, 0, 14)
		bar.Position = UDim2.fromOffset(10, 32)
		setProgress(profile.cash / cost)

		local maxed = rebirths >= cfg.maxRebirths
		local canAfford = profile.cash >= cost
		local confirming = os.clock() < confirmUntil
		local button = UI.button({
			Text = if maxed then "MAX REBIRTH" elseif confirming then "CLICK AGAIN TO CONFIRM" else `REBIRTH FOR ${NumberFormat.short(cost)}`,
			Size = UDim2.fromOffset(340, 54),
			TextSize = 20,
			LayoutOrder = 5,
			Parent = content,
		}, function()
			if os.clock() < confirmUntil then
				confirmUntil = 0
				State.request("Rebirth")
			else
				confirmUntil = os.clock() + 4
				local panels = require(script.Parent.Parent.UI.Panels)
				panels.refresh()
				task.delay(4.1, panels.refresh)
			end
		end, if confirming then "red" else "purple")
		UI.setEnabled(button, canAfford and not maxed)
	end,
}
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="52">
            <Properties>
              <string name="Name">Settings</string>
              <string name="Source"><![CDATA[local State = require(script.Parent.Parent.State)
local UI = require(script.Parent.Parent.UI.UI)

local T = UI.Theme

local OPTIONS = {
	{ key = "effects", name = "Visual effects", description = "Flashes, bursts and cinematic reveals" },
	{ key = "shake", name = "Camera shake", description = "Shake the camera on rare rolls" },
	{ key = "sounds", name = "Sounds", description = "Roll, reveal and UI sounds" },
	{ key = "hideOtherAuras", name = "Hide other players' auras", description = "Improves performance in busy servers" },
	{ key = "autoRollSkipReveal", name = "Skip roll animations", description = "Instant results below Millionaire (rare rolls still play)" },
}

return {
	title = "SETTINGS",
	refresh = function(content: ScrollingFrame)
		local profile = State.profile()
		if not profile then
			return
		end
		UI.clear(content)
		for index, option in OPTIONS do
			local value = profile.settings[option.key] == true
			local row = UI.row(content, 60, index)
			UI.label({ Text = option.name, Font = T.Bold, TextSize = 17, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, -150, 0, 24), Position = UDim2.fromOffset(12, 6), Parent = row })
			UI.label({ Text = option.description, TextSize = 13, TextColor3 = T.Muted, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, -150, 0, 20), Position = UDim2.fromOffset(12, 32), Parent = row })
			UI.button({
				Text = if value then "ON" else "OFF",
				Size = UDim2.fromOffset(100, 40),
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -10, 0.5, 0),
				Parent = row,
			}, function()
				State.request("SetSetting", option.key, not value)
			end, if value then "green" else "dark")
		end
		UI.label({ Text = "Settings are saved to your account.", TextSize = 13, TextColor3 = T.Muted, LayoutOrder = 99, Parent = content })
	end,
}
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="53">
            <Properties>
              <string name="Name">Shop</string>
              <string name="Source"><![CDATA[-- Optional Robux purchases. Buttons call the server, which opens the real
-- Roblox purchase prompt; rewards are granted only by the server after
-- Roblox confirms payment. Items without a configured id say so honestly.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Monetization = require(Shared.Config.Monetization)

local State = require(script.Parent.Parent.State)
local UI = require(script.Parent.Parent.UI.UI)

local T = UI.Theme

local function item(content: Instance, order: number, name: string, description: string, priceHint: number, configured: boolean, owned: boolean, onBuy: () -> ())
	local row = UI.row(content, 64, order)
	UI.label({ Text = name, Font = T.Title, TextSize = 18, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, -180, 0, 24), Position = UDim2.fromOffset(12, 6), Parent = row })
	UI.label({ Text = description, TextSize = 13, TextColor3 = T.Muted, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, -180, 0, 30), Position = UDim2.fromOffset(12, 30), Parent = row })
	local text = if owned then "OWNED" elseif configured then `R$ {priceHint}` else "COMING SOON"
	local button = UI.button({
		Text = text,
		TextSize = 15,
		Size = UDim2.fromOffset(150, 42),
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.5, 0),
		Parent = row,
	}, onBuy, if owned then "green" elseif configured then "gold" else "dark")
	UI.setEnabled(button, configured and not owned)
end

return {
	title = "SHOP",
	refresh = function(content: ScrollingFrame)
		local snapshot = State.snapshot
		if not snapshot then
			return
		end
		UI.clear(content)
		UI.label({
			Text = "Everything in the game can be earned for free. These are optional perks — prices shown are set on Roblox.",
			TextSize = 14,
			TextColor3 = T.Muted,
			Size = UDim2.new(1, -10, 0, 36),
			LayoutOrder = 0,
			Parent = content,
		})
		UI.label({ Text = "GAME PASSES (permanent)", Font = T.Title, TextSize = 18, TextColor3 = T.Gold, LayoutOrder = 1, Parent = content })
		for index, pass in Monetization.Passes do
			item(content, 1 + index, pass.name, pass.description, pass.priceHint, pass.id ~= 0, snapshot.passes[pass.key] == true, function()
				State.request("BuyPass", pass.key)
			end)
		end
		UI.label({ Text = "BOOSTS (one-time use)", Font = T.Title, TextSize = 18, TextColor3 = T.Gold, LayoutOrder = 20, Parent = content })
		for index, product in Monetization.Products do
			item(content, 20 + index, product.name, product.description, product.priceHint, product.id ~= 0, false, function()
				State.request("BuyProduct", product.key)
			end)
		end
	end,
}
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="54">
            <Properties>
              <string name="Name">Stats</string>
              <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Rarities = require(Shared.Config.Rarities)
local Formulas = require(Shared.Modules.Formulas)
local NumberFormat = require(Shared.Modules.NumberFormat)

local State = require(script.Parent.Parent.State)
local UI = require(script.Parent.Parent.UI.UI)

local T = UI.Theme

return {
	title = "STATISTICS",
	refresh = function(content: ScrollingFrame)
		local snapshot = State.snapshot
		if not snapshot then
			return
		end
		local profile = snapshot.profile
		local stats = snapshot.stats
		UI.clear(content)
		local best = Rarities.list[profile.bestOrder]
		local lines = {
			{ "Wealth title", Formulas.wealthTitle(profile.lifetime) },
			{ "Cash", "$" .. NumberFormat.commas(profile.cash) },
			{ "Lifetime earnings", "$" .. NumberFormat.short(profile.lifetime) },
			{ "Total rolls", NumberFormat.commas(profile.totalRolls) },
			{ "Best rarity", if best then best.name else "-" },
			{ "Best single roll", "$" .. NumberFormat.short(profile.bestCash) },
			{ "Rebirths", tostring(profile.rebirths) },
			{ "Luck", string.format("x%.2f", stats.luck) },
			{ "Cash multiplier", string.format("x%.2f", stats.cashMultiplier) },
			{ "Roll cooldown", string.format("%.2fs", stats.cooldown) },
			{ "Rolls per click", tostring(stats.rollsPerClick) },
			{ "Time played", NumberFormat.duration(profile.stats.playSeconds) },
			{ "Trades completed", tostring(profile.stats.trades) },
		}
		for index, line in lines do
			local row = UI.row(content, 34, index)
			UI.label({ Text = line[1], TextSize = 16, TextColor3 = T.Muted, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(0.5, -10, 1, 0), Position = UDim2.fromOffset(12, 0), Parent = row })
			UI.label({ Text = line[2], TextSize = 16, TextXAlignment = Enum.TextXAlignment.Right, Size = UDim2.new(0.5, -12, 1, 0), Position = UDim2.new(0.5, 0, 0, 0), Parent = row })
		end
		UI.label({ Text = "Rolls by rarity", Font = T.Title, TextSize = 18, TextColor3 = T.Gold, LayoutOrder = 50, Parent = content })
		for index, rarity in Rarities.list do
			local count = profile.rarityCounts[rarity.id] or 0
			local row = UI.row(content, 30, 50 + index)
			UI.label({ Text = if profile.discovered[rarity.id] then rarity.name else "???", TextSize = 15, TextColor3 = if profile.discovered[rarity.id] then rarity.color else T.Muted, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(0.6, 0, 1, 0), Position = UDim2.fromOffset(12, 0), Parent = row })
			UI.label({ Text = NumberFormat.commas(count), TextSize = 15, TextXAlignment = Enum.TextXAlignment.Right, Size = UDim2.new(0.4, -12, 1, 0), Position = UDim2.new(0.6, 0, 0, 0), Parent = row })
		end
	end,
}
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="55">
            <Properties>
              <string name="Name">Trade</string>
              <string name="Source"><![CDATA[-- Aura trading UI. The server validates every offer and executes the swap;
-- this panel only displays the session and sends requests.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Rarities = require(Shared.Config.Rarities)

local State = require(script.Parent.Parent.State)
local UI = require(script.Parent.Parent.UI.UI)

local T = UI.Theme

local session: { [string]: any }? = nil
local popup: Frame? = nil
local screenRef: ScreenGui? = nil

local function panels()
	return require(script.Parent.Parent.UI.Panels)
end

local function offerText(offer: { [string]: number }?): string
	if not offer or next(offer) == nil then
		return "(nothing)"
	end
	local parts = {}
	for _, rarity in Rarities.list do
		local count = offer[rarity.id]
		if count and count > 0 then
			table.insert(parts, `<font color="#{rarity.color:ToHex()}">{rarity.name}</font> x{count}`)
		end
	end
	return table.concat(parts, "\n")
end

local function changeOffer(rarityId: string, delta: number)
	if not session then
		return
	end
	local profile = State.profile()
	if not profile then
		return
	end
	local offer = table.clone(session.myOffer or {})
	local owned = profile.inventory[rarityId] or 0
	offer[rarityId] = math.clamp((offer[rarityId] or 0) + delta, 0, owned)
	if offer[rarityId] == 0 then
		offer[rarityId] = nil
	end
	State.request("TradeSetOffer", offer)
end

local function showInvite(payload)
	if not screenRef then
		return
	end
	if popup then
		popup:Destroy()
	end
	local frame = UI.new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 200),
		Size = UDim2.fromOffset(380, 130),
		BackgroundColor3 = T.Panel,
		ZIndex = 30,
		Parent = screenRef,
	}, {
		UI.corner(14),
		UI.stroke(T.Gold, 2, 0.1),
		UI.label({ Text = `{payload.fromName} wants to trade auras with you`, TextSize = 17, Size = UDim2.new(1, -20, 0, 50), Position = UDim2.fromOffset(10, 8), ZIndex = 31 }),
	})
	local scale = require(script.Parent.Parent.UI.Scale)
	scale.attach(frame)
	popup = frame
	local function respond(accept: boolean)
		frame:Destroy()
		popup = nil
		local result = State.request("TradeRespond", payload.fromUserId, accept)
		if accept and result.ok then
			panels().open("Trade")
		end
	end
	UI.button({ Text = "ACCEPT", Size = UDim2.fromOffset(160, 44), Position = UDim2.fromOffset(20, 70), ZIndex = 31, Parent = frame }, function()
		respond(true)
	end, "green")
	UI.button({ Text = "DECLINE", Size = UDim2.fromOffset(160, 44), Position = UDim2.fromOffset(200, 70), ZIndex = 31, Parent = frame }, function()
		respond(false)
	end, "red")
	task.delay(30, function()
		if popup == frame then
			frame:Destroy()
			popup = nil
		end
	end)
end

local function refreshIdle(content: ScrollingFrame)
	UI.label({ Text = "Trade collectible auras with players in this server. Cash cannot be traded.", TextSize = 14, TextColor3 = T.Muted, Size = UDim2.new(1, -10, 0, 36), LayoutOrder = 0, Parent = content })
	local others = 0
	for index, player in Players:GetPlayers() do
		if player ~= Players.LocalPlayer then
			others += 1
			local row = UI.row(content, 50, index)
			UI.label({ Text = player.DisplayName, Font = T.Bold, TextSize = 17, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, -170, 1, 0), Position = UDim2.fromOffset(12, 0), Parent = row })
			UI.button({ Text = "SEND REQUEST", TextSize = 14, Size = UDim2.fromOffset(150, 38), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Parent = row }, function()
				State.request("TradeRequest", player.UserId)
			end, "gold")
		end
	end
	if others == 0 then
		UI.label({ Text = "No other players in this server yet.", TextSize = 16, TextColor3 = T.Muted, LayoutOrder = 1, Parent = content })
	end
end

local function refreshSession(content: ScrollingFrame, current: { [string]: any })
	local profile = State.profile()
	if not profile then
		return
	end
	UI.label({ Text = `Trading with {current.partnerName}`, Font = T.Title, TextSize = 20, TextColor3 = T.Gold, LayoutOrder = 0, Parent = content })

	local offers = UI.new("Frame", { Size = UDim2.new(1, -6, 0, 130), BackgroundTransparency = 1, LayoutOrder = 1, Parent = content })
	for column, data in { { "Your offer", current.myOffer, current.myAccepted }, { current.partnerName .. "'s offer", current.theirOffer, current.theirAccepted } } do
		UI.new("Frame", {
			Size = UDim2.new(0.5, -6, 1, 0),
			Position = UDim2.new((column - 1) * 0.5, (column - 1) * 6, 0, 0),
			BackgroundColor3 = T.Row,
			Parent = offers,
		}, {
			UI.corner(10),
			UI.stroke(if data[3] then T.Green else T.Gold, 2, if data[3] then 0 else 0.6),
			UI.label({ Text = data[1] .. (if data[3] then "  ✔ READY" else ""), Font = T.Bold, TextSize = 15, TextColor3 = if data[3] then T.Green else T.Text, Size = UDim2.new(1, -10, 0, 22), Position = UDim2.fromOffset(5, 4) }),
			UI.label({ Text = offerText(data[2]), RichText = true, TextSize = 14, Size = UDim2.new(1, -10, 1, -30), Position = UDim2.fromOffset(5, 28), TextYAlignment = Enum.TextYAlignment.Top }),
		})
	end

	local actions = UI.new("Frame", { Size = UDim2.new(1, -6, 0, 48), BackgroundTransparency = 1, LayoutOrder = 2, Parent = content }, {
		UI.new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 10), HorizontalAlignment = Enum.HorizontalAlignment.Center }),
	})
	local accept = UI.button({ Text = if current.myAccepted then "WAITING…" else "ACCEPT TRADE", Size = UDim2.fromOffset(200, 44), Parent = actions }, function()
		State.request("TradeAccept", current.version)
	end, "green")
	UI.setEnabled(accept, not current.myAccepted)
	UI.button({ Text = "CANCEL", Size = UDim2.fromOffset(140, 44), Parent = actions }, function()
		State.request("TradeCancel")
	end, "red")

	UI.label({ Text = "Your auras (tap + / − to change your offer)", TextSize = 14, TextColor3 = T.Muted, LayoutOrder = 3, Parent = content })
	local any = false
	for index, rarity in Rarities.list do
		local owned = profile.inventory[rarity.id] or 0
		if rarity.hasAura and owned > 0 then
			any = true
			local offered = (current.myOffer and current.myOffer[rarity.id]) or 0
			local row = UI.row(content, 44, 10 + index)
			UI.label({ Text = `{rarity.name}  ({offered}/{owned} offered)`, TextSize = 15, TextColor3 = rarity.color, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, -140, 1, 0), Position = UDim2.fromOffset(12, 0), Parent = row })
			local minus = UI.button({ Text = "−", TextSize = 22, Size = UDim2.fromOffset(52, 34), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -66, 0.5, 0), Parent = row }, function()
				changeOffer(rarity.id, -1)
			end, "dark")
			UI.setEnabled(minus, offered > 0)
			local plus = UI.button({ Text = "+", TextSize = 22, Size = UDim2.fromOffset(52, 34), AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Parent = row }, function()
				changeOffer(rarity.id, 1)
			end, "gold")
			UI.setEnabled(plus, offered < owned)
		end
	end
	if not any then
		UI.label({ Text = "You don't own any auras yet — roll Comfortable or rarer to collect them.", TextSize = 14, TextColor3 = T.Muted, LayoutOrder = 11, Parent = content })
	end
end

local Trade = {
	title = "TRADING",
	refresh = function(content: ScrollingFrame)
		UI.clear(content)
		if session then
			refreshSession(content, session)
		else
			refreshIdle(content)
		end
	end,
}

function Trade.init(screen: ScreenGui)
	screenRef = screen
	State.tradeEvent:connect(function(payload)
		if payload.type == "invite" then
			showInvite(payload)
		elseif payload.type == "update" then
			session = payload
			if panels().current ~= "Trade" then
				panels().open("Trade")
			else
				panels().refresh()
			end
		elseif payload.type == "closed" then
			session = nil
			State.notify:fire(payload.reason, "info")
			panels().refresh()
		end
	end)
	Players.PlayerAdded:Connect(function()
		panels().refresh()
	end)
	Players.PlayerRemoving:Connect(function()
		panels().refresh()
	end)
end

return Trade
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="56">
            <Properties>
              <string name="Name">Upgrades</string>
              <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Upgrades = require(Shared.Config.Upgrades)
local Formulas = require(Shared.Modules.Formulas)
local NumberFormat = require(Shared.Modules.NumberFormat)

local State = require(script.Parent.Parent.State)
local UI = require(script.Parent.Parent.UI.UI)

local T = UI.Theme

local function effectText(id: string, level: number): string
	local upgrade = Upgrades.byId[id]
	if id == "Luck" then
		return string.format("+%d%% luck", math.floor(level * upgrade.perLevel * 100 + 0.5))
	elseif id == "Cash" then
		return string.format("+%d%% cash", math.floor(level * upgrade.perLevel * 100 + 0.5))
	elseif id == "Speed" then
		return string.format("-%d%% cooldown", math.floor(level * upgrade.perLevel * 100 + 0.5))
	elseif id == "Capacity" then
		return `{1 + level} roll(s) per click`
	elseif id == "Offline" then
		return if level == 0 then "Off" else `Level {level} passive income`
	end
	return ""
end

return {
	title = "UPGRADES",
	refresh = function(content: ScrollingFrame)
		local snapshot = State.snapshot
		if not snapshot then
			return
		end
		local profile = snapshot.profile
		UI.clear(content)
		UI.label({
			Text = `Cash: ${NumberFormat.short(profile.cash)}  ·  Cooldown {string.format("%.2f", snapshot.stats.cooldown)}s  ·  Cash x{string.format("%.2f", snapshot.stats.cashMultiplier)}`,
			TextSize = 16,
			TextColor3 = T.GoldLight,
			LayoutOrder = 0,
			Parent = content,
		})
		for _, upgrade in Upgrades.list do
			local level = profile.upgrades[upgrade.id] or 0
			local maxed = level >= upgrade.maxLevel
			local cost = if maxed then 0 else Formulas.upgradeCost(upgrade.id, level)
			local row = UI.row(content, 74, upgrade.order)
			UI.label({
				Text = `{upgrade.name}  <font color="#A8A096">Lv {level}/{upgrade.maxLevel}</font>`,
				RichText = true,
				Font = T.Title,
				TextSize = 19,
				TextXAlignment = Enum.TextXAlignment.Left,
				Size = UDim2.new(0.6, 0, 0, 24),
				Position = UDim2.fromOffset(14, 6),
				Parent = row,
			})
			UI.label({
				Text = upgrade.description .. (if upgrade.keepOnRebirth then " · kept on rebirth" else ""),
				TextSize = 13,
				TextColor3 = T.Muted,
				TextXAlignment = Enum.TextXAlignment.Left,
				Size = UDim2.new(0.6, 0, 0, 18),
				Position = UDim2.fromOffset(14, 30),
				Parent = row,
			})
			UI.label({
				Text = `Now: {effectText(upgrade.id, level)}` .. (if maxed then "" else `  →  {effectText(upgrade.id, level + 1)}`),
				TextSize = 13,
				TextColor3 = T.Green,
				TextXAlignment = Enum.TextXAlignment.Left,
				Size = UDim2.new(0.62, 0, 0, 18),
				Position = UDim2.fromOffset(14, 50),
				Parent = row,
			})
			local buy = UI.button({
				Text = if maxed then "MAX" else "$" .. NumberFormat.short(cost),
				TextSize = 16,
				Size = UDim2.fromOffset(110, 40),
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -78, 0.5, 0),
				Parent = row,
			}, function()
				State.request("BuyUpgrade", upgrade.id)
			end, if maxed then "dark" else "gold")
			UI.setEnabled(buy, not maxed and profile.cash >= cost)
			local max = UI.button({
				Text = "MAX",
				TextSize = 14,
				Size = UDim2.fromOffset(60, 40),
				AnchorPoint = Vector2.new(1, 0.5),
				Position = UDim2.new(1, -10, 0.5, 0),
				Parent = row,
			}, function()
				State.request("BuyUpgradeMax", upgrade.id)
			end, "blue")
			UI.setEnabled(max, not maxed and profile.cash >= cost)
		end
	end,
}
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="57">
            <Properties>
              <string name="Name">Zones</string>
              <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared.Config.GameConfig)
local NumberFormat = require(Shared.Modules.NumberFormat)

local State = require(script.Parent.Parent.State)
local UI = require(script.Parent.Parent.UI.UI)

local T = UI.Theme

return {
	title = "WEALTH ZONES",
	refresh = function(content: ScrollingFrame)
		local snapshot = State.snapshot
		if not snapshot then
			return
		end
		local profile = snapshot.profile
		UI.clear(content)
		UI.label({ Text = "Zone bonuses apply while you stand in the zone. Travel instantly once unlocked.", TextSize = 14, TextColor3 = T.Muted, Size = UDim2.new(1, -10, 0, 36), LayoutOrder = 0, Parent = content })
		for index, zone in GameConfig.Zones do
			local unlocked = profile.zones[zone.id] == true
			local here = snapshot.stats.zoneId == zone.id
			local row = UI.row(content, 76, index)
			row.BackgroundColor3 = if here then Color3.fromRGB(40, 52, 40) else T.Row
			UI.new("Frame", { Size = UDim2.new(0, 6, 1, -14), Position = UDim2.fromOffset(8, 7), BackgroundColor3 = zone.color, Parent = row }, { UI.corner(3) })
			UI.label({ Text = zone.name .. (if here then "  (you are here)" else ""), Font = T.Title, TextSize = 19, TextColor3 = zone.color, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, -330, 0, 26), Position = UDim2.fromOffset(22, 6), Parent = row })
			UI.label({ Text = zone.description, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, -330, 0, 20), Position = UDim2.fromOffset(22, 32), Parent = row })
			local requirement = if unlocked then "Unlocked" else `Cost ${NumberFormat.short(zone.cost)}` .. (if zone.requiredRebirths > 0 then ` · needs {zone.requiredRebirths} rebirth(s)` else "")
			UI.label({ Text = requirement, TextSize = 13, TextColor3 = if unlocked then T.Green else T.Muted, TextXAlignment = Enum.TextXAlignment.Left, Size = UDim2.new(1, -330, 0, 18), Position = UDim2.fromOffset(22, 52), Parent = row })

			if unlocked then
				local travel = UI.button({
					Text = if here then "HERE" else "TRAVEL",
					TextSize = 15,
					Size = UDim2.fromOffset(130, 42),
					AnchorPoint = Vector2.new(1, 0.5),
					Position = UDim2.new(1, -10, 0.5, 0),
					Parent = row,
				}, function()
					local result = State.request("TravelZone", zone.id)
					if result.ok then
						require(script.Parent.Parent.UI.Panels).close()
					end
				end, "blue")
				UI.setEnabled(travel, not here)
			else
				local canAfford = profile.cash >= zone.cost and profile.rebirths >= zone.requiredRebirths
				local unlock = UI.button({
					Text = "UNLOCK",
					TextSize = 15,
					Size = UDim2.fromOffset(130, 42),
					AnchorPoint = Vector2.new(1, 0.5),
					Position = UDim2.new(1, -10, 0.5, 0),
					Parent = row,
				}, function()
					State.request("UnlockZone", zone.id)
				end, "gold")
				UI.setEnabled(unlock, canAfford)
			end
		end
	end,
}
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="58">
          <Properties>
            <string name="Name">State</string>
            <string name="Source"><![CDATA[-- Client-side mirror of the server state. Read-only: every change goes
-- through State.request, and the server answers with a new snapshot.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Modules.Remotes)

export type Snapshot = {
	profile: { [string]: any },
	stats: { [string]: any },
	passes: { [string]: boolean },
	serverLuck: { mult: number, expires: number },
	serverTime: number,
	loginIndex: number,
	canClaimLogin: boolean,
	canClaimBoost: boolean,
	autoRoll: boolean,
	temporary: boolean,
}

local State = {}

State.snapshot = nil :: Snapshot?
State.leaderboard = { server = {}, global = {} }
State.receivedAt = 0

-- Tiny signal implementation
local function signal()
	local listeners: { (...any) -> () } = {}
	return {
		connect = function(_, fn: (...any) -> ())
			table.insert(listeners, fn)
			return function()
				local index = table.find(listeners, fn)
				if index then
					table.remove(listeners, index)
				end
			end
		end,
		fire = function(_, ...)
			for _, fn in table.clone(listeners) do
				task.spawn(fn, ...)
			end
		end,
	}
end

State.changed = signal()
State.rollResult = signal()
State.leaderboardChanged = signal()
State.tradeEvent = signal()
State.notify = signal() -- (text, kind)
State.announce = signal() -- (payload)

local requestRemote = Remotes.func("Request")

function State.now(): number
	return workspace:GetServerTimeNow()
end

function State.profile(): { [string]: any }?
	return State.snapshot and State.snapshot.profile
end

-- Sends a request; shows the server's message as a toast unless `silent`.
function State.request(action: string, ...: any): { ok: boolean, message: string?, data: any? }
	local ok, result = pcall(requestRemote.InvokeServer, requestRemote, action, ...)
	if not ok or type(result) ~= "table" then
		State.notify:fire("Connection problem, try again", "error")
		return { ok = false }
	end
	if result.message then
		State.notify:fire(result.message, if result.ok then "success" else "error")
	end
	return result
end

function State.init()
	Remotes.event("State").OnClientEvent:Connect(function(snapshot)
		State.snapshot = snapshot
		State.receivedAt = State.now()
		State.changed:fire(snapshot)
	end)
	Remotes.event("RollResult").OnClientEvent:Connect(function(result)
		State.rollResult:fire(result)
	end)
	Remotes.event("Notify").OnClientEvent:Connect(function(payload)
		State.notify:fire(payload.text, payload.kind)
	end)
	Remotes.event("Announce").OnClientEvent:Connect(function(payload)
		State.announce:fire(payload)
	end)
	Remotes.event("Trade").OnClientEvent:Connect(function(payload)
		State.tradeEvent:fire(payload)
	end)
	Remotes.event("Leaderboard").OnClientEvent:Connect(function(payload)
		State.leaderboard = payload
		State.leaderboardChanged:fire(payload)
	end)
end

return State
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="59">
          <Properties>
            <string name="Name">UI</string>
          </Properties>
          <Item class="ModuleScript" referent="60">
            <Properties>
              <string name="Name">Effects</string>
              <string name="Source"><![CDATA[-- Screen effects and sounds. Every effect checks the player's settings, is
-- short, and never blocks input.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")

local State = require(script.Parent.Parent.State)
local UI = require(script.Parent.UI)

local Effects = {}

local layer: Frame
local soundCache: { [string]: Sound } = {}

local function setting(name: string): boolean
	local profile = State.profile()
	if not profile then
		return true
	end
	return profile.settings[name] ~= false
end

function Effects.mount(screen: ScreenGui)
	layer = UI.new("Frame", {
		Name = "Effects",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		ZIndex = 50,
		Parent = screen,
	})
end

function Effects.play(id: string, speed: number?, volume: number?)
	if not setting("sounds") or id == "" then
		return
	end
	local sound = soundCache[id .. tostring(speed)]
	if not sound then
		sound = Instance.new("Sound")
		sound.SoundId = id
		sound.Parent = SoundService
		soundCache[id .. tostring(speed)] = sound
	end
	sound.PlaybackSpeed = speed or 1
	sound.Volume = volume or 0.5
	SoundService:PlayLocalSound(sound)
end

function Effects.flash(color: Color3, strength: number?, duration: number?)
	if not setting("effects") then
		return
	end
	local frame = UI.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = color,
		BackgroundTransparency = 1 - (strength or 0.6),
		ZIndex = 51,
		Parent = layer,
	})
	UI.tween(frame, duration or 0.5, { BackgroundTransparency = 1 }).Completed:Connect(function()
		frame:Destroy()
	end)
end

local shaking = false
function Effects.shake(intensity: number, duration: number)
	if not setting("shake") or not setting("effects") or shaking then
		return
	end
	local character = Players.LocalPlayer.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end
	shaking = true
	local started = os.clock()
	local connection
	connection = RunService.RenderStepped:Connect(function()
		local elapsed = os.clock() - started
		if elapsed >= duration or humanoid.Parent == nil then
			humanoid.CameraOffset = Vector3.zero
			connection:Disconnect()
			shaking = false
			return
		end
		local falloff = 1 - elapsed / duration
		local amount = intensity * falloff * 0.25
		humanoid.CameraOffset = Vector3.new((math.random() - 0.5) * amount, (math.random() - 0.5) * amount, 0)
	end)
end

-- Coins/sparkles flying out from the centre of the screen.
function Effects.burst(color: Color3, count: number, origin: UDim2?)
	if not setting("effects") then
		return
	end
	local start = origin or UDim2.fromScale(0.5, 0.45)
	for _ = 1, count do
		local symbol = if math.random() < 0.6 then "$" else "✦"
		local piece = UI.label({
			Text = symbol,
			TextColor3 = if math.random() < 0.5 then color else UI.Theme.GoldLight,
			TextSize = math.random(18, 34),
			Font = UI.Theme.Title,
			Size = UDim2.fromOffset(40, 40),
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = start,
			Rotation = math.random(-30, 30),
			ZIndex = 52,
			TextStrokeTransparency = 0.5,
			Parent = layer,
		})
		local angle = math.random() * math.pi * 2
		local distance = 0.15 + math.random() * 0.3
		local goal = UDim2.fromScale(
			start.X.Scale + math.cos(angle) * distance * 0.6,
			start.Y.Scale + math.sin(angle) * distance + 0.1
		)
		local time = 0.7 + math.random() * 0.6
		UI.tween(piece, time, { Position = goal, Rotation = math.random(-180, 180), TextTransparency = 1, TextStrokeTransparency = 1 }, Enum.EasingStyle.Quad)
		task.delay(time, function()
			piece:Destroy()
		end)
	end
end

-- Letterbox bars for cinematic reveals.
function Effects.letterbox(duration: number)
	if not setting("effects") then
		return
	end
	local bars = {}
	for index, anchor in { 0, 1 } do
		local bar = UI.new("Frame", {
			AnchorPoint = Vector2.new(0, anchor),
			Position = UDim2.fromScale(0, anchor),
			Size = UDim2.new(1, 0, 0, 0),
			BackgroundColor3 = UI.Theme.Black,
			ZIndex = 49,
			BorderSizePixel = 0,
			Parent = layer,
		})
		bars[index] = bar
		UI.tween(bar, 0.35, { Size = UDim2.new(1, 0, 0.11, 0) })
	end
	task.delay(duration, function()
		for _, bar in bars do
			UI.tween(bar, 0.35, { Size = UDim2.new(1, 0, 0, 0) }).Completed:Connect(function()
				bar:Destroy()
			end)
		end
	end)
end

-- A one-shot particle burst around the local character (visible to this player).
function Effects.worldBurst(color: Color3, amount: number)
	if not setting("effects") then
		return
	end
	local character = Players.LocalPlayer.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then
		return
	end
	local attachment = Instance.new("Attachment")
	attachment.Parent = root
	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	emitter.Color = ColorSequence.new(color)
	emitter.LightEmission = 1
	emitter.Size = NumberSequence.new(0.8, 0)
	emitter.Lifetime = NumberRange.new(0.6, 1.2)
	emitter.Speed = NumberRange.new(12, 22)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Drag = 3
	emitter.Enabled = false
	emitter.Parent = attachment
	emitter:Emit(amount)
	task.delay(2, function()
		attachment:Destroy()
	end)
end

function Effects.enabled(name: string): boolean
	return setting(name)
end

return Effects
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="61">
            <Properties>
              <string name="Name">Hud</string>
              <string name="Source"><![CDATA[-- Main HUD: cash bar, status chips, menu, ROLL button, result card, history,
-- and the roll reveal sequence.

local ContextActionService = game:GetService("ContextActionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Rarities = require(Shared.Config.Rarities)
local GameConfig = require(Shared.Config.GameConfig)
local Sounds = require(Shared.Config.Sounds)
local RNG = require(Shared.Modules.RNG)
local NumberFormat = require(Shared.Modules.NumberFormat)

local State = require(script.Parent.Parent.State)
local UI = require(script.Parent.UI)
local Effects = require(script.Parent.Effects)
local Panels = require(script.Parent.Panels)
local Scale = require(script.Parent.Scale)

local T = UI.Theme

local Hud = {}

local refs: { [string]: any } = {}
local queue: { any } = {}
local revealing = false
local lastRollClick = 0
local cooldownEnds = 0
local cooldownLength = 1

local MENU = {
	{ panel = "Inventory", icon = "🎒", label = "Auras" },
	{ panel = "Upgrades", icon = "⬆️", label = "Upgrades" },
	{ panel = "Rebirth", icon = "♻️", label = "Rebirth" },
	{ panel = "Daily", icon = "🎁", label = "Daily" },
	{ panel = "Quests", icon = "📜", label = "Quests" },
	{ panel = "Zones", icon = "🌍", label = "Zones" },
	{ panel = "Leaderboard", icon = "🏆", label = "Top" },
	{ panel = "Trade", icon = "🤝", label = "Trade" },
	{ panel = "Shop", icon = "🛒", label = "Shop" },
	{ panel = "Codes", icon = "🔑", label = "Codes" },
	{ panel = "Stats", icon = "📊", label = "Stats" },
	{ panel = "Settings", icon = "⚙️", label = "Settings" },
}

------------------------------------------------------------------------------
-- Construction
------------------------------------------------------------------------------

local function buildTopBar(screen: ScreenGui)
	local bar = UI.new("Frame", {
		Name = "TopBar",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 8),
		Size = UDim2.fromOffset(420, 76),
		BackgroundColor3 = T.Panel,
		BackgroundTransparency = 0.08,
		Parent = screen,
	}, {
		UI.corner(16),
		UI.stroke(T.Gold, 2, 0.2),
		UI.gradient(Color3.fromRGB(40, 34, 46), Color3.fromRGB(20, 18, 24)),
	})
	Scale.attach(bar)
	refs.cash = UI.label({
		Text = "$0",
		Font = T.Title,
		TextSize = 38,
		TextColor3 = T.Gold,
		Size = UDim2.new(1, -20, 0, 44),
		Position = UDim2.fromOffset(10, 4),
		TextStrokeTransparency = 0.6,
		Parent = bar,
	})
	refs.lifetime = UI.label({
		Text = "Lifetime $0 · Broke Beginner",
		TextSize = 15,
		TextColor3 = T.Muted,
		Size = UDim2.new(1, -20, 0, 20),
		Position = UDim2.fromOffset(10, 48),
		Parent = bar,
	})

	local chips = UI.new("Frame", {
		Name = "Chips",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 90),
		Size = UDim2.fromOffset(700, 30),
		BackgroundTransparency = 1,
		Parent = screen,
	}, {
		UI.new("UIListLayout", {
			FillDirection = Enum.FillDirection.Horizontal,
			HorizontalAlignment = Enum.HorizontalAlignment.Center,
			Padding = UDim.new(0, 6),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	Scale.attach(chips)
	refs.chips = chips
end

local function chip(text: string, color: Color3, order: number)
	return UI.new("TextLabel", {
		AutomaticSize = Enum.AutomaticSize.X,
		Size = UDim2.fromOffset(0, 28),
		BackgroundColor3 = T.Panel,
		BackgroundTransparency = 0.1,
		Text = text,
		TextColor3 = color,
		Font = T.Bold,
		TextSize = 15,
		LayoutOrder = order,
		Parent = refs.chips,
	}, { UI.corner(14), UI.padding(0, 12), UI.stroke(color, 1.5, 0.3) })
end

local function buildMenu(screen: ScreenGui)
	local menu = UI.new("Frame", {
		Name = "Menu",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 10, 0.42, 0),
		Size = UDim2.fromOffset(156, 6 * 70),
		BackgroundTransparency = 1,
		Parent = screen,
	}, {
		UI.new("UIGridLayout", {
			CellSize = UDim2.fromOffset(74, 64),
			CellPadding = UDim2.fromOffset(6, 6),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	Scale.attach(menu)
	refs.menuBadges = {}
	for index, item in MENU do
		local button = UI.button({
			Text = "",
			LayoutOrder = index,
			Parent = menu,
		}, function()
			Panels.toggle(item.panel)
		end, "dark")
		UI.label({ Text = item.icon, TextSize = 26, Size = UDim2.new(1, 0, 0, 34), Position = UDim2.fromOffset(0, 4), Parent = button })
		UI.label({ Text = item.label, TextSize = 13, Font = T.Bold, Size = UDim2.new(1, 0, 0, 18), Position = UDim2.new(0, 0, 1, -22), Parent = button })
		local badge = UI.new("Frame", {
			Size = UDim2.fromOffset(14, 14),
			Position = UDim2.new(1, -16, 0, 2),
			BackgroundColor3 = T.Red,
			Visible = false,
			Parent = button,
		}, { UI.corner(7), UI.stroke(T.White, 1.5, 0) })
		refs.menuBadges[item.panel] = badge
	end
end

local function buildRollArea(screen: ScreenGui)
	local area = UI.new("Frame", {
		Name = "RollArea",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -14),
		Size = UDim2.fromOffset(470, 300),
		BackgroundTransparency = 1,
		Parent = screen,
	})
	Scale.attach(area)
	refs.rollArea = area

	refs.rollCount = UI.label({
		Text = "Rolls: 0",
		TextSize = 16,
		TextColor3 = T.Muted,
		Size = UDim2.fromOffset(300, 20),
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 156),
		Parent = area,
	})

	local roll = UI.button({
		Name = "RollButton",
		Text = "ROLL",
		TextSize = 40,
		Size = UDim2.fromOffset(280, 92),
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -20),
		Parent = area,
	}, function()
		Hud.requestRoll()
	end, "gold")
	refs.rollButton = roll
	UI.stroke(T.White, 3, 0.3).Parent = roll
	local cooldown = UI.new("Frame", {
		Name = "Cooldown",
		Size = UDim2.new(1, -24, 0, 8),
		Position = UDim2.new(0, 12, 1, -14),
		BackgroundColor3 = Color3.fromRGB(60, 40, 10),
		BackgroundTransparency = 0.3,
		Parent = roll,
	}, { UI.corner(4) })
	refs.cooldownFill = UI.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = T.White,
		Parent = cooldown,
	}, { UI.corner(4) })
	refs.luckOnButton = UI.label({
		Text = "Luck x1.00",
		TextSize = 14,
		Font = T.Bold,
		TextColor3 = Color3.fromRGB(70, 40, 5),
		Size = UDim2.new(1, 0, 0, 16),
		Position = UDim2.fromOffset(0, 6),
		Parent = roll,
	})
	UI.label({ Text = "[R]", TextSize = 12, TextColor3 = Color3.fromRGB(110, 70, 10), Size = UDim2.fromOffset(40, 14), Position = UDim2.new(1, -44, 0, 6), Parent = roll })

	refs.autoButton = UI.button({
		Text = "AUTO\nOFF",
		TextSize = 16,
		Size = UDim2.fromOffset(84, 64),
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0.5, 150, 1, -34),
		Parent = area,
	}, function()
		local snapshot = State.snapshot
		if not snapshot then
			return
		end
		State.request("SetAutoRoll", not snapshot.autoRoll)
	end, "dark")
	refs.skipButton = UI.button({
		Text = "SKIP\nANIM",
		TextSize = 16,
		Size = UDim2.fromOffset(84, 64),
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(0.5, -150, 1, -34),
		Parent = area,
	}, function()
		local profile = State.profile()
		if profile then
			State.request("SetSetting", "autoRollSkipReveal", not profile.settings.autoRollSkipReveal)
		end
	end, "dark")
end

local function buildResultCard()
	local holder = UI.new("Frame", {
		Name = "ResultHolder",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 0),
		Size = UDim2.fromOffset(460, 146),
		BackgroundTransparency = 1,
		Parent = refs.rollArea,
	})
	local card = UI.new("Frame", {
		Name = "ResultCard",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = T.Background,
		BackgroundTransparency = 0.15,
		Parent = holder,
	}, { UI.corner(18) })
	refs.cardStroke = UI.stroke(T.Gold, 3, 0.2)
	refs.cardStroke.Parent = card
	refs.cardScale = UI.new("UIScale", { Parent = card })
	refs.resultName = UI.label({
		Text = "Press ROLL to get rich!",
		Font = T.Title,
		TextScaled = true,
		Size = UDim2.new(1, -30, 0, 58),
		Position = UDim2.fromOffset(15, 12),
		TextColor3 = T.Gold,
		TextStrokeTransparency = 0.5,
		Parent = card,
	})
	refs.nameGradient = UI.new("UIGradient", { Enabled = false, Parent = refs.resultName })
	refs.resultCash = UI.label({
		Text = "",
		Font = T.Title,
		TextSize = 30,
		Size = UDim2.new(1, -30, 0, 36),
		Position = UDim2.fromOffset(15, 72),
		TextColor3 = T.Green,
		Parent = card,
	})
	refs.resultOdds = UI.label({
		Text = "",
		TextSize = 15,
		TextColor3 = T.Muted,
		Size = UDim2.new(1, -30, 0, 20),
		Position = UDim2.fromOffset(15, 112),
		Parent = card,
	})
	refs.newBadge = UI.label({
		Text = "NEW!",
		Font = T.Title,
		TextSize = 18,
		TextColor3 = T.Background,
		BackgroundTransparency = 0,
		BackgroundColor3 = T.Green,
		Size = UDim2.fromOffset(64, 26),
		Position = UDim2.new(1, -74, 0, -10),
		Rotation = 8,
		Visible = false,
		Parent = card,
	})
	UI.corner(8).Parent = refs.newBadge
end

local function buildHistory(screen: ScreenGui)
	local panel = UI.new("Frame", {
		Name = "History",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -10, 0.42, 0),
		Size = UDim2.fromOffset(210, 300),
		BackgroundColor3 = T.Panel,
		BackgroundTransparency = 0.15,
		Parent = screen,
	}, { UI.corner(14), UI.stroke(T.Gold, 1.5, 0.5), UI.padding(8) })
	Scale.attach(panel)
	UI.label({ Text = "RECENT ROLLS", Font = T.Title, TextSize = 16, TextColor3 = T.Gold, Size = UDim2.new(1, 0, 0, 22), Parent = panel })
	local list = UI.new("Frame", {
		Size = UDim2.new(1, 0, 1, -26),
		Position = UDim2.fromOffset(0, 26),
		BackgroundTransparency = 1,
		Parent = panel,
	}, { UI.list(nil, 3) })
	refs.historyList = list
end

------------------------------------------------------------------------------
-- Live updates
------------------------------------------------------------------------------

local function refreshHistory()
	local profile = State.profile()
	if not profile then
		return
	end
	UI.clear(refs.historyList)
	for index = 1, math.min(#profile.history, 10) do
		local entry = profile.history[index]
		local rarity = Rarities.get(entry.id)
		if rarity then
			UI.new("Frame", {
				Size = UDim2.new(1, 0, 0, 24),
				BackgroundColor3 = T.Row,
				LayoutOrder = index,
				Parent = refs.historyList,
			}, {
				UI.corner(6),
				UI.label({ Text = rarity.name, TextSize = 13, TextColor3 = rarity.color, Size = UDim2.new(0.58, 0, 1, 0), Position = UDim2.fromOffset(6, 0), TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, TextWrapped = false }),
				UI.label({ Text = "$" .. NumberFormat.short(entry.cash), TextSize = 13, TextColor3 = T.Text, Size = UDim2.new(0.4, -6, 1, 0), Position = UDim2.new(0.6, 0, 0, 0), TextXAlignment = Enum.TextXAlignment.Right }),
			})
		end
	end
end

local function refreshChips()
	local snapshot = State.snapshot
	if not snapshot then
		return
	end
	UI.clear(refs.chips)
	local stats = snapshot.stats
	local now = State.now()
	chip(string.format("🍀 Luck x%.2f", stats.luck), T.Green, 1)
	local zone = GameConfig.ZoneById[stats.zoneId]
	if zone and zone.id ~= "Downtown" then
		chip("📍 " .. zone.name, zone.color, 2)
	end
	if stats.eventName then
		chip("🎉 " .. stats.eventName, T.Purple, 3)
	end
	if snapshot.serverLuck.expires > now then
		chip(`🌐 Server {snapshot.serverLuck.mult}x · {NumberFormat.duration(snapshot.serverLuck.expires - now)}`, T.Blue, 4)
	end
	local soonest = math.huge
	local boostCount = 0
	for _, boost in snapshot.profile.boosts do
		if boost.expires > now then
			boostCount += 1
			soonest = math.min(soonest, boost.expires)
		end
	end
	if boostCount > 0 then
		chip(string.format("⚡ Boost x%.1f · %s", stats.boostLuck, NumberFormat.duration(soonest - now)), T.Gold, 5)
	end
	if snapshot.temporary then
		chip("⚠ Studio test: not saving", T.Red, 6)
	end
end

local function refreshBadges()
	local snapshot = State.snapshot
	if not snapshot then
		return
	end
	local profile = snapshot.profile
	refs.menuBadges.Daily.Visible = snapshot.canClaimLogin or snapshot.canClaimBoost
	local questReady = false
	for _, entry in profile.quests.daily.list do
		if not entry.claimed and entry.progress >= entry.target then
			questReady = true
		end
	end
	for _, state in profile.quests.repeatable do
		if state.progress >= state.target then
			questReady = true
		end
	end
	refs.menuBadges.Quests.Visible = questReady
end

function Hud.refresh()
	local snapshot = State.snapshot
	if not snapshot then
		return
	end
	local profile = snapshot.profile
	refs.cash.Text = "$" .. NumberFormat.short(profile.cash)
	refs.lifetime.Text = `Lifetime ${NumberFormat.short(profile.lifetime)} · Rebirth {profile.rebirths}`
	refs.rollCount.Text = `Rolls: {NumberFormat.commas(profile.totalRolls)}  ·  x{snapshot.stats.rollsPerClick} per roll`
	refs.luckOnButton.Text = string.format("Luck x%.2f", snapshot.stats.luck)
	if snapshot.autoRoll then
		refs.autoButton.Text = "AUTO\nON"
		UI.setButtonStyle(refs.autoButton, "green")
	else
		refs.autoButton.Text = if snapshot.stats.autoRollUnlocked then "AUTO\nOFF" else `AUTO\n🔒{GameConfig.Roll.autoRollUnlockRolls}`
		UI.setButtonStyle(refs.autoButton, "dark")
	end
	if profile.settings.autoRollSkipReveal then
		refs.skipButton.Text = "SKIP\nON"
		UI.setButtonStyle(refs.skipButton, "blue")
	else
		refs.skipButton.Text = "SKIP\nANIM"
		UI.setButtonStyle(refs.skipButton, "dark")
	end
	refreshHistory()
	refreshChips()
	refreshBadges()
end

------------------------------------------------------------------------------
-- Rolling and the reveal sequence
------------------------------------------------------------------------------

function Hud.requestRoll()
	local snapshot = State.snapshot
	if not snapshot then
		return
	end
	local now = os.clock()
	if now < cooldownEnds or now - lastRollClick < 0.1 then
		return
	end
	lastRollClick = now
	task.spawn(function()
		local result = State.request("Roll")
		if not result.ok and result.message == nil then
			-- Server ignored an early click; nothing to show.
			return
		end
	end)
end

local function startCooldown(seconds: number)
	cooldownLength = seconds
	cooldownEnds = os.clock() + seconds
end

local function setResultText(rarity, cash: number, luck: number)
	refs.resultName.Text = rarity.name
	refs.resultName.TextColor3 = rarity.color
	refs.cardStroke.Color = rarity.color
	refs.resultOdds.Text = NumberFormat.odds(RNG.getProbabilities(luck)[rarity.order]) .. string.format("  (base 1 in %s)", NumberFormat.short(rarity.chance))
	if rarity.effect == "celestial" then
		refs.nameGradient.Enabled = true
		refs.nameGradient.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 140, 140)),
			ColorSequenceKeypoint.new(0.33, Color3.fromRGB(255, 240, 140)),
			ColorSequenceKeypoint.new(0.66, Color3.fromRGB(140, 220, 255)),
			ColorSequenceKeypoint.new(1, Color3.fromRGB(240, 150, 255)),
		})
		refs.resultName.TextColor3 = T.White
	else
		refs.nameGradient.Enabled = false
	end
	-- Count the cash up
	local counter = Instance.new("NumberValue")
	counter.Value = 0
	counter.Changed:Connect(function(value)
		refs.resultCash.Text = "+$" .. NumberFormat.short(value)
	end)
	UI.tween(counter, math.min(0.25 + rarity.order * 0.08, 1.2), { Value = cash }).Completed:Connect(function()
		refs.resultCash.Text = "+$" .. NumberFormat.short(cash)
		counter:Destroy()
	end)
end

local function playRevealEffects(rarity)
	local effect = rarity.effect
	Effects.play(Sounds.ByRarity[rarity.id] or Sounds.Reveal, 0.7 + rarity.order * 0.08, 0.4 + rarity.order * 0.04)
	if effect == "sparkle" then
		Effects.burst(rarity.color, 6)
	elseif effect == "burst" then
		Effects.burst(rarity.color, 16)
		Effects.worldBurst(rarity.color, 30)
	elseif effect == "flash" then
		Effects.flash(rarity.color, 0.45, 0.6)
		Effects.burst(rarity.color, 26)
		Effects.worldBurst(rarity.color, 60)
		Effects.shake(1, 0.5)
	elseif effect == "cinematic" or effect == "celestial" then
		Effects.flash(T.White, 0.85, 0.9)
		task.delay(0.15, Effects.flash, rarity.color, 0.6, 1.2)
		Effects.burst(rarity.color, 40)
		Effects.worldBurst(rarity.color, 120)
		Effects.shake(2, 1.1)
		Effects.play(Sounds.Rare, 0.5, 0.8)
	end
	UI.tween(refs.cardScale, 0.12, { Scale = 1.12 }, Enum.EasingStyle.Back).Completed:Connect(function()
		UI.tween(refs.cardScale, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
	end)
end

local function bigTitle(rarity)
	if not Effects.enabled("effects") then
		return
	end
	local label = UI.label({
		Text = string.upper(rarity.name) .. "!",
		Font = T.Title,
		TextScaled = true,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.38),
		Size = UDim2.fromScale(0.8, 0.16),
		TextColor3 = rarity.color,
		TextStrokeTransparency = 0,
		TextStrokeColor3 = T.Black,
		ZIndex = 55,
		Parent = refs.screen,
	})
	local scale = UI.new("UIScale", { Scale = 0.2, Parent = label })
	UI.tween(scale, 0.45, { Scale = 1 }, Enum.EasingStyle.Back)
	task.delay(2.2, function()
		UI.tween(label, 0.4, { TextTransparency = 1, TextStrokeTransparency = 1 })
		task.wait(0.4)
		label:Destroy()
	end)
end

local function reveal(result)
	local rarity = Rarities.get(result.best)
	if not rarity then
		return
	end
	local profile = State.profile()
	-- "Skip anim" skips the build-up for anything below Millionaire; a backlog of results is fast-forwarded too.
	local skip = (profile ~= nil and profile.settings.autoRollSkipReveal and rarity.order < 6) or #queue > 2
	refs.newBadge.Visible = false

	if not skip then
		local duration = rarity.revealTime
		local dramatic = rarity.order >= 7
		if dramatic then
			Effects.letterbox(duration + 1.4)
		end
		local maxShown = math.min(Rarities.count, math.max(rarity.order + 2, 5))
		local elapsed = 0
		local interval = 0.045
		refs.resultCash.Text = ""
		refs.resultOdds.Text = ""
		refs.nameGradient.Enabled = false
		while elapsed < duration do
			local fake = Rarities.list[math.random(1, maxShown)]
			refs.resultName.Text = if dramatic and elapsed > duration * 0.6 then "???" else fake.name
			refs.resultName.TextColor3 = fake.color
			refs.cardStroke.Color = fake.color
			Effects.play(Sounds.Tick, 1 + elapsed / duration * 0.6, 0.25)
			task.wait(interval)
			elapsed += interval
			interval = math.min(interval * 1.12, 0.2)
		end
	end

	setResultText(rarity, result.bestCash, result.luck)
	if not skip or rarity.order >= 6 then
		playRevealEffects(rarity)
	end
	if rarity.order >= 7 then
		bigTitle(rarity)
	end
	if result.newDiscoveries and #result.newDiscoveries > 0 then
		refs.newBadge.Visible = true
		if not skip then
			State.notify:fire(`New rarity discovered: {rarity.name}!`, "achievement")
		end
	end
	if #result.results > 1 then
		local parts = {}
		for _, single in result.results do
			local r = Rarities.get(single.id)
			table.insert(parts, if r then r.name else single.id)
		end
		refs.resultOdds.Text = `x{#result.results}: ` .. table.concat(parts, ", ") .. `  ·  total +${NumberFormat.short(result.total)}`
	end
	if not skip and rarity.order >= 7 then
		task.wait(0.8)
	end
end

local function processQueue()
	if revealing then
		return
	end
	revealing = true
	while #queue > 0 do
		local result = table.remove(queue, 1)
		local ok, err = pcall(reveal, result)
		if not ok then
			warn("[Hud] reveal failed: " .. tostring(err))
		end
	end
	revealing = false
end

function Hud.mount(screen: ScreenGui)
	refs.screen = screen
	buildTopBar(screen)
	buildMenu(screen)
	buildRollArea(screen)
	buildResultCard()
	buildHistory(screen)
end

function Hud.init()
	State.changed:connect(Hud.refresh)
	State.rollResult:connect(function(result)
		startCooldown(result.cooldown)
		table.insert(queue, result)
		task.spawn(processQueue)
	end)

	ContextActionService:BindAction("BAM_Roll", function(_, inputState)
		if inputState == Enum.UserInputState.Begin then
			Hud.requestRoll()
		end
		return Enum.ContextActionResult.Pass
	end, false, Enum.KeyCode.R, Enum.KeyCode.ButtonX)

	-- Cooldown bar + ticking timers
	local timerAccumulator = 0
	RunService.RenderStepped:Connect(function(dt)
		local remaining = math.max(0, cooldownEnds - os.clock())
		refs.cooldownFill.Size = UDim2.fromScale(1 - remaining / math.max(cooldownLength, 0.01), 1)
		timerAccumulator += dt
		if timerAccumulator >= 1 then
			timerAccumulator = 0
			refreshChips()
		end
	end)
end

return Hud
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="62">
            <Properties>
              <string name="Name">Notifications</string>
              <string name="Source"><![CDATA[-- Toast notifications (bottom-right stack) and big server announcements.

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TextChatService = game:GetService("TextChatService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Rarities = require(Shared.Config.Rarities)
local Sounds = require(Shared.Config.Sounds)

local State = require(script.Parent.Parent.State)
local UI = require(script.Parent.UI)
local Effects = require(script.Parent.Effects)
local Scale = require(script.Parent.Scale)

local T = UI.Theme

local Notifications = {}

local toastHolder: Frame
local bannerHolder: Frame
local lastToast: { [string]: number } = {}

local KIND_COLORS = {
	info = T.Blue,
	success = T.Green,
	error = T.Red,
	warning = Color3.fromRGB(255, 170, 60),
	achievement = T.Gold,
}

function Notifications.mount(screen: ScreenGui)
	toastHolder = UI.new("Frame", {
		Name = "Toasts",
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -16, 1, -150),
		Size = UDim2.fromOffset(320, 300),
		BackgroundTransparency = 1,
		ZIndex = 40,
		Parent = screen,
	}, {
		UI.new("UIListLayout", {
			VerticalAlignment = Enum.VerticalAlignment.Bottom,
			HorizontalAlignment = Enum.HorizontalAlignment.Right,
			Padding = UDim.new(0, 6),
			SortOrder = Enum.SortOrder.LayoutOrder,
		}),
	})
	bannerHolder = UI.new("Frame", {
		Name = "Announcements",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 126),
		Size = UDim2.fromOffset(560, 60),
		BackgroundTransparency = 1,
		ZIndex = 45,
		Parent = screen,
	})
	Scale.attach(toastHolder)
	Scale.attach(bannerHolder)
end

function Notifications.toast(text: string, kind: string?)
	if not toastHolder or text == "" then
		return
	end
	-- Drop exact duplicates fired within a second (e.g. "Slow down!").
	local now = os.clock()
	if lastToast[text] and now - lastToast[text] < 1 then
		return
	end
	lastToast[text] = now
	local color = KIND_COLORS[kind or "info"] or T.Blue
	local toast = UI.new("Frame", {
		Size = UDim2.fromOffset(320, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = T.Panel,
		BackgroundTransparency = 0.05,
		LayoutOrder = math.floor(now * 1000) % 1e9,
		ZIndex = 40,
		Parent = toastHolder,
	}, {
		UI.corner(10),
		UI.stroke(color, 2, 0.2),
		UI.padding(10, 12),
		UI.label({
			Text = text,
			TextSize = 16,
			AutomaticSize = Enum.AutomaticSize.Y,
			Size = UDim2.new(1, 0, 0, 0),
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 41,
		}),
	})
	local children = toastHolder:GetChildren()
	local frames = {}
	for _, child in children do
		if child:IsA("Frame") then
			table.insert(frames, child)
		end
	end
	if #frames > 4 then
		table.sort(frames, function(a, b)
			return a.LayoutOrder < b.LayoutOrder
		end)
		frames[1]:Destroy()
	end
	if kind == "achievement" then
		Effects.play(Sounds.Notify, 1.2, 0.5)
	end
	task.delay(4, function()
		if toast.Parent then
			UI.tween(toast, 0.3, { BackgroundTransparency = 1 })
			task.wait(0.3)
			toast:Destroy()
		end
	end)
end

local function systemChat(text: string, color: Color3)
	local channels = TextChatService:FindFirstChild("TextChannels")
	local general = channels and channels:FindFirstChild("RBXGeneral")
	if general and general:IsA("TextChannel") then
		local hex = color:ToHex()
		pcall(function()
			general:DisplaySystemMessage(`<font color="#{hex}"><b>{text}</b></font>`)
		end)
	end
end

function Notifications.announce(payload: { [string]: any })
	if not bannerHolder then
		return
	end
	local color = T.Gold
	local rarity = payload.rarity and Rarities.get(payload.rarity)
	if rarity then
		color = rarity.color
	elseif payload.kind == "serverLuck" then
		color = T.Green
	end
	UI.clear(bannerHolder)
	local banner = UI.new("Frame", {
		Size = UDim2.fromScale(1, 1),
		Position = UDim2.fromOffset(0, -20),
		BackgroundColor3 = T.Background,
		BackgroundTransparency = 0.1,
		ZIndex = 45,
		Parent = bannerHolder,
	}, {
		UI.corner(14),
		UI.stroke(color, 2.5, 0),
		UI.label({
			Text = payload.text,
			TextColor3 = color,
			Font = T.Title,
			TextScaled = true,
			Size = UDim2.new(1, -24, 1, -12),
			Position = UDim2.fromOffset(12, 6),
			ZIndex = 46,
		}),
	})
	UI.tween(banner, 0.35, { Position = UDim2.fromOffset(0, 0) }, Enum.EasingStyle.Back)
	if rarity and rarity.order >= 8 then
		Effects.flash(color, 0.25, 0.6)
	end
	Effects.play(Sounds.Notify, 0.8, 0.6)
	systemChat(payload.text, color)
	task.delay(5, function()
		if banner.Parent then
			UI.tween(banner, 0.3, { BackgroundTransparency = 1, Position = UDim2.fromOffset(0, -20) })
			task.wait(0.3)
			banner:Destroy()
		end
	end)
end

function Notifications.init()
	State.notify:connect(Notifications.toast)
	State.announce:connect(Notifications.announce)
end

return Notifications
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="63">
            <Properties>
              <string name="Name">Panels</string>
              <string name="Source"><![CDATA[-- Modal panel manager. Each panel module returns
--   { title: string, build: (content: ScrollingFrame) -> (), refresh: (content) -> () }
-- Only one panel is open at a time; the open panel refreshes when state changes.

local UI = require(script.Parent.UI)
local Scale = require(script.Parent.Scale)
local State = require(script.Parent.Parent.State)

local T = UI.Theme

export type PanelDef = {
	title: string,
	build: ((content: ScrollingFrame) -> ())?,
	refresh: (content: ScrollingFrame) -> (),
	onOpen: (() -> ())?,
	live: boolean?, -- refresh every second while open (timers)
}

local Panels = {}

local definitions: { [string]: PanelDef } = {}
local container: Frame
local titleLabel: TextLabel
local content: { [string]: ScrollingFrame } = {}
local built: { [string]: boolean } = {}
Panels.current = nil :: string?
local refreshQueued = false
local openedListeners: { (string?) -> () } = {}

function Panels.register(name: string, definition: any)
	definitions[name] = definition
end

function Panels.onChanged(fn: (string?) -> ())
	table.insert(openedListeners, fn)
end

function Panels.mount(screen: ScreenGui)
	local holder = UI.new("Frame", {
		Name = "PanelHolder",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(680, 470),
		BackgroundTransparency = 1,
		ZIndex = 20,
		Parent = screen,
	})
	Scale.attach(holder)
	container = UI.new("Frame", {
		Name = "Panel",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = T.Panel,
		Visible = false,
		ZIndex = 20,
		Parent = holder,
	}, {
		UI.corner(18),
		UI.stroke(T.Gold, 2, 0.15),
		UI.gradient(Color3.fromRGB(34, 30, 40), Color3.fromRGB(20, 18, 24)),
	})
	UI.new("UIScale", { Name = "OpenScale", Parent = container })

	local header = UI.new("Frame", {
		Size = UDim2.new(1, 0, 0, 54),
		BackgroundColor3 = T.GoldDark,
		ZIndex = 21,
		Parent = container,
	}, {
		UI.corner(18),
		UI.gradient(Color3.fromRGB(255, 214, 100), Color3.fromRGB(196, 128, 20)),
	})
	-- square off the header's bottom corners
	UI.new("Frame", {
		Size = UDim2.new(1, 0, 0, 18),
		Position = UDim2.new(0, 0, 1, -18),
		BackgroundColor3 = T.White,
		BorderSizePixel = 0,
		ZIndex = 21,
		Parent = header,
	}, { UI.gradient(Color3.fromRGB(226, 170, 60), Color3.fromRGB(196, 128, 20)) })
	titleLabel = UI.label({
		Text = "",
		Font = T.Title,
		TextSize = 26,
		TextColor3 = Color3.fromRGB(40, 24, 4),
		Size = UDim2.new(1, -80, 1, 0),
		Position = UDim2.fromOffset(20, 0),
		TextXAlignment = Enum.TextXAlignment.Left,
		ZIndex = 22,
		Parent = header,
	})
	UI.button({
		Text = "X",
		Size = UDim2.fromOffset(40, 40),
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, -8, 0.5, 0),
		ZIndex = 23,
		Parent = header,
	}, function()
		Panels.close()
	end, "red")
end

local function getContent(name: string): ScrollingFrame
	local frame = content[name]
	if frame then
		return frame
	end
	frame = UI.new("ScrollingFrame", {
		Name = name,
		Size = UDim2.new(1, -24, 1, -70),
		Position = UDim2.fromOffset(12, 62),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 6,
		ScrollBarImageColor3 = T.Gold,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Visible = false,
		ZIndex = 21,
		Parent = container,
	}, { UI.list(nil, 8), UI.padding(4, 2) })
	content[name] = frame
	return frame
end

local function refreshCurrent()
	local name = Panels.current
	if not name then
		return
	end
	local definition = definitions[name]
	local frame = getContent(name)
	if not built[name] then
		built[name] = true
		if definition.build then
			definition.build(frame)
		end
	end
	definition.refresh(frame)
end

function Panels.refresh()
	if refreshQueued then
		return
	end
	refreshQueued = true
	task.delay(0.15, function()
		refreshQueued = false
		refreshCurrent()
	end)
end

function Panels.open(name: string)
	local definition = definitions[name]
	if not definition then
		return
	end
	for other, frame in content do
		frame.Visible = other == name
	end
	Panels.current = name
	titleLabel.Text = definition.title
	local frame = getContent(name)
	frame.Visible = true
	frame.CanvasPosition = Vector2.zero
	refreshCurrent()
	if definition.onOpen then
		definition.onOpen()
	end
	if not container.Visible then
		local scale = container:FindFirstChild("OpenScale") :: UIScale
		scale.Scale = 0.85
		container.Visible = true
		UI.tween(scale, 0.22, { Scale = 1 }, Enum.EasingStyle.Back)
	end
	for _, fn in openedListeners do
		task.spawn(fn, name)
	end
end

function Panels.close()
	if not container.Visible then
		return
	end
	Panels.current = nil
	container.Visible = false
	for _, fn in openedListeners do
		task.spawn(fn, nil)
	end
end

function Panels.toggle(name: string)
	if Panels.current == name then
		Panels.close()
	else
		Panels.open(name)
	end
end

function Panels.init()
	State.changed:connect(Panels.refresh)
	State.leaderboardChanged:connect(Panels.refresh)
	task.spawn(function()
		while true do
			task.wait(1)
			local name = Panels.current
			if name and definitions[name].live then
				Panels.refresh()
			end
		end
	end)
end

return Panels
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="64">
            <Properties>
              <string name="Name">Scale</string>
              <string name="Source"><![CDATA[-- Keeps every HUD group readable on phones, tablets and monitors. Each group
-- gets a UIScale that is updated whenever the viewport changes. Groups are
-- anchored to their screen edge, so scaling never pushes them off screen.

local UI = require(script.Parent.UI)

local Scale = {}

local scales: { UIScale } = {}
Scale.value = 1

local function compute(): number
	local camera = workspace.CurrentCamera
	local size = if camera then camera.ViewportSize else Vector2.new(1280, 720)
	return math.clamp(math.min(size.X / 1280, size.Y / 760), 0.5, 1.2)
end

local function apply()
	Scale.value = compute()
	for _, uiScale in scales do
		uiScale.Scale = Scale.value
	end
end

function Scale.attach(guiObject: GuiObject): UIScale
	local uiScale = UI.new("UIScale", { Name = "ResponsiveScale", Scale = Scale.value, Parent = guiObject })
	table.insert(scales, uiScale)
	return uiScale
end

function Scale.init()
	local function hookCamera()
		local camera = workspace.CurrentCamera
		if camera then
			camera:GetPropertyChangedSignal("ViewportSize"):Connect(apply)
		end
		apply()
	end
	workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(hookCamera)
	hookCamera()
end

return Scale
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="65">
            <Properties>
              <string name="Name">UI</string>
              <string name="Source"><![CDATA[-- UI toolkit: theme + small constructors used by every screen.

local TweenService = game:GetService("TweenService")

local UI = {}

UI.Theme = {
	Background = Color3.fromRGB(16, 14, 20),
	Panel = Color3.fromRGB(26, 23, 31),
	PanelLight = Color3.fromRGB(38, 34, 45),
	Row = Color3.fromRGB(33, 30, 39),
	Gold = Color3.fromRGB(255, 200, 70),
	GoldLight = Color3.fromRGB(255, 232, 150),
	GoldDark = Color3.fromRGB(196, 132, 24),
	Text = Color3.fromRGB(248, 244, 236),
	Muted = Color3.fromRGB(168, 160, 150),
	Green = Color3.fromRGB(80, 210, 120),
	Red = Color3.fromRGB(235, 80, 80),
	Blue = Color3.fromRGB(90, 170, 255),
	Purple = Color3.fromRGB(160, 100, 255),
	Black = Color3.fromRGB(0, 0, 0),
	White = Color3.fromRGB(255, 255, 255),
	Title = Enum.Font.GothamBlack,
	Bold = Enum.Font.GothamBold,
	Body = Enum.Font.GothamMedium,
}
local T = UI.Theme

function UI.new(className: string, props: { [string]: any }?, children: { Instance }?): any
	local instance = Instance.new(className :: any)
	local parent = nil
	if props then
		for key, value in props do
			if key == "Parent" then
				parent = value
			else
				(instance :: any)[key] = value
			end
		end
	end
	if children then
		for _, child in children do
			child.Parent = instance
		end
	end
	if parent then
		instance.Parent = parent
	end
	return instance
end

function UI.corner(radius: number?): UICorner
	return UI.new("UICorner", { CornerRadius = UDim.new(0, radius or 12) })
end

function UI.stroke(color: Color3?, thickness: number?, transparency: number?): UIStroke
	return UI.new("UIStroke", {
		Color = color or T.Gold,
		Thickness = thickness or 1.5,
		Transparency = transparency or 0.4,
		ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
	})
end

function UI.gradient(top: Color3, bottom: Color3, rotation: number?): UIGradient
	return UI.new("UIGradient", {
		Color = ColorSequence.new(top, bottom),
		Rotation = rotation or 90,
	})
end

function UI.padding(all: number, horizontal: number?): UIPadding
	local h = horizontal or all
	return UI.new("UIPadding", {
		PaddingTop = UDim.new(0, all),
		PaddingBottom = UDim.new(0, all),
		PaddingLeft = UDim.new(0, h),
		PaddingRight = UDim.new(0, h),
	})
end

function UI.list(direction: Enum.FillDirection?, padding: number?, align: Enum.HorizontalAlignment?): UIListLayout
	return UI.new("UIListLayout", {
		FillDirection = direction or Enum.FillDirection.Vertical,
		Padding = UDim.new(0, padding or 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = align or Enum.HorizontalAlignment.Center,
	})
end

function UI.label(props: { [string]: any }): TextLabel
	local defaults = {
		BackgroundTransparency = 1,
		Font = T.Bold,
		TextColor3 = T.Text,
		TextSize = 18,
		TextWrapped = true,
		Size = UDim2.new(1, 0, 0, 24),
	}
	for key, value in props do
		defaults[key] = value
	end
	return UI.new("TextLabel", defaults)
end

function UI.tween(instance: Instance, time: number, goal: { [string]: any }, style: Enum.EasingStyle?, direction: Enum.EasingDirection?): Tween
	local tween = TweenService:Create(
		instance,
		TweenInfo.new(time, style or Enum.EasingStyle.Quad, direction or Enum.EasingDirection.Out),
		goal
	)
	tween:Play()
	return tween
end

export type ButtonStyle = "gold" | "dark" | "green" | "red" | "blue" | "purple"

local STYLES: { [string]: { Color3 } } = {
	gold = { Color3.fromRGB(255, 220, 110), Color3.fromRGB(220, 150, 30), Color3.fromRGB(40, 26, 6) },
	dark = { Color3.fromRGB(56, 50, 64), Color3.fromRGB(38, 34, 45), T.Text },
	green = { Color3.fromRGB(110, 230, 140), Color3.fromRGB(40, 160, 80), Color3.fromRGB(8, 30, 14) },
	red = { Color3.fromRGB(250, 120, 120), Color3.fromRGB(190, 50, 50), T.White },
	blue = { Color3.fromRGB(120, 190, 255), Color3.fromRGB(50, 110, 220), T.White },
	purple = { Color3.fromRGB(190, 140, 255), Color3.fromRGB(110, 60, 220), T.White },
}

UI.onClickSound = nil :: (() -> ())?

-- Rounded gradient button with hover/press animation.
function UI.button(props: { [string]: any }, onClick: (() -> ())?, style: ButtonStyle?): TextButton
	local palette = STYLES[style or "gold"]
	local defaults = {
		AutoButtonColor = false,
		BackgroundColor3 = T.White,
		Font = T.Title,
		TextColor3 = palette[3],
		TextSize = 18,
		Size = UDim2.fromOffset(140, 42),
		Text = "Button",
	}
	for key, value in props do
		defaults[key] = value
	end
	local button = UI.new("TextButton", defaults, {
		UI.corner(10),
		UI.new("UIGradient", { Name = "Fill", Color = ColorSequence.new(palette[1], palette[2]), Rotation = 90 }),
		UI.stroke(T.White, 1, 0.85),
	})
	local scale = UI.new("UIScale", { Parent = button })
	button.MouseEnter:Connect(function()
		UI.tween(scale, 0.12, { Scale = 1.04 })
	end)
	button.MouseLeave:Connect(function()
		UI.tween(scale, 0.12, { Scale = 1 })
	end)
	button.MouseButton1Down:Connect(function()
		UI.tween(scale, 0.06, { Scale = 0.96 })
	end)
	button.MouseButton1Up:Connect(function()
		UI.tween(scale, 0.1, { Scale = 1.04 })
	end)
	if onClick then
		button.Activated:Connect(function()
			if button:GetAttribute("Disabled") then
				return
			end
			if UI.onClickSound then
				UI.onClickSound()
			end
			onClick()
		end)
	end
	return button
end

function UI.setButtonStyle(button: TextButton, style: ButtonStyle)
	local palette = STYLES[style]
	local fill = button:FindFirstChild("Fill") :: UIGradient?
	if fill then
		fill.Color = ColorSequence.new(palette[1], palette[2])
	end
	button.TextColor3 = palette[3]
end

-- Visually disables a button (it still exists so layouts stay stable).
function UI.setEnabled(button: TextButton, enabled: boolean)
	button:SetAttribute("Disabled", not enabled)
	button.AutoButtonColor = false
	button.TextTransparency = if enabled then 0 else 0.45
	local fill = button:FindFirstChild("Fill") :: UIGradient?
	if fill then
		fill.Transparency = NumberSequence.new(if enabled then 0 else 0.5)
	end
end

function UI.progressBar(parent: Instance, color: Color3, height: number?): (Frame, (number) -> ())
	local bar = UI.new("Frame", {
		Size = UDim2.new(1, 0, 0, height or 10),
		BackgroundColor3 = Color3.fromRGB(14, 12, 18),
		Parent = parent,
	}, { UI.corner(6) })
	local fill = UI.new("Frame", {
		Size = UDim2.fromScale(0, 1),
		BackgroundColor3 = color,
		Parent = bar,
	}, { UI.corner(6) })
	return bar, function(alpha: number)
		fill.Size = UDim2.fromScale(math.clamp(alpha, 0, 1), 1)
	end
end

function UI.clear(container: Instance)
	for _, child in container:GetChildren() do
		if not child:IsA("UIListLayout") and not child:IsA("UIGridLayout") and not child:IsA("UIPadding") then
			child:Destroy()
		end
	end
end

-- Card row used in most panel lists.
function UI.row(parent: Instance, height: number, order: number?): Frame
	return UI.new("Frame", {
		Size = UDim2.new(1, -6, 0, height),
		BackgroundColor3 = T.Row,
		LayoutOrder = order or 0,
		Parent = parent,
	}, { UI.corner(10), UI.stroke(T.Gold, 1, 0.8) })
end

return UI
]]></string>
            </Properties>
          </Item>
        </Item>
        <Item class="ModuleScript" referent="66">
          <Properties>
            <string name="Name">World</string>
            <string name="Source"><![CDATA[-- World interactions on the client: proximity prompts open menus, other
-- players' auras can be hidden, and VIP players get a chat tag.

local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local TextChatService = game:GetService("TextChatService")

local State = require(script.Parent.State)
local Panels = require(script.Parent.UI.Panels)

local World = {}

local function applyAuraVisibility()
	local profile = State.profile()
	local hide = profile ~= nil and profile.settings.hideOtherAuras == true
	for _, player in Players:GetPlayers() do
		if player ~= Players.LocalPlayer and player.Character then
			local root = player.Character:FindFirstChild("HumanoidRootPart")
			local aura = root and root:FindFirstChild("WealthAura")
			if aura then
				for _, child in aura:GetChildren() do
					if child:IsA("ParticleEmitter") or child:IsA("PointLight") then
						child.Enabled = not hide
					end
				end
			end
		end
	end
end

function World.init()
	ProximityPromptService.PromptTriggered:Connect(function(prompt)
		local panel = prompt:GetAttribute("OpenPanel")
		if type(panel) == "string" then
			Panels.open(panel)
		end
	end)

	State.changed:connect(applyAuraVisibility)
	task.spawn(function()
		while true do
			task.wait(3) -- catches auras rebuilt on respawn/equip
			applyAuraVisibility()
		end
	end)

	TextChatService.OnIncomingMessage = function(message: TextChatMessage)
		local properties = Instance.new("TextChatMessageProperties")
		local source = message.TextSource
		if source then
			local player = Players:GetPlayerByUserId(source.UserId)
			if player and player:GetAttribute("Pass_VIP") then
				properties.PrefixText = `<font color="#FFC846">[VIP]</font> ` .. message.PrefixText
			end
		end
		return properties
	end
end

return World
]]></string>
